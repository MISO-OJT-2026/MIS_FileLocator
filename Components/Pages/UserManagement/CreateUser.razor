@using System.ComponentModel.DataAnnotations
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.AspNetCore.Identity
@using MIS_FileLocator.Data
@using FileLocator.Models
@using FileLocator.Services
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ICurrentUserService _currentUserService
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="_newUser" OnValidSubmit="SaveUser">
            <DataAnnotationsValidator />
            <MudGrid>
                @* Employee ID *@
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_newUser.EmployeeId"
                                  Label="Employee ID"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>

                @* Full Name *@
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Value="_newUser.FullName"
                                  ValueChanged="OnFullNameChanged"
                                  Label="Full Name"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>

                @* Username - Value and ValueChanged to allow manual editing *@
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Value="_newUser.UserName"
                                  ValueChanged="OnUsernameChanged"
                                  Label="Username"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  HelperText="Can be customized after autofill"
                                  Immediate="true" />
                </MudItem>

                @* Department *@
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_newUser.Department" Label="Department" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Network Unit")">Network Unit</MudSelectItem>
                        <MudSelectItem Value="@("Hardware Unit")">Hardware Unit</MudSelectItem>
                        <MudSelectItem Value="@("Software Unit")">Software Unit</MudSelectItem>
                        <MudSelectItem Value="@("Front Desk")">Front Desk</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Password *@
                <MudItem xs="12" md="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudTextField @bind-Value="_newUser.Password"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      Disabled="@_isSaving"
                                      Class="flex-grow-1" />
                        <MudTooltip Text="Generate password">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary"
                                           OnClick="GeneratePassword" Disabled="@_isSaving" />
                        </MudTooltip>
                    </MudStack>
                </MudItem>

                @* Role *@
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="_newUser.Role" Label="Role" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Editor")">Editor</MudSelectItem>
                        <MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* Confidentiality Restriction (Viewers only) *@
                @if (_newUser.Role == "Viewer")
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Class="mb-1">Allowed Confidentiality Levels</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Leave all unchecked to allow all levels.</MudText>
                        @foreach (var level in _confidentialityLevels)
                        {
                            <MudCheckBox T="bool"
                                         Value="@(_newUser.AllowedLevelIds.Contains(level.Id))"
                                         ValueChanged="@(v => { if (v) _newUser.AllowedLevelIds.Add(level.Id); else _newUser.AllowedLevelIds.Remove(level.Id); })"
                                         Label="@level.Name"
                                         Color="Color.Primary" />
                        }
                    </MudItem>
                }
            </MudGrid>

            @if (_isSaving)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 mud-text-secondary d-block">Creating user...</MudText>
            }
            <div class="d-flex justify-end mt-4">
                <MudButton OnClick="Cancel" Class="mr-2" Disabled="@_isSaving">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@_isSaving">
                    @(_isSaving ? "Creating..." : "Save User")
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private AddUserModel _newUser = new() { Role = "Viewer" };
    private bool _isUsernameManuallyEdited = false;
    private bool _isSaving = false;
    private bool _showPassword = false;
    private List<ConfidentialityLevel> _confidentialityLevels = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _confidentialityLevels = await db.ConfidentialityLevels.OrderBy(l => l.Id).ToListAsync();
    }

    private void OnFullNameChanged(string value)
    {
        _newUser.FullName = value;
        if (!_isUsernameManuallyEdited)
            _newUser.UserName = string.IsNullOrWhiteSpace(value) ? "" : value.Replace(" ", "").ToLower();
        if (string.IsNullOrWhiteSpace(value)) _isUsernameManuallyEdited = false;
    }

    private void OnUsernameChanged(string value)
    {
        _newUser.UserName = value;
        _isUsernameManuallyEdited = !string.IsNullOrWhiteSpace(value);
    }

    private async Task SaveUser()
    {
        if (_isSaving) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var idExists = await db.Users.AnyAsync(u => u.EmployeeId == _newUser.EmployeeId);
        if (idExists) { Snackbar.Add($"Employee ID '{_newUser.EmployeeId}' is already registered.", Severity.Error); return; }
        var userExists = await UserManager.FindByNameAsync(_newUser.UserName);
        if (userExists != null) { Snackbar.Add($"Username '{_newUser.UserName}' is already taken.", Severity.Error); return; }

        _isSaving = true;
        StateHasChanged();
        try
        {
            var user = new ApplicationUser
            {
                UserName = _newUser.UserName, EmployeeId = _newUser.EmployeeId,
                FullName = _newUser.FullName, Department = _newUser.Department,
                EmailConfirmed = true,
                AllowedConfidentialityLevels = _newUser.Role == "Viewer" && _newUser.AllowedLevelIds.Any()
                    ? string.Join(",", _newUser.AllowedLevelIds.OrderBy(x => x))
                    : null
            };
            var result = await UserManager.CreateAsync(user, _newUser.Password);
            if (result.Succeeded)
            {
                var addRoleResult = await UserManager.AddToRoleAsync(user, _newUser.Role);
                if (!addRoleResult.Succeeded)
                {
                    Snackbar.Add("User created but role assignment failed. Please edit the user to assign a role.", Severity.Warning);
                }
                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
                db.TransactionLogs.Add(new TransactionLog
                {
                    FullName = currentAdmin, EventName = "User Registered",
                    Description = $"Created account for {_newUser.FullName}.",
                    Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
                });
                db.CurrentUserOverride = currentAdmin;
                await db.SaveChangesAsync();
                Snackbar.Add($"User {_newUser.UserName} created successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else { foreach (var err in result.Errors) Snackbar.Add(err.Description, Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void GeneratePassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ", lower = "abcdefghijkmnopqrstuvwxyz", numbers = "23456789", specials = "!@#$%^&*";
        var random = new Random();
        var password = new List<char> {
            upper[random.Next(upper.Length)], lower[random.Next(lower.Length)],
            numbers[random.Next(numbers.Length)], specials[random.Next(specials.Length)]
        };
        const string all = upper + lower + numbers + specials;
        password.AddRange(Enumerable.Repeat(all, 6).Select(s => s[random.Next(s.Length)]));
        _newUser.Password = new string(password.OrderBy(x => random.Next()).ToArray());
        _showPassword = true; // Show it so admin can verify before saving
    }

    private void Cancel() { if (!_isSaving) MudDialog.Cancel(); }

    public class AddUserModel
    {
        [Required] public string EmployeeId { get; set; } = "";
        [Required] public string UserName { get; set; } = "";
        [Required] public string FullName { get; set; } = "";
        [Required] public string Department { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        [Required] public string Role { get; set; } = "";
        public HashSet<int> AllowedLevelIds { get; set; } = new();
    }
}