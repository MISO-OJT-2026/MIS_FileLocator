@using Microsoft.AspNetCore.Identity
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context
@inject ICurrentUserService _currentUserService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Class="mr-3 mb-n1" />
            Reset Password for @UserFullName
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            The previous password will be cleared. The Admin cannot view old passwords.
        </MudAlert>

        <MudTextField @bind-Value="_newPassword"
                      Label="New Password"
                      Variant="Variant.Outlined"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                      HelperText="Click the refresh icon on CreateUser to auto-generate a secure password"
                      Required="true" />

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="SubmitReset"
                   Disabled="@(string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)">
            Confirm Reset
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string UserFullName { get; set; } = "";

    private string _newPassword = "";
    private bool _showPassword = false;

    private void GeneratePassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnopqrstuvwxyz";
        const string numbers = "23456789";
        const string specials = "!@#$%^&*";
        var random = new Random();

        char upperChar = upper[random.Next(upper.Length)];
        char lowerChar = lower[random.Next(lower.Length)];
        char numberChar = numbers[random.Next(numbers.Length)];
        char specialChar = specials[random.Next(specials.Length)];

        const string all = upper + lower + numbers + specials;
        string remaining = new string(Enumerable.Repeat(all, 6)
            .Select(s => s[random.Next(s.Length)]).ToArray());

        var password = new List<char> { upperChar, lowerChar, numberChar, specialChar };
        password.AddRange(remaining);

        _newPassword = new string(password.OrderBy(x => random.Next()).ToArray());
        _showPassword = true; // Show it after generating so admin can copy it
    }

    private async Task SubmitReset()
    {
        var user = await UserManager.FindByIdAsync(UserId);
        if (user == null) return;

        var removeResult = await UserManager.RemovePasswordAsync(user);
        if (removeResult.Succeeded)
        {
            var addResult = await UserManager.AddPasswordAsync(user, _newPassword);
            if (addResult.Succeeded)
            {
                // Clear lockout in case they were blocked
                await UserManager.SetLockoutEndDateAsync(user, null);
                await UserManager.ResetAccessFailedCountAsync(user);

                var admin = await _currentUserService.GetCurrentFullNameAsync();
                _context.TransactionLogs.Add(new TransactionLog
                {
                    FullName = admin,
                    EventName = "Password Reset",
                    Description = $"Force password reset performed for {user.FullName}.",
                    Status = "Warning",
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                });
                await _context.SaveChangesAsync();

                Snackbar.Add($"Password for {user.FullName} reset successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                foreach (var err in addResult.Errors) Snackbar.Add(err.Description, Severity.Error);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}