@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using MIS_FileLocator.Data
@using MIS_FileLocator.Services
@using MIS_FileLocator.Models

@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ICurrentUserService _currentUserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex flex-column align-center justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">Loading user data...</MudText>
            </div>
        }
        else
        {
            <EditForm Model="_editUser" OnValidSubmit="UpdateUser">
                <DataAnnotationsValidator />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editUser.EmployeeId" Label="Employee ID" Required="true" Variant="Variant.Outlined" Disabled="@_isSaving" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editUser.UserName" Label="Username" Required="true" Variant="Variant.Outlined" Disabled="@_isSaving" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_editUser.FullName" Label="Full Name" Required="true" Variant="Variant.Outlined" Disabled="@_isSaving" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="_editUser.Department" Label="Department" Required="true" Variant="Variant.Outlined" Disabled="@_isSaving">
                            <MudSelectItem Value="@("Network Unit")">Network Unit</MudSelectItem>
                            <MudSelectItem Value="@("Hardware Unit")">Hardware Unit</MudSelectItem>
                            <MudSelectItem Value="@("Software Unit")">Software Unit</MudSelectItem>
                        
                         <MudSelectItem Value="@("Front Desk")">Front Desk</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_editUser.Role" Label="Role" Required="true" Variant="Variant.Outlined" Disabled="@_isSaving">
                            <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                            <MudSelectItem Value="@("Editor")">Editor</MudSelectItem>
                            <MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        <MudSwitch Value="@(!_editUser.IsDisabled)"
                                   ValueChanged="@((bool v) => _editUser.IsDisabled = !v)"
                                   Label="@(_editUser.IsDisabled ? "Account Disabled" : "Account Active")"
                                   Color="Color.Success"
                                   UnCheckedColor="Color.Default"
                                   Disabled="@_isSaving" />
                    </MudItem>

                    @* Confidentiality Restriction (Viewers only) *@
                    @if (_editUser.Role == "Viewer")
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.body2" Class="mb-1">Allowed Confidentiality Levels</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">Leave all unchecked to allow all levels.</MudText>
                            @foreach (var level in _confidentialityLevels)
                            {
                                <MudCheckBox T="bool"
                                             Value="@(_editUser.AllowedLevelIds.Contains(level.Id))"
                                             ValueChanged="@(v => { if (v) _editUser.AllowedLevelIds.Add(level.Id); else _editUser.AllowedLevelIds.Remove(level.Id); })"
                                             Label="@level.Name"
                                             Color="Color.Primary"
                                             Disabled="@_isSaving" />
                            }
                        </MudItem>
                    }
                </MudGrid>

                @if (_isSaving)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 mud-text-secondary d-block">Updating user...</MudText>
                }

                <div class="d-flex justify-end mt-4 gap-2">
                    <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@_isSaving">
                        @(_isSaving ? "Updating..." : "Update")
                    </MudButton>
                </div>
            </EditForm>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string UserId { get; set; } = "";

    private EditUserModel _editUser = new();
    private ApplicationUser? _user;
    private bool _loading = true;
    private bool _isSaving = false;
    private List<FileLocator.Models.ConfidentialityLevel> _confidentialityLevels = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await UserManager.FindByIdAsync(UserId);

        if (_user != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var role = await db.UserRoles
                .Where(ur => ur.UserId == _user.Id)
                .Join(db.Roles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
                .FirstOrDefaultAsync() ?? "Viewer";

            _confidentialityLevels = await db.ConfidentialityLevels.OrderBy(l => l.Id).ToListAsync();

            _editUser = new EditUserModel
            {
                EmployeeId = _user.EmployeeId ?? "",
                UserName = _user.UserName ?? "",
                FullName = _user.FullName ?? "",
                Department = _user.Department ?? "",
                Role = role,
                IsDisabled = _user.LockoutEnd.HasValue && _user.LockoutEnd.Value > DateTimeOffset.UtcNow,
                AllowedLevelIds = new HashSet<int>(_user.GetAllowedLevelIds())
            };
        }

        _loading = false;
    }

    private async Task UpdateUser(EditContext context)
    {
        

        bool? result = await DialogService.ShowMessageBoxAsync(
           "Confirm Update",
           $"Are you sure you want to update this user?",
           yesText: "Update",
           cancelText: "Cancel"
       );
        if (result == true)
        {
            if (_user == null || _isSaving) return;

            _isSaving = true;
            StateHasChanged();
            try
            {


                var changes = new List<string>();
                var originalRole = (await UserManager.GetRolesAsync(_user)).FirstOrDefault() ?? "No Role";
                bool currentlyDisabled = _user.LockoutEnd.HasValue && _user.LockoutEnd.Value > DateTimeOffset.UtcNow;

                if (_user.EmployeeId != _editUser.EmployeeId) changes.Add($"Employee ID: '{_user.EmployeeId}' → '{_editUser.EmployeeId}'");
                if (_user.UserName != _editUser.UserName) changes.Add($"Username: '{_user.UserName}' → '{_editUser.UserName}'");
                if (_user.FullName != _editUser.FullName) changes.Add($"Full Name: '{_user.FullName}' → '{_editUser.FullName}'");
                if (_user.Department != _editUser.Department) changes.Add($"Department: '{_user.Department}' → '{_editUser.Department}'");
                if (originalRole != _editUser.Role) changes.Add($"Role: '{originalRole}' → '{_editUser.Role}'");
                if (_editUser.IsDisabled != currentlyDisabled) changes.Add(_editUser.IsDisabled ? "Account disabled" : "Account re-activated");
                var originalAllowed = new HashSet<int>(_user.GetAllowedLevelIds());
                if (!originalAllowed.SetEquals(_editUser.AllowedLevelIds))
                {
                    var oldStr = originalAllowed.Any() ? string.Join(", ", originalAllowed.OrderBy(x => x)) : "All levels";
                    var newStr = _editUser.AllowedLevelIds.Any() ? string.Join(", ", _editUser.AllowedLevelIds.OrderBy(x => x)) : "All levels";
                    changes.Add($"Allowed levels: [{oldStr}] → [{newStr}]");
                }

                if (!changes.Any())
                {
                    Snackbar.Add("No changes were made.", Severity.Info);
                    MudDialog.Cancel();
                    return;
                }


                _user.EmployeeId = _editUser.EmployeeId;
                _user.UserName = _editUser.UserName;
                _user.FullName = _editUser.FullName;
                _user.Department = _editUser.Department;
                _user.AllowedConfidentialityLevels = _editUser.Role == "Viewer" && _editUser.AllowedLevelIds.Any()
                    ? string.Join(",", _editUser.AllowedLevelIds.OrderBy(x => x))
                    : null;

                var updateResult = await UserManager.UpdateAsync(_user);
                if (!updateResult.Succeeded)
                {
                    foreach (var error in updateResult.Errors)
                        Snackbar.Add(error.Description, Severity.Error);
                    return;
                }


                var currentRoles = await UserManager.GetRolesAsync(_user);
                if (currentRoles.Any())
                {
                    var removeResult = await UserManager.RemoveFromRolesAsync(_user, currentRoles);
                    if (!removeResult.Succeeded)
                    {
                        Snackbar.Add("Failed to update role.", Severity.Error);
                        return;
                    }
                }
                var addResult = await UserManager.AddToRoleAsync(_user , _editUser.Role);
                if (!addResult.Succeeded)
                {

                    if (currentRoles.Any())
                        await UserManager.AddToRolesAsync(_user, currentRoles);
                    Snackbar.Add("Failed to assign new role.", Severity.Error);
                    return;
                }


                if (_editUser.IsDisabled && !currentlyDisabled)
                {
                    await UserManager.SetLockoutEnabledAsync(_user, true);
                    await UserManager.SetLockoutEndDateAsync(_user, DateTimeOffset.MaxValue);
                }
                else if (!_editUser.IsDisabled && currentlyDisabled)
                {
                    await UserManager.SetLockoutEndDateAsync(_user, null);
                }

                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
                await using var db = await DbFactory.CreateDbContextAsync();
                await db.TransactionLogs.AddAsync(new TransactionLog
                    {
                        FullName = currentAdmin,
                        EventName = "User Updated",
                        Description = $"User '{_editUser.FullName}': {string.Join(" | ", changes)}",
                        Status = _editUser.IsDisabled ? "Warning" : "Success",
                        PerformedAt = DateTime.UtcNow.AddHours(8)
                    });
                await db.SaveChangesAsync();

                Snackbar.Add("User updated successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error updating user: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isSaving = false;
                StateHasChanged();
            }
        }
    }

    private void Cancel()
    {
        if (_isSaving) return;
        MudDialog.Cancel();
    }

    public class EditUserModel
    {
        [Required] public string EmployeeId { get; set; } = "";
        [Required] public string UserName { get; set; } = "";
        [Required] public string FullName { get; set; } = "";
        [Required] public string Department { get; set; } = "";
        [Required] public string Role { get; set; } = "";
        public bool IsDisabled { get; set; } = false;
        public HashSet<int> AllowedLevelIds { get; set; } = new();
    }
}