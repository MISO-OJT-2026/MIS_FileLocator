@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]


@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context
@inject ICurrentUserService _currentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddUserDialog" Class=" mb-3">
    Add New User
</MudButton>

<MudDataGrid T="UserDisplayModel" Dense="true" Items="@_users"  Hover="true" Filterable="false" QuickFilter="@_quickFilter" RowClick="HandleGridRowClick">
    <ToolBarContent>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center" Class="w-100 py-2">
            <MudSpacer />

            @* Filter and Search Group *@
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @* Filter by Role *@
                <MudMenu Label="Filter by Role"
                         Variant="Variant.Outlined"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Dense="true"
                         StartIcon="@Icons.Material.Filled.FilterList"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Margin="Margin.Dense"
                         Style="width: 200px;">
                    <div class="pa-4" style="min-width: 200px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Filter by Role</MudText>
                        <MudSelect T="string" Label="Role" @bind-Value="_selectedRole"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                            <MudSelectItem Value="@("")">All Roles</MudSelectItem>
                            <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                            <MudSelectItem Value="@("Editor")">Editor</MudSelectItem>
                            <MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem>
                            <MudSelectItem Value="@("Staff")">Staff</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetFilters" Class="mt-2">Reset</MudButton>
                    </div>
                </MudMenu>

                @* Search Field *@
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="width: 250px;" />
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.EmployeeId" Title="Employee ID" />
        <PropertyColumn Property="x => x.UserName" Title="Username" />
        <PropertyColumn Property="x => x.FullName" Title="Full Name" />
        <PropertyColumn Property="x => x.Department" Title="Department" />
        <TemplateColumn Title="Role">
            <CellTemplate>
                <MudChip T="string" Color="@GetRoleColor(context.Item.Role)" Size="Size.Small">@context.Item.Role</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudStack Row="true" @onclick:stopPropagation="true">
                    <MudTooltip Text="Reset Password">
                        <MudIconButton Icon="@Icons.Material.Filled.VpnKey"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenResetPasswordDialog(context.Item.Id, context.Item.FullName))" />
                    </MudTooltip>
                    <MudTooltip Text="Delete User">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteUser(context.Item.Id))" />
                    </MudTooltip>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UserDisplayModel" />
    </PagerContent>
</MudDataGrid>

<style>
    .mud-table-root .mud-table-cell {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05) !important;
        padding: 8px 16px !important; /* Adjust '8px' to change row thickness */
    }

    .mud-table-head .mud-table-cell {
        border-bottom: 2px solid var(--mud-palette-primary) !important;
        font-weight: 700;
    }
</style>

@code {
    private bool _loading = true;
    private string _searchString = "";
    private string _selectedRole = "";
    private List<UserDisplayModel> _users = new();
    private Func<UserDisplayModel, bool> _quickFilter => x =>
    {
        // Filter by Role
        if (!string.IsNullOrWhiteSpace(_selectedRole))
        {
            if (x.Role != _selectedRole) return false;
        }

        // Search text
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            var s = _searchString.Trim();
            return x.EmployeeId.Contains(s, StringComparison.OrdinalIgnoreCase)
                || x.UserName.Contains(s, StringComparison.OrdinalIgnoreCase)
                || x.FullName.Contains(s, StringComparison.OrdinalIgnoreCase)
                || x.Department.Contains(s, StringComparison.OrdinalIgnoreCase)
                || x.Role.Contains(s, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    };

    private void ResetFilters()
    {
        _selectedRole = "";
        _searchString = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync() // fetch users in the database 
    {
        _loading = true;
        _users.Clear();

        var allUsers = await UserManager.Users.ToListAsync();

        foreach (var user in allUsers)
        {
            var roles = await UserManager.GetRolesAsync(user);
            _users.Add(new UserDisplayModel
                {
                    Id = user.Id,
                    EmployeeId = user.EmployeeId ?? "N/A",
                    UserName = user.UserName!,
                    FullName = user.FullName ?? "N/A",
                    Department = user.Department ?? "N/A",
                    Role = roles.FirstOrDefault() ?? "No Role"
                });
        }

        _loading = false;
    }

    private async Task OpenAddUserDialog()
    {
        // This tells MudBlazor to pop open your CreateUser.razor component!
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateUser>("Create New User", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            // If the user was saved successfully in the popup, refresh the table
            await LoadUsersAsync();
        }
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);


        if (user == null)
            return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete this user '{user.FullName}'?",
            yesText:"Delete",
            cancelText:"Cancel"
    );
        if(result == true)
        {


            var deleteResult = await UserManager.DeleteAsync(user);

            if (deleteResult.Succeeded)
            {
                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync(); // get full name from ICurrentUserService class
                var log = new TransactionLog
                    {
                        FullName = currentAdmin,
                        EventName = "User Deleted",
                        Description = $"Permanently deleted the account for {user.FullName} ({user.UserName}).",
                        Status = "Warning", // This will make the status chip stand out!
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                    };

                _context.TransactionLogs.Add(log);

                await _context.SaveChangesAsync();

                    Snackbar.Add($"User '{user.FullName}'deleted.", Severity.Info);
                    await LoadUsersAsync();
                }
                else
                {
                    foreach (var error in deleteResult.Errors)
                    {
                        Snackbar.Add(error.Description, Severity.Error);                    
                    }
                }
            }
        }
    

    private Color GetRoleColor(string role) => role switch
    {
        "Admin" => Color.Error,
        "Editor" => Color.Warning,
        "Viewer" => Color.Info,
        _ => Color.Default
    };

    private class UserDisplayModel
    {
        public string Id { get; set; } = "";
        public string EmployeeId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Department { get; set; } = "";
        public string Role { get; set; } = "";
    }

    private async Task HandleGridRowClick(DataGridRowClickEventArgs<UserDisplayModel> args)
    {
        var parameters = new DialogParameters
    {
        { "UserId", args.Item.Id }
    };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditUser>("Edit User", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadUsersAsync();
        }
    }

    //Reset Password 
    private async Task OpenResetPasswordDialog(string userId, string fullName)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>
    {
        { x => x.UserId, userId },
        { x => x.UserFullName, fullName }
    };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>("Reset User Password", parameters, options);
        await dialog.Result;
    }
}  