@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context
@inject ICurrentUserService _currentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">User Management</MudText>

@* ── Toolbar above tabs ── *@
<MudPaper Outlined="true" Class="pa-3 mb-3">
    @RenderToolbar()
</MudPaper>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" SliderColor="Color.Primary">

    @* --- ACTIVE USERS TAB --- *@
    <MudTabPanel Text="Active Users" Icon="@Icons.Material.Filled.Person">
        <MudDataGrid T="UserDisplayModel" Dense="true" Items="@_users.Where(u => !u.IsDisabled)" Hover="true" QuickFilter="@_quickFilter" RowClick="HandleGridRowClick">
            <Columns>
                <PropertyColumn Property="x => x.EmployeeId" Title="ID" />
                <PropertyColumn Property="x => x.FullName" Title="Name" />
                <PropertyColumn Property="x => x.Department" Title="Dept" />
                <TemplateColumn Title="Role">
                    <CellTemplate>
                        <MudChip T="string" Color="@GetRoleColor(context.Item.Role)" Size="Size.Small">@context.Item.Role</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" @onclick:stopPropagation="true">
                            <MudTooltip Text="Reset Password">
                                <MudIconButton Icon="@Icons.Material.Filled.VpnKey" Color="Color.Warning" Size="Size.Small" OnClick="@(() => OpenResetPasswordDialog(context.Item.Id, context.Item.FullName))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="UserDisplayModel" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    @* --- DISABLED USERS TAB --- *@
    <MudTabPanel Text="Disabled Users" Icon="@Icons.Material.Filled.PersonOff">
        <MudDataGrid T="UserDisplayModel" Dense="true" Items="@_users.Where(u => u.IsDisabled)" Hover="true" QuickFilter="@_quickFilter" RowClick="HandleGridRowClick">
            <Columns>
                <PropertyColumn Property="x => x.EmployeeId" Title="ID" />
                <PropertyColumn Property="x => x.FullName" Title="Name" />
                <PropertyColumn Property="x => x.Department" Title="Dept" />
                <TemplateColumn Title="Role">
                    <CellTemplate>
                        <MudChip T="string" Color="@GetRoleColor(context.Item.Role)" Size="Size.Small">@context.Item.Role</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" @onclick:stopPropagation="true">
                            <MudTooltip Text="Restore User">
                                <MudIconButton Icon="@Icons.Material.Filled.Restore" Color="Color.Success" Size="Size.Small" OnClick="@(() => ToggleUserStatus(context.Item, false))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete Permanently">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteUser(context.Item.Id))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="UserDisplayModel" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

</MudTabs>



@code {
    private bool _loading = true;
    private int _activeTab = 0;
    private string _searchString = "";
    private string _selectedRole = "";
    private List<UserDisplayModel> _users = new();

    
    RenderFragment RenderToolbar() => __builder =>
    {
        <div class="page-toolbar">
            <div class="toolbar-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddUserDialog">
                    Add New User
                </MudButton>
            </div>
            <div class="toolbar-filters">
                <MudMenu Label="FILTER ROLE" Variant="Variant.Outlined" Dense="true"
                         EndIcon="@Icons.Material.Filled.FilterList"
                         Style="font-weight:700; letter-spacing:0.05em;">
                    <div class="pa-4" style="min-width: 200px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Filter by Role</MudText>
                        <MudSelect T="string" Label="Role" @bind-Value="_selectedRole"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                            <MudSelectItem Value="@("")">All Roles</MudSelectItem>
                            <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                            <MudSelectItem Value="@("Editor")">Editor</MudSelectItem>
                            <MudSelectItem Value="@("Viewer")">Viewer</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetFilters" Class="mt-2">Reset</MudButton>
                    </div>
                </MudMenu>
                <MudTextField @bind-Value="_searchString" Placeholder="Search..."
                              Adornment="Adornment.Start" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </div>
        </div>
    };

    private Func<UserDisplayModel, bool> _quickFilter => x =>
    {
        if (!string.IsNullOrWhiteSpace(_selectedRole) && x.Role != _selectedRole) return false;
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            var s = _searchString.Trim();
            return x.EmployeeId.Contains(s, StringComparison.OrdinalIgnoreCase) || x.UserName.Contains(s, StringComparison.OrdinalIgnoreCase) || x.FullName.Contains(s, StringComparison.OrdinalIgnoreCase) || x.Department.Contains(s, StringComparison.OrdinalIgnoreCase);
        }
        return true;
    };

    protected override async Task OnInitializedAsync() => await LoadUsersAsync();

    private async Task LoadUsersAsync()
    {
        _loading = true;
        _users.Clear();
        var allUsers = await UserManager.Users.ToListAsync();
        foreach (var user in allUsers)
        {
            var roles = await UserManager.GetRolesAsync(user);
            _users.Add(new UserDisplayModel
            {
                Id = user.Id,
                EmployeeId = user.EmployeeId ?? "N/A",
                UserName = user.UserName!,
                FullName = user.FullName ?? "N/A",
                Department = user.Department ?? "N/A",
                Role = roles.FirstOrDefault() ?? "No Role",
                IsDisabled = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow
            });
        }
        _loading = false;
    }

    private async Task ToggleUserStatus(UserDisplayModel userModel, bool disable)
    {
        var user = await UserManager.FindByIdAsync(userModel.Id);
        if (user == null) return;

        // Disabling sets lockout to far future, restoring clears it
        if (disable)
            await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
        else
            await UserManager.SetLockoutEndDateAsync(user, null);

        Snackbar.Add($"User status updated successfully.", Severity.Success);
        await LoadUsersAsync();
    }

    private void ResetFilters() { _selectedRole = ""; _searchString = ""; }

    private Color GetRoleColor(string role) => role switch
    {
        "Admin" => Color.Error,
        "Editor" => Color.Warning,
        "Viewer" => Color.Info,
        _ => Color.Default
    };

    private async Task OpenAddUserDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateUser>("Create New User", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadUsersAsync();
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user == null) return;

        bool? result = await DialogService.ShowMessageBoxAsync("Confirm Delete", $"Permanently delete '{user.FullName}'?", yesText: "Delete", cancelText: "Cancel");
        if (result == true)
        {
            var deleteResult = await UserManager.DeleteAsync(user);
            if (deleteResult.Succeeded)
            {
                Snackbar.Add("User deleted.", Severity.Success);
                await LoadUsersAsync();
            }
        }
    }

    private async Task HandleGridRowClick(DataGridRowClickEventArgs<UserDisplayModel> args)
    {
        var parameters = new DialogParameters { { "UserId", args.Item.Id } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditUser>("Edit User", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadUsersAsync();
    }

    private async Task OpenResetPasswordDialog(string userId, string fullName)
    {
        var parameters = new DialogParameters<ResetPasswordDialog> { { x => x.UserId, userId }, { x => x.UserFullName, fullName } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<ResetPasswordDialog>("Reset Password", parameters, options);
    }

    public class UserDisplayModel
    {
        public string Id { get; set; } = "";
        public string EmployeeId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Department { get; set; } = "";
        public string Role { get; set; } = "";
        public bool IsDisabled { get; set; }
    }
}