@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]


@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context
@inject ICurrentUserService _currentUserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-4">User Management</MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddUserDialog" Class="mb-4">
        Add New User
    </MudButton>

    <MudTable T="UserDisplayModel" Items="@_users" Dense="true" Hover="true" Elevation="3" Loading="@_loading" OnRowClick="HandleRowClick">
        <HeaderContent>
            <MudTh>Employee ID</MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Full Name</MudTh>
            <MudTh>Department</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Employee ID">@context.EmployeeId</MudTd>
            <MudTd DataLabel="Username">@context.UserName</MudTd>
            <MudTd DataLabel="Full Name">@context.FullName</MudTd>
            <MudTd DataLabel="Department">@context.Department</MudTd>
            <MudTd DataLabel="Role">
                <MudChip T="string" Color="@GetRoleColor(context.Role)" Size="Size.Small">@context.Role</MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteUser(context.Id))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

</MudContainer>

@code {
    private bool _loading = true;
    private List<UserDisplayModel> _users = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync() // fetch users in the database 
    {
        _loading = true;
        _users.Clear();

        var allUsers = await UserManager.Users.ToListAsync();

        foreach (var user in allUsers)
        {
            var roles = await UserManager.GetRolesAsync(user);
            _users.Add(new UserDisplayModel
                {
                    Id = user.Id,
                    EmployeeId = user.EmployeeId ?? "N/A",
                    UserName = user.UserName!,
                    FullName = user.FullName ?? "N/A",
                    Department = user.Department ?? "N/A",
                    Role = roles.FirstOrDefault() ?? "No Role"
                });
        }

        _loading = false;
    }

    private async Task OpenAddUserDialog()
    {
        // This tells MudBlazor to pop open your CreateUser.razor component!
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateUser>("Create New User", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            // If the user was saved successfully in the popup, refresh the table
            await LoadUsersAsync();
        }
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);


        if (user == null)
            return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete this user '{user.FullName}'?",
            yesText:"Delete",
            cancelText:"Cancel"
    );
        if(result == true)
        {


            var deleteResult = await UserManager.DeleteAsync(user);

            if (deleteResult.Succeeded)
            {
                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync(); // get full name from ICurrentUserService class
                var log = new TransactionLog
                    {
                        FullName = currentAdmin,
                        EventName = "User Deleted",
                        Description = $"Permanently deleted the account for {user.FullName} ({user.UserName}).",
                        Status = "Warning", // This will make the status chip stand out!
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                    };

                _context.TransactionLogs.Add(log);

                await _context.SaveChangesAsync();

                    Snackbar.Add($"User '{user.FullName}'deleted.", Severity.Info);
                    await LoadUsersAsync();
                }
                else
                {
                    foreach (var error in deleteResult.Errors)
                    {
                        Snackbar.Add(error.Description, Severity.Error);                    
                    }
                }
            }
        }
    

    private Color GetRoleColor(string role) => role switch
    {
        "Admin" => Color.Error,
        "Editor" => Color.Warning,
        "Viewer" => Color.Info,
        _ => Color.Default
    };

    private class UserDisplayModel
    {
        public string Id { get; set; } = "";
        public string EmployeeId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Department { get; set; } = "";
        public string Role { get; set; } = "";
    }

    private async Task HandleRowClick(TableRowClickEventArgs<UserDisplayModel> args)
    {
        var parameters = new DialogParameters
    {
        { "UserId", args.Item.Id }
    };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditUser>("Edit User", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadUsersAsync();
        }
    }
}  