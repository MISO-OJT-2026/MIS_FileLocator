@page "/documentsPage"
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization

@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ICurrentUserService _currentUserService 
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService 


<MudText Typo="Typo.h5" Class="mb-4" Color="Color.Primary">Document Inventory</MudText>

<MudDataGrid T="Documents"
             Items="@_allDocuments.Where(d => !d.IsDeleted && !d.IsDisposal)"
             Filterable="true"
             QuickFilter="@_quickFilter"
             Hideable="true"
RowClick = "OnRowClicked">
    <ToolBarContent>
        <MudStack Row="true" Spacing="2">
   
        @if (RoleService.CanAddEditDocuments(_currentUserRole))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAddDialog())">
                File New Document
            </MudButton>
        }
            <MudTooltip Text="Print Inventory">
                <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success" Variant="Variant.Outlined" OnClick="ExportToCSV" />
            </MudTooltip>
        </MudStack>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search by Title, Year, or Folder..." Adornment="Adornment.Start"
                      Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 400px;" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Title" Title="Document Title" />
        <PropertyColumn Property="x => x.Year" Title="Year" Sortable="true" />

      
        <TemplateColumn Title="Physical Location">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2"><b>Folder:</b> @context.Item.Folder?.Name</MudText>
                    <MudText Typo="Typo.caption">@($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} > {context.Item.Folder?.FileBox?.Name}")</MudText>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        
        <TemplateColumn Title="Status">
            <CellTemplate >
                @if (context.Item.IsBorrowed)
                {
                    <MudTooltip Text="@($"Borrowed by: {context.Item.CurrentBorrower}")">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Outbound">Borrowed</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">Available</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Security">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@GetConfidentialityColor(context.Item.ConfidentialityLevel?.Name)">
                    @context.Item.ConfidentialityLevel?.Name
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        @if (RoleService.CanAddEditDocuments(_currentUserRole))
        {
            <TemplateColumn Title="Actions">
                <CellTemplate Context="doc">
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(doc.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => ConfirmDelete(doc.Item))" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
</MudDataGrid>

@code {
    private List<Documents> _allDocuments = new();
    private string _searchString = "";
    private string _currentUserRole = "";

    protected override async Task OnInitializedAsync() 
    {
        await LoadDocuments();
        await LoadCurrentUserRole();
    }

    private async Task LoadCurrentUserRole()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);
            _currentUserRole = roleClaim != null ? roleClaim.Value : "Staff";
        }
    }

    private async Task LoadDocuments() =>
        
        _allDocuments = await _context.Documents
            .Include(d => d.ConfidentialityLevel)
            .Include(d => d.Folder)
                .ThenInclude(f => f.FileBox)
                    .ThenInclude(b => b.FillingCabinet)
            .ToListAsync();

    private Func<Documents, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Year?.ToString().Contains(_searchString) == true) return true;
        if (x.Folder?.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private Color GetConfidentialityColor(string? name) => name?.ToLower() switch
    {
        "highly confidential" => Color.Error,
        "confidential" => Color.Warning,
        _ => Color.Default
    };

    private async Task OpenAddDialog(Documents doc = null )
    {
        var docToProcess = doc ?? new Documents();


        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDocumentDialog>("File New Document", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDocuments(); 
        }

    }
    private async Task OpenEditDialog(Documents doc)
    {


        var parameters = new DialogParameters<EditDocumentDialog> { { x => x.DocumentToEdit, doc } };
        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            };

        var dialog = await DialogService.ShowAsync<EditDocumentDialog>("Edit Document", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled) await LoadDocuments();
    }
    private async Task ConfirmDelete(Documents doc)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
        "Delete Confirmation", 
        $"Are you sure you want to delete '{doc.Title}'?", 
        yesText:"Delete", cancelText:"Cancel"
        );

        if (result == true)
        {
            try
            {
                

                var location = await _context.Folders
                .Where(f => f.Id == doc.FolderId)
                .Select(f => new { Folder = f.Name, Box = f.FileBox.Name, Cabinet = f.FileBox.FillingCabinet.Name })
                .FirstOrDefaultAsync();


                doc.IsDeleted = true;
                _context.Documents.Update(doc);

                var user = await _currentUserService.GetCurrentFullNameAsync();


                var log = new TransactionLog
                {
                    FullName= user,
                    EventName= "Document Deleted", 
                    Description = $"Delete Document '{doc.Title}' in {location?.Cabinet} > {location?.Box} > {location?.Folder}.",
                    Status= "Success",
                    PerformedAt = DateTime.UtcNow.AddHours(8)

                };

                _context.TransactionLogs.Add(log);

               
                await _context.SaveChangesAsync();

                Snackbar.Add("Document moved to trash.", Severity.Success);

               
                await LoadDocuments();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error during deletion: {ex.Message}", Severity.Error);
            }
        }


    }
    private async Task OnRowClicked(DataGridRowClickEventArgs<Documents> args)
    {
        var parameters = new DialogParameters<DocumentDetailsDialog> { { x => x.SelectedDoc, args.Item } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth  = true, CloseButton = true};

        await DialogService.ShowAsync<DocumentDetailsDialog>("Document Overview", parameters, options);
    }

    private async Task ExportToCSV()
    {
        
    }
}
