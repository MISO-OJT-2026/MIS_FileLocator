@page "/documentsPage"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization

@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ICurrentUserService _currentUserService 
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService 


<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Document Inventory</MudText>

<MudDataGrid T="Documents"
             Items="@_allDocuments.Where(d => !d.IsDeleted && !d.IsDisposal)"
             Filterable="false"
             Hover="true"
             QuickFilter="@_quickFilter"
             Hideable="true"
RowClick = "OnRowClicked">
    <ToolBarContent>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center" Class="w-100 py-2">
            @* Actions Group *@
            <MudStack Row="true" Spacing="2">
                @if (RoleService.CanAddEditDocuments(_currentUserRole))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAddDialog())">
                        File New Document
                    </MudButton>
                }
                <MudTooltip Text="Print Inventory">
                    <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success" Variant="Variant.Outlined" OnClick="ExportToCSV" />
                </MudTooltip>
            </MudStack>

            <MudSpacer />

            @* Filter and Search Group *@
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @* Filter by Status *@
                <MudMenu Label="Filter by Status"
                         Variant="Variant.Outlined"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Dense="true"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Margin="Margin.Dense"
                         Style="width: 250px;">
                    <div class="pa-4" style="min-width: 300px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Filter Documents</MudText>
                        
                        @* Status Filter *@
                        <MudSelect T="string" Label="Status" @bind-Value="_selectedStatus"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@("")">All Status</MudSelectItem>
                            <MudSelectItem Value="@("In Storage")">In Storage</MudSelectItem>
                            <MudSelectItem Value="@("Borrowed")">Borrowed</MudSelectItem>
                        </MudSelect>

                        @* Cabinet Filter *@
                        <MudSelect T="string"
                                   Label="Cabinet"
                                   Value="_selectedCabinet"
                                   ValueChanged="@(e => OnCabinetChanged(e))"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@("")">All Cabinets</MudSelectItem>
                            @foreach (var cabinet in GetAvailableCabinets())
                            {
                                <MudSelectItem Value="@cabinet">@cabinet</MudSelectItem>
                            }
                        </MudSelect>

                        @* Box Filter *@
                        <MudSelect T="string"
                                   Label="Box"
                                   Value="_selectedBox"
                                   ValueChanged="@(e => OnBoxChanged(e))"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2"
                                   Disabled="@string.IsNullOrWhiteSpace(_selectedCabinet)">
                            <MudSelectItem Value="@("")">All Boxes</MudSelectItem>
                            @foreach (var box in GetAvailableBoxes())
                            {
                                <MudSelectItem Value="@box">@box</MudSelectItem>
                            }
                        </MudSelect>

                        @* Folder Filter *@
                        <MudSelect T="string" Label="Folder" @bind-Value="_selectedFolder"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2"
                                   Disabled="@string.IsNullOrWhiteSpace(_selectedBox)">
                            <MudSelectItem Value="@("")">All Folders</MudSelectItem>
                            @foreach (var folder in GetAvailableFolders())
                            {
                                <MudSelectItem Value="@folder">@folder</MudSelectItem>
                            }
                        </MudSelect>

                        @* Confidentiality Level Filter *@
                        <MudSelect T="string" Label="Confidentiality Level" @bind-Value="_selectedConfidentiality"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@("")">All Levels</MudSelectItem>
                            @foreach (var level in GetAvailableConfidentialityLevels())
                            {
                                <MudSelectItem Value="@level">@level</MudSelectItem>
                            }
                        </MudSelect>

                        @* Year Filter *@
                        <MudSelect T="string" Label="Year" @bind-Value="_selectedYear"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@("")">All Years</MudSelectItem>
                            @foreach (var year in GetAvailableYears())
                            {
                                <MudSelectItem Value="@year">@year</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetFilters" Class="mt-2">Reset All Filters</MudButton>
                    </div>
                </MudMenu>

                @* Search Field *@
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="width: 200px;" />
            </MudStack>
        </MudStack>
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Title" Title="Document Title" />
        <PropertyColumn Property="x => x.Year" Title="Year" Sortable="true" />

      
        <TemplateColumn Title="Physical Location">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2"><b>Folder:</b> @context.Item.Folder?.Name</MudText>
                    <MudText Typo="Typo.caption">@($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} > {context.Item.Folder?.FileBox?.Name}")</MudText>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        
        <TemplateColumn Title="Status">
            <CellTemplate >
                @if (context.Item.IsBorrowed)
                {
                    <MudTooltip Text="@($"Borrowed by: {context.Item.CurrentBorrower}")">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Outbound">Borrowed</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">In Storage</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Security">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@GetConfidentialityColor(context.Item.ConfidentialityLevel?.Name)">
                    @context.Item.ConfidentialityLevel?.Name
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        @if (RoleService.CanAddEditDocuments(_currentUserRole))
        {
            <TemplateColumn Title="Actions">
                <CellTemplate Context="doc">
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(doc.Item))" />
                     
                    </div>
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
</MudDataGrid>

@code {
    private List<Documents> _allDocuments = new();
    private string _searchString = "";
    private string _currentUserRole = "";
    private string _selectedStatus = "";
    private string _selectedCabinet = "";
    private string _selectedBox = "";
    private string _selectedFolder = "";
    private string _selectedConfidentiality = "";
    private string _selectedYear = "";

    protected override async Task OnInitializedAsync() 
    {
        await LoadDocuments();
        await LoadCurrentUserRole();
    }

    private async Task LoadCurrentUserRole()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);
            _currentUserRole = roleClaim != null ? roleClaim.Value : "Staff";
        }
    }

    private async Task LoadDocuments() =>
        
        _allDocuments = await _context.Documents
            .Include(d => d.ConfidentialityLevel)
            .Include(d => d.Folder)
                .ThenInclude(f => f.FileBox)
                    .ThenInclude(b => b.FillingCabinet)
            .ToListAsync();

    private Func<Documents, bool> _quickFilter => x =>
    {
        // Filter by Status
        if (!string.IsNullOrWhiteSpace(_selectedStatus))
        {
            if (_selectedStatus == "In Storage" && x.IsBorrowed) return false;
            if (_selectedStatus == "Borrowed" && !x.IsBorrowed) return false;
        }

        // Filter by Cabinet
        if (!string.IsNullOrWhiteSpace(_selectedCabinet))
        {
            if (x.Folder?.FileBox?.FillingCabinet?.Name != _selectedCabinet) return false;
        }

        // Filter by Box
        if (!string.IsNullOrWhiteSpace(_selectedBox))
        {
            if (x.Folder?.FileBox?.Name != _selectedBox) return false;
        }

        // Filter by Folder
        if (!string.IsNullOrWhiteSpace(_selectedFolder))
        {
            if (x.Folder?.Name != _selectedFolder) return false;
        }

        // Filter by Confidentiality Level
        if (!string.IsNullOrWhiteSpace(_selectedConfidentiality))
        {
            if (x.ConfidentialityLevel?.Name != _selectedConfidentiality) return false;
        }

        // Filter by Year
        if (!string.IsNullOrWhiteSpace(_selectedYear))
        {
            if (x.Year?.ToString() != _selectedYear) return false;
        }

        // Search text
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.Year?.ToString().Contains(_searchString) == true) return true;
            if (x.Folder?.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            return false;
        }

        return true;
    };
    private void OnCabinetChanged(string value)
    {
        _selectedCabinet = value;
        _selectedBox = "";
        _selectedFolder = "";
        StateHasChanged();
    }

    private void OnBoxChanged(string value)
    {
        _selectedBox = value;
        _selectedFolder = "";
        StateHasChanged();
    }

    private void ResetFilters()
    {
        _selectedStatus = "";
        _selectedCabinet = "";
        _selectedBox = "";
        _selectedFolder = "";
        _selectedConfidentiality = "";
        _selectedYear = "";
        _searchString = "";
    }

    private IEnumerable<string> GetAvailableCabinets()
    {
        return _allDocuments
            .Where(d => d.Folder?.FileBox?.FillingCabinet != null)
            .Select(d => d.Folder.FileBox.FillingCabinet.Name)
            .Distinct()
            .OrderBy(c => c);
    }

    private IEnumerable<string> GetAvailableBoxes()
    {
        var query = _allDocuments.Where(d => d.Folder?.FileBox != null);
        
        if (!string.IsNullOrWhiteSpace(_selectedCabinet))
        {
            query = query.Where(d => d.Folder.FileBox.FillingCabinet?.Name == _selectedCabinet);
        }
        
        return query
            .Select(d => d.Folder.FileBox.Name)
            .Distinct()
            .OrderBy(b => b);
    }

    private IEnumerable<string> GetAvailableFolders()
    {
        var query = _allDocuments.Where(d => d.Folder != null);
        
        if (!string.IsNullOrWhiteSpace(_selectedCabinet))
        {
            query = query.Where(d => d.Folder.FileBox?.FillingCabinet?.Name == _selectedCabinet);
        }
        
        if (!string.IsNullOrWhiteSpace(_selectedBox))
        {
            query = query.Where(d => d.Folder.FileBox?.Name == _selectedBox);
        }
        
        return query
            .Select(d => d.Folder.Name)
            .Distinct()
            .OrderBy(f => f);
    }

    private IEnumerable<string> GetAvailableConfidentialityLevels()
    {
        return _allDocuments
            .Where(d => d.ConfidentialityLevel != null)
            .Select(d => d.ConfidentialityLevel.Name)
            .Distinct()
            .OrderBy(level => level);
    }

    private IEnumerable<string> GetAvailableYears()
    {
        return _allDocuments
            .Where(d => d.Year.HasValue)
            .Select(d => d.Year.Value.ToString())
            .Distinct()
            .OrderByDescending(year => year);
    }

    private Color GetConfidentialityColor(string? name) => name?.ToLower() switch
    {
        "highly confidential" => Color.Error,
        "confidential" => Color.Warning,
        _ => Color.Default
    };

    private async Task OpenAddDialog(Documents doc = null )
    {
        var docToProcess = doc ?? new Documents();


        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDocumentDialog>("File New Document", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDocuments(); 
        }

    }
    private async Task OpenEditDialog(Documents doc)
    {


        var parameters = new DialogParameters<EditDocumentDialog> { { x => x.DocumentToEdit, doc } };
        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false
            };

        var dialog = await DialogService.ShowAsync<EditDocumentDialog>("Edit Document", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled) await LoadDocuments();
    }
    
    private async Task OnRowClicked(DataGridRowClickEventArgs<Documents> args)
    {
        var parameters = new DialogParameters<DocumentDetailsDialog> { { x => x.SelectedDoc, args.Item } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth  = true, CloseButton = true};

        await DialogService.ShowAsync<DocumentDetailsDialog>("Document Overview", parameters, options);
    }

    private async Task ExportToCSV()
    {
        
    }
}
