@page "/documentsPage"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Security.Claims

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ICurrentUserService _currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Document Inventory</MudText>

@* ── Toolbar above grid ── *@
<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-actions">
            @if (RoleService.CanAddEditDocuments(_currentUserRole))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAddDialog())">
                    File New Document
                </MudButton>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Success"
                           Variant="Variant.Outlined" OnClick="ExportToCSV" />
        </div>
        <div class="toolbar-filters">
            <MudMenu Label="FILTER DOCUMENTS" Variant="Variant.Outlined" Dense="true"
                     EndIcon="@Icons.Material.Filled.FilterList"
                     Style="font-weight:100; letter-spacing:0.05em;">
                <div class="pa-4" style="min-width: 280px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Search Filters</MudText>
                    <MudSelect T="string" @bind-Value="_selectedStatus" Label="Status"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-2">
                        <MudSelectItem Value="@("")">All Status</MudSelectItem>
                        <MudSelectItem Value="@("In Storage")">In Storage</MudSelectItem>
                        <MudSelectItem Value="@("Borrowed")">Borrowed</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Label="Cabinet" Value="_selectedCabinet"
                               ValueChanged="@(e => OnCabinetChanged(e))"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-2">
                        <MudSelectItem Value="@("")">All Cabinets</MudSelectItem>
                        @foreach (var cabinet in GetAvailableCabinets())
                        {
                            <MudSelectItem Value="@cabinet">@cabinet</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="Box" Value="_selectedBox"
                               ValueChanged="@(e => OnBoxChanged(e))"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-2"
                               Disabled="@string.IsNullOrWhiteSpace(_selectedCabinet)">
                        <MudSelectItem Value="@("")">All Boxes</MudSelectItem>
                        @foreach (var box in GetAvailableBoxes())
                        {
                            <MudSelectItem Value="@box">@box</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_selectedConfidentiality" Label="Confidentiality"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-2">
                        <MudSelectItem Value="@("")">All Levels</MudSelectItem>
                        @foreach (var level in GetAvailableConfidentialityLevels())
                        {
                            <MudSelectItem Value="@level">@level</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker Label="Document Date (From)" @bind-Date="_docDateFrom"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2" />
                    <MudDatePicker Label="Document Date (To)" @bind-Date="_docDateTo"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2" />
                    <MudSelect T="string" @bind-Value="_selectedDisposalStatus" Label="Disposal Retention"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-2">
                        <MudSelectItem Value="@("")">All</MudSelectItem>
                        <MudSelectItem Value="@("pending")">Pending Disposal</MudSelectItem>
                        <MudSelectItem Value="@("disposed")">Already Disposed</MudSelectItem>
                        <MudSelectItem Value="@("none")">No Disposal Date</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetFilters" Class="mt-2">Reset All</MudButton>
                </div>
            </MudMenu>
            <MudTextField @bind-Value="_searchString" Placeholder="Search title or folder..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="1000" />
        </div>
    </div>
</MudPaper>

<MudDataGrid T="Documents"
             Items="@(_allDocuments?.Where(d => !d.IsDeleted && !d.IsDisposal) ?? Enumerable.Empty<Documents>())"
             Filterable="false"
             Hover="true"
             Dense="false"
             QuickFilter="@_quickFilter"
             Hideable="true"
             Breakpoint="Breakpoint.Sm"
             RowClick="OnRowClicked">
    <Columns>
        <PropertyColumn Property="x => x.Title" Title="Document Title" />
        <PropertyColumn Property="x => x.DocumentDate" Title="Date" Format="MMM dd, yyyy" Sortable="true" />

        <TemplateColumn Title="Location">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2"><b>Folder:</b> @context.Item.Folder?.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} > {context.Item.Folder?.FileBox?.Name}")
                    </MudText>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Status">
            <CellTemplate>
                @if (context.Item.IsBorrowed)
                {
                    <MudTooltip Text="@($"Borrowed by: {context.Item.CurrentBorrower}")">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Outbound" Variant="Variant.Text">Borrowed</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Text">In Storage</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Security">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@GetConfidentialityColor(context.Item.ConfidentialityLevel?.Name)">
                    @context.Item.ConfidentialityLevel?.Name
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        @if (RoleService.CanAddEditDocuments(_currentUserRole))
        {
            <TemplateColumn Title="Actions" HeaderStyle="text-align: right;" CellStyle="text-align:;">
                <CellTemplate Context="doc">
                     <MudStack Spacing="2" Row="true" AlignItems="AlignItems.Center">
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(doc.Item))" />
                    </div>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
</MudDataGrid>

<style>
    .mubd-button-label{
        font-weight:100!important;
    }
</style>

@code {
    private List<Documents> _allDocuments = new();
    private string _searchString = "";
    private string _currentUserRole = "";
    private List<int> _allowedConfidentialityLevels = new(); // empty = no restriction
    private string _selectedStatus = "";
    private string _selectedCabinet = "";
    private string _selectedBox = "";
    private string _selectedFolder = "";
    private string _selectedConfidentiality = "";
    private string _selectedDocumentDate = "";
    private string _selectedDisposalStatus = "";
    private DateTime? _docDateFrom = null;
    private DateTime? _docDateTo = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserRole();
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Documents
            .AsNoTracking()
            .Include(d => d.ConfidentialityLevel)
            .Include(d => d.Folder)
                .ThenInclude(f => f.FileBox)
                    .ThenInclude(b => b.FillingCabinet)
            .Where(d => true);

        // Apply confidentiality restriction for Viewers
        if (_allowedConfidentialityLevels.Any())
            query = query.Where(d => _allowedConfidentialityLevels.Contains(d.ConfidentialityLevelId));

        _allDocuments = await query.ToListAsync();
        StateHasChanged();
    }

    private async Task LoadCurrentUserRole()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity is { IsAuthenticated: true })
        {
            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);
            _currentUserRole = roleClaim != null ? roleClaim.Value : "Staff";

            // Load the user's confidentiality restriction from DB
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var appUser = await db.Users.AsNoTracking()
                    .Where(u => u.Id == userId)
                    .Select(u => new { u.AllowedConfidentialityLevels })
                    .FirstOrDefaultAsync();
                _allowedConfidentialityLevels = appUser != null
                    ? (string.IsNullOrWhiteSpace(appUser.AllowedConfidentialityLevels)
                        ? new List<int>()
                        : appUser.AllowedConfidentialityLevels.Split(',')
                            .Select(s => int.TryParse(s.Trim(), out var id) ? id : 0)
                            .Where(id => id > 0).ToList())
                    : new List<int>();
            }
        }
    }

    private Func<Documents, bool> _quickFilter => x =>
    {
        if (!string.IsNullOrWhiteSpace(_selectedStatus))
        {
            if (_selectedStatus == "In Storage" && x.IsBorrowed) return false;
            if (_selectedStatus == "Borrowed" && !x.IsBorrowed) return false;
        }

        if (!string.IsNullOrWhiteSpace(_selectedCabinet))
        {
            if (x.Folder?.FileBox?.FillingCabinet?.Name != _selectedCabinet) return false;
        }

        if (!string.IsNullOrWhiteSpace(_selectedBox))
        {
            if (x.Folder?.FileBox?.Name != _selectedBox) return false;
        }

        if (!string.IsNullOrWhiteSpace(_selectedConfidentiality))
        {
            if (x.ConfidentialityLevel?.Name != _selectedConfidentiality) return false;
        }

        // Document date range filter
        if (_docDateFrom.HasValue && x.DocumentDate.HasValue && x.DocumentDate.Value.Date < _docDateFrom.Value.Date) return false;
        if (_docDateTo.HasValue && x.DocumentDate.HasValue && x.DocumentDate.Value.Date > _docDateTo.Value.Date) return false;

        // Disposal retention filter
        if (!string.IsNullOrWhiteSpace(_selectedDisposalStatus))
        {
            if (_selectedDisposalStatus == "pending" && !(x.DateOfDisposal.HasValue && !x.IsDisposal)) return false;
            if (_selectedDisposalStatus == "disposed" && !x.IsDisposal) return false;
            if (_selectedDisposalStatus == "none" && x.DateOfDisposal.HasValue) return false;
        }

        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.Folder?.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            return false;
        }
        return true;
    };

    private void OnCabinetChanged(string value)
    {
        _selectedCabinet = value;
        _selectedBox = "";
        _selectedFolder = "";
    }

    private void OnBoxChanged(string value)
    {
        _selectedBox = value;
        _selectedFolder = "";
    }

    private void ResetFilters()
    {
        _selectedStatus = "";
        _selectedCabinet = "";
        _selectedBox = "";
        _selectedFolder = "";
        _selectedConfidentiality = "";
        _selectedDocumentDate = "";
        _selectedDisposalStatus = "";
        _docDateFrom = null;
        _docDateTo = null;
        _searchString = "";
    }

    private IEnumerable<string> GetAvailableCabinets() => _allDocuments
        .Where(d => d.Folder?.FileBox?.FillingCabinet != null)
        .Select(d => d.Folder.FileBox.FillingCabinet.Name)
        .Distinct().OrderBy(c => c);

    private IEnumerable<string> GetAvailableBoxes() => _allDocuments
        .Where(d => d.Folder?.FileBox != null && (_selectedCabinet == "" || d.Folder.FileBox.FillingCabinet?.Name == _selectedCabinet))
        .Select(d => d.Folder.FileBox.Name)
        .Distinct().OrderBy(b => b);

    private IEnumerable<string> GetAvailableConfidentialityLevels() => _allDocuments
        .Where(d => d.ConfidentialityLevel != null)
        .Select(d => d.ConfidentialityLevel.Name)
        .Distinct().OrderBy(l => l);

    private Color GetConfidentialityColor(string? name) => name?.ToLower() switch
    {
        "highly confidential" => Color.Error,
        "confidential" => Color.Warning,
        _ => Color.Default
    };

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDocumentDialog>("File New Document", options);
        if (!(await dialog.Result).Canceled) await LoadDocuments();
    }

    private async Task OpenEditDialog(Documents doc)
    {
        var parameters = new DialogParameters<EditDocumentDialog> { { x => x.DocumentToEdit, doc } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<EditDocumentDialog>("Edit Document", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadDocuments();
    }

    private async Task OnRowClicked(DataGridRowClickEventArgs<Documents> args)
    {
        var parameters = new DialogParameters<DocumentDetailsDialog> { { x => x.SelectedDoc, args.Item } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<DocumentDetailsDialog>("Document Overview", parameters, options);
    }

    private async Task ExportToCSV()
    {
        try
        {
            var builder = new StringBuilder();
           
            builder.AppendLine("Document Title,Date,Cabinet,Box,Folder,Status,Borrower,Confidentiality");

            
            var documentsToExport = _allDocuments
                .Where(d => !d.IsDeleted && !d.IsDisposal)
                .Where(_quickFilter) 
                .ToList();

            foreach (var doc in documentsToExport)
            {
                var title = doc.Title?.Replace("\"", "\"\""); 
                var date = doc.DocumentDate?.ToString("MMM dd, yyyy") ?? "N/A";
                var cabinet = doc.Folder?.FileBox?.FillingCabinet?.Name ?? "N/A";
                var box = doc.Folder?.FileBox?.Name ?? "N/A";
                var folder = doc.Folder?.Name ?? "N/A";
                var status = doc.IsBorrowed ? "Borrowed" : "In Storage";
                var borrower = doc.IsBorrowed ? doc.CurrentBorrower : "";
                var security = doc.ConfidentialityLevel?.Name ?? "Standard";

                builder.AppendLine($"\"{title}\",\"{date}\",\"{cabinet}\",\"{box}\",\"{folder}\",\"{status}\",\"{borrower}\",\"{security}\"");
            }

            var fileName = $"Document_Inventory_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, builder.ToString());

            Snackbar.Add("Inventory exported successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
}
}