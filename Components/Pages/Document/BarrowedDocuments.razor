@page "/barrowed"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider


<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Borrowed Inventory Tracking</MudText>

@* ── Toolbar above grid ── *@
<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-filters">
            <MudMenu Label="Filter Borrowed" Variant="Variant.Outlined" Dense="true"
                     EndIcon="@Icons.Material.Filled.FilterList">
                <div class="pa-4" style="min-width: 260px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Filter Options</MudText>
                    <MudDatePicker Label="Borrow Date (From)" @bind-Date="_borrowDateFrom"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                    <MudDatePicker Label="Borrow Date (To)" @bind-Date="_borrowDateTo"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                    <MudSelect T="string" Label="Status" @bind-Value="_selectedOverdue"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Class="mb-2">
                        <MudSelectItem Value="@("")">All</MudSelectItem>
                        <MudSelectItem Value="@("overdue")">Overdue</MudSelectItem>
                        <MudSelectItem Value="@("ontime")">On Time</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetBorrowFilters" Class="mt-2">Reset</MudButton>
                </div>
            </MudMenu>
            <MudTextField @bind-Value="_searchString" Placeholder="Search borrower or title..."
                          Adornment="Adornment.Start" Variant="Variant.Outlined"
                          Immediate="true" Margin="Margin.Dense"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    </div>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    <MudText Align="Align.Center" Class="my-4">Loading borrowed documents...</MudText>
}
else if (_borrowedDocs == null || !_borrowedDocs.Any())
{
    <MudAlert Severity="Severity.Info" Class="my-4">No borrowed documents found. All documents are currently in their storage locations.</MudAlert>
}
else
{
<MudDataGrid T="Documents" Items="@_borrowedDocs" Filterable="false" Hover="true" RowClick="OnRowClicked" Dense="true" QuickFilter="@_quickFilter">
    <Columns>
        @* Overdue Indication Column *@
        <TemplateColumn Title="Alert" Size="Size.Small">
            <CellTemplate>
                @if (context.Item.ExpectedReturnDate.HasValue && context.Item.ExpectedReturnDate.Value < DateTime.Today)
                {
                    <MudTooltip Text="Overdue!">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Title" Title="Document" />
        <PropertyColumn Property="x => x.CurrentBorrower" Title="Borrower" />

        <TemplateColumn Title="Borrow Date">
            <CellTemplate>
                @context.Item.BorrowedAt?.ToString("MMM dd, yyyy")
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Due Date">
            <CellTemplate>
                <MudText Color="@(GetDueDateColor(context.Item.ExpectedReturnDate))" Typo="Typo.body2">
                    @context.Item.ExpectedReturnDate?.ToString("MMM dd, yyyy")
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.BorrowRemarks" Title="Remarks" />

        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(() => ManageBorrow(context.Item))">
                    Manage/Return
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
</MudDataGrid>
}
<style>
    .mud-button-label{
        font-weight:100 !important;
    }
</style>
@code {
    private List<Documents>? _borrowedDocs = null;
    private string _searchString = "";
    private DateTime? _borrowDateFrom = null;
    private DateTime? _borrowDateTo = null;
    private string _selectedOverdue = "";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadBorrowed();

    private async Task LoadBorrowed()
    {
        try
        {
            _isLoading = true;
            using var scope = ServiceProvider.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            _borrowedDocs = await context.Documents
                .AsNoTracking()
                .Include(d => d.ConfidentialityLevel)
                .Include(d => d.Folder)
                .ThenInclude(f => f.FileBox)
                .ThenInclude(b => b.FillingCabinet)
                .Where(d => d.IsBorrowed && !d.IsDeleted)
                .OrderBy(d => d.ExpectedReturnDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading borrowed documents: {ex.Message}", Severity.Error);
            _borrowedDocs = new List<Documents>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Func<Documents, bool> _quickFilter => x =>
    {
        // Borrow date range
        if (_borrowDateFrom.HasValue && x.BorrowedAt.HasValue && x.BorrowedAt.Value.Date < _borrowDateFrom.Value.Date) return false;
        if (_borrowDateTo.HasValue && x.BorrowedAt.HasValue && x.BorrowedAt.Value.Date > _borrowDateTo.Value.Date) return false;

        // Overdue status
        if (!string.IsNullOrWhiteSpace(_selectedOverdue))
        {
            var isOverdue = x.ExpectedReturnDate.HasValue && x.ExpectedReturnDate.Value < DateTime.Today;
            if (_selectedOverdue == "overdue" && !isOverdue) return false;
            if (_selectedOverdue == "ontime" && isOverdue) return false;
        }

        // Search
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.CurrentBorrower?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            return false;
        }
        return true;
    };

    private void ResetBorrowFilters()
    {
        _borrowDateFrom = null;
        _borrowDateTo = null;
        _selectedOverdue = "";
        _searchString = "";
    }

    private Color GetDueDateColor(DateTime? dueDate)
    {
        if (!dueDate.HasValue) return Color.Default;
        return dueDate.Value < DateTime.Today ? Color.Error : Color.Default;
    }

    private async Task ManageBorrow(Documents doc)
    {
        var parameters = new DialogParameters<EditDocumentDialog> { { x => x.DocumentToEdit, doc } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<EditDocumentDialog>("Update Borrowing Status", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadBorrowed();
        }
    }

    private async Task OnRowClicked(DataGridRowClickEventArgs<Documents> args)
    {
        var parameters = new DialogParameters<DocumentDetailsDialog> { { x => x.SelectedDoc, args.Item } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        await DialogService.ShowAsync<DocumentDetailsDialog>("Document Overview", parameters, options);
    }
}