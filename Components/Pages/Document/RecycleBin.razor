@page "/recyclebin"
@attribute [Authorize(Roles = "Admin,Editor")]

@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService _currentUserService

<MudText Typo="Typo.h5" Class="mb-4">Recycle Bin</MudText>

<MudDataGrid T="Documents" Items="@_deletedDocuments" Filterable="true" Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Deleted Documents</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search deleted files..." Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Title" Title="Document Title" />
        <PropertyColumn Property="x => x.Year" Title="Year" />
        <TemplateColumn Title="Original Location">
            <CellTemplate>
                <MudText Typo="Typo.body2">
                    @($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} ->{context.Item.Folder?.FileBox?.Name} -> {context.Item.Folder?.Name}")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Restore"
                           Size="Size.Small"
                           OnClick="@(() => ConfirmRestore(context.Item))">
                    Restore
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
</MudDataGrid>

@code {
    private List<Documents> _deletedDocuments = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync() => await LoadDeletedDocuments();

    private async Task LoadDeletedDocuments()
    {
       
        _deletedDocuments = await _context.Documents
            .Include(d => d.Folder).ThenInclude(g => g.FileBox).ThenInclude(b => b.FillingCabinet)
            .Where(d => d.IsDeleted)
            .ToListAsync();
    }

    private async Task ConfirmRestore(Documents doc)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Restore Document",
            $"Do you want to restore '{doc.Title}' to the active inventory?",
            yesText: "Restore", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
       
                doc.IsDeleted = false;
                _context.Documents.Update(doc);

                
                var user = await _currentUserService.GetCurrentFullNameAsync();
                var log = new TransactionLog
                {
                    FullName = user,
                    EventName = "Document Restoration",
                    Description = $"Restored Document '{doc.Title}' to {doc.Folder?.Name}.",
                    Status = "Success",
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                };

                _context.TransactionLogs.Add(log);

       
                await _context.SaveChangesAsync();

                Snackbar.Add("Document restored successfully!", Severity.Success);
                await LoadDeletedDocuments();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}