@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Threading
@using Microsoft.EntityFrameworkCore
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject IDialogService DialogService
@inject IConfiguration _config

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudTabs Centered="true" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" TabClass="px-7 mx-4">

            @* TAB 1: General Info *@
            <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                <MudStack Spacing="4" Class="mt-4">
                    <MudTextField @bind-Value="_editDoc.Title" Label="Document Title" Variant="Variant.Outlined" Required="true" />
                    
                    <MudStack Row="true">
                        <MudDatePicker Label="Document Date" 
                                       Date="_editDoc.DocumentDate" 
                                       DateChanged="OnDocumentDateChanged"
                                       Variant="Variant.Outlined" 
                                       Required="true"
                                       DateFormat="MMM dd, yyyy" />

                        <MudSelect T="int" Label="Confidentiality" @bind-Value="_editDoc.ConfidentialityLevelId" Variant="Variant.Outlined">
                            @foreach (var level in _levels)
                            {
                                <MudSelectItem Value="@level.Id">@level.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    <MudTextField @bind-Value="_editDoc.Description" Label="Description" Lines="3" Variant="Variant.Outlined" />
                    
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudSelect T="int" Label="Retention (Years)" @bind-Value="_retentionYears" @bind-Value:after="CalculateDisposal" Variant="Variant.Outlined">
                            @for (int i = 1; i <= 10; i++)
                            {
                                var years = i;
                                <MudSelectItem Value="@years">@years Years</MudSelectItem>
                            }
                        </MudSelect>
                        <MudDatePicker Label="Scheduled Disposal Date" 
                                       @bind-Date="_editDoc.DateOfDisposal" 
                                       Variant="Variant.Outlined" 
                                       ReadOnly="true"
                                       Color="Color.Secondary"
                                       HelperText="Calculated from Document Date"
                                       DateFormat="MMM dd, yyyy" />
                    </MudStack>
                </MudStack>
            </MudTabPanel>

            @* TAB 2: Digital Copy (RESTORED) *@
            <MudTabPanel Text="Digital Copy" Icon="@Icons.Material.Filled.Cloud">
                <MudStack Spacing="4" Class="mt-4">
                    @if (!string.IsNullOrEmpty(_editDoc.FilePath))
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                                <MudText>
                                    Current Digital Copy: 
                                    <MudLink Href="@_editDoc.FilePath" Target="_blank" Style="color: white !important;"><b>View File</b></MudLink>
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Variant="Variant.Filled"
                                               OnClick="RemoveDigitalFile" 
                                               Title="Remove from cloud" />
                            </MudStack>
                        </MudAlert>
                    }

                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.doc,.docx,.jpg,.png">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FileUpload" FullWidth="true">
                                @(_selectedFile == null ? "Replace/Upload New Digital Copy" : _selectedFile.Name)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    
                    @if (_isUploading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                </MudStack>
            </MudTabPanel>

            @* TAB 3: Borrowing *@
            <MudTabPanel Text="Borrowing" Icon="@Icons.Material.Filled.Outbound">
                <MudStack Spacing="3" Class="mt-4">
                    <MudAlert Severity="@(_editDoc.IsBorrowed ? Severity.Error : Severity.Success)" Variant="Variant.Outlined">
                        Status: @(_editDoc.IsBorrowed ? $"OUT (Borrowed by {_editDoc.CurrentBorrower})" : "IN (Available)")
                    </MudAlert>
                    <MudSwitch @bind-Value="_editDoc.IsBorrowed" Label="@(_editDoc.IsBorrowed ? "Mark as Returned" : "Mark as Borrowed")" Color="Color.Error" UnCheckedColor="Color.Success" />
                    @if (_editDoc.IsBorrowed)
                    {
                        <MudTextField @bind-Value="_editDoc.CurrentBorrower" Label="Borrower Name" Variant="Variant.Outlined" Required="true" />
                        <MudDatePicker Label="Expected Return Date" @bind-Date="_editDoc.ExpectedReturnDate" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_editDoc.BorrowRemarks" Label="Borrow Remarks" Variant="Variant.Outlined" />
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates" Disabled="@_isUploading">
            @(_isUploading ? "Uploading..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Documents DocumentToEdit { get; set; } = default!;

    private Documents _editDoc = new();
    private List<ConfidentialityLevel> _levels = new();
    private IBrowserFile? _selectedFile;
    private bool _isUploading = false;
    private int _retentionYears = 2;
    private string _oldValuesJson = "";

    // CONFIG: Fixes the cycle crash
    private JsonSerializerOptions _jsonOptions = new() { ReferenceHandler = ReferenceHandler.IgnoreCycles };

    protected override async Task OnInitializedAsync()
    {
        _levels = await _context.ConfidentialityLevels.ToListAsync();
        
        if (DocumentToEdit != null)
        {
            // Fix: Safe clone to prevent crash
            var json = JsonSerializer.Serialize(DocumentToEdit, _jsonOptions);
            _editDoc = JsonSerializer.Deserialize<Documents>(json)!;
            _oldValuesJson = json;

            if (_editDoc.DocumentDate.HasValue && _editDoc.DateOfDisposal.HasValue)
            {
                _retentionYears = _editDoc.DateOfDisposal.Value.Year - _editDoc.DocumentDate.Value.Year;
                if (_retentionYears < 1) _retentionYears = 2;
            }
        }
    }

    private void OnDocumentDateChanged(DateTime? newDate)
    {
        _editDoc.DocumentDate = newDate;
        CalculateDisposal();
    }

    private void CalculateDisposal()
    {
        if (_editDoc.DocumentDate.HasValue)
        {
            _editDoc.DateOfDisposal = _editDoc.DocumentDate.Value.AddYears(_retentionYears);
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        StateHasChanged();
    }

    private async Task SaveUpdates()
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Changes", "Update document record?", yesText: "Save", cancelText: "Cancel");
        if (confirm == null || confirm == false) return;

        var realDoc = await _context.Documents.FindAsync(_editDoc.Id);
        if (realDoc == null) return;

        try 
        {
            _isUploading = true;
            StateHasChanged();
            var user = await _currentUserService.GetCurrentFullNameAsync();
            List<string> changeLog = new();

            // Handle New File Upload
            if (_selectedFile != null)
            {
                string conn = _config.GetConnectionString("AzureStorage");
                var container = new BlobServiceClient(conn).GetBlobContainerClient("documents");
                string fileName = $"{Guid.NewGuid()}_{_selectedFile.Name}";
                var blob = container.GetBlobClient(fileName);

                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
                await blob.UploadAsync(stream, new BlobHttpHeaders { ContentType = _selectedFile.ContentType });

                realDoc.FilePath = blob.Uri.ToString();
                realDoc.FileName = _selectedFile.Name;
                _editDoc.FilePath = realDoc.FilePath; // Keep in sync for audit trail
                changeLog.Add("Replaced digital attachment");
            }

            // Borrowing logic logs
            if (!DocumentToEdit.IsBorrowed && _editDoc.IsBorrowed) changeLog.Add($"Borrowed by {_editDoc.CurrentBorrower}");
            else if (DocumentToEdit.IsBorrowed && !_editDoc.IsBorrowed) changeLog.Add($"Returned by {DocumentToEdit.CurrentBorrower}");

            // Sync Database record
            _context.Entry(realDoc).CurrentValues.SetValues(_editDoc);
            realDoc.UpdatedBy = user;

            // Manage Borrowing Dates
            if (_editDoc.IsBorrowed && realDoc.BorrowedAt == null) realDoc.BorrowedAt = DateTime.UtcNow.AddHours(8);
            if (!_editDoc.IsBorrowed) { realDoc.BorrowedAt = null; realDoc.CurrentBorrower = null; }

            // 1. Audit Trail (Detailed JSON)
            _context.AuditTrails.Add(new AuditTrails {
                FullName = user,
                Action = "Modified",
                TableName = "Documents",
                RecordId = realDoc.Id.ToString(),
                OldValues = _oldValuesJson,
                NewValues = JsonSerializer.Serialize(_editDoc, _jsonOptions),
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            // 2. Transaction Log (Friendly)
            _context.TransactionLogs.Add(new TransactionLog {
                FullName = user,
                EventName = "Document Modified",
                Description = $"{realDoc.Title}: {(changeLog.Any() ? string.Join(", ", changeLog) : "Metadata updated")}",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            Snackbar.Add("Saved and Audit Trail created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        finally { _isUploading = false; }
    }

    private async Task RemoveDigitalFile()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Remove File", "Delete the cloud file?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                var realDoc = await _context.Documents.FindAsync(_editDoc.Id);
                if (realDoc == null || string.IsNullOrEmpty(realDoc.FilePath)) return;

                string conn = _config.GetConnectionString("AzureStorage");
                var container = new BlobServiceClient(conn).GetBlobContainerClient("documents");
                string blobName = Path.GetFileName(new Uri(realDoc.FilePath).LocalPath);
                await container.GetBlobClient(blobName).DeleteIfExistsAsync();

                realDoc.FilePath = null;
                realDoc.FileName = null;
                _editDoc.FilePath = null;

                await _context.SaveChangesAsync();
                Snackbar.Add("Digital copy removed.", Severity.Warning);
                StateHasChanged();
            }
            catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}