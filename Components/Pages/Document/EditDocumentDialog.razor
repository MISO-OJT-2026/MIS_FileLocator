@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Threading
@using Microsoft.EntityFrameworkCore
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject IDialogService DialogService
@inject IConfiguration _config

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudTabs Centered="true" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" TabClass="px-7 mx-4">

            
            <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                <MudStack Spacing="4" Class="mt-4">
                    <MudTextField @bind-Value="_editDoc.Title" Label="Document Title" Variant="Variant.Outlined" Required="true" />
                    
                    <MudStack Row="true">
                        <MudDatePicker Label="Document Date" 
                                       Date="_editDoc.DocumentDate" 
                                       DateChanged="OnDocumentDateChanged"
                                       Variant="Variant.Outlined" 
                                       Required="true"
                                       DateFormat="MMM dd, yyyy" />

                        <MudSelect T="int" Label="Confidentiality" @bind-Value="_editDoc.ConfidentialityLevelId" Variant="Variant.Outlined">
                            @foreach (var level in _levels)
                            {
                                <MudSelectItem Value="@level.Id">@level.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    <MudTextField @bind-Value="_editDoc.Description" Label="Description" Lines="3" Variant="Variant.Outlined" />
                    
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudSelect T="int" Label="Retention (Years)" @bind-Value="_retentionYears" @bind-Value:after="CalculateDisposal" Variant="Variant.Outlined">
                            
                            @for (int i = 1; i <= 10; i++)
                            {
                                var years = i;
                                <MudSelectItem Value="@years">@years Years</MudSelectItem>
                            }
                        </MudSelect>
                        <MudDatePicker Label="Scheduled Disposal Date" 
                                       @bind-Date="_editDoc.DateOfDisposal" 
                                       Variant="Variant.Outlined" 
                                       ReadOnly="true"
                                       Color="Color.Secondary"
                                       
                                       DateFormat="MMM dd, yyyy" />
                    </MudStack>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Digital Copy" Icon="@Icons.Material.Filled.Cloud">
                <MudStack Spacing="4" Class="mt-4">

                    @if (!string.IsNullOrEmpty(_editDoc.FilePath) && !_pendingFileRemoval)
                    {
                        @* Current file exists and not yet marked for removal *@
                        <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                                <MudText>
                                    Current Digital Copy:
                                    <MudLink Href="@_editDoc.FilePath" Target="_blank" Style="color:white !important;"><b>View File</b></MudLink>
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" Variant="Variant.Filled"
                                               OnClick="MarkFileForRemoval"
                                               Title="Mark for removal (will delete on Save)" />
                            </MudStack>
                        </MudAlert>
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">
                            To replace this file, click 🗑 to mark it for removal, then browse a new file. Changes apply when you click Save Changes.
                        </MudAlert>
                    }

                    @if (_pendingFileRemoval)
                    {
                        @* Marked for removal — show undo option *@
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                                <MudText>Current file will be <b>permanently deleted</b> when you save.</MudText>
                                <MudSpacer />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.Undo"
                                           OnClick="UndoFileRemoval">Undo</MudButton>
                            </MudStack>
                        </MudAlert>
                    }

                    @if (_pendingFileRemoval || string.IsNullOrEmpty(_editDoc.FilePath))
                    {
                        @* Show upload section when no current file or marked for removal *@
                        @if (_selectedFile != null)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2"><b>New file selected:</b> @_selectedFile.Name (@((_selectedFile.Size / 1024.0 / 1024.0).ToString("0.00")) MB)</MudText>
                                    <MudSpacer />
                                    
                                </MudStack>
                            </MudAlert>
                        }

                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.doc,.docx,.jpg,.png">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.FileUpload" FullWidth="true">
                                    @(_selectedFile == null ? "Browse & Select New File" : "Change Selected File")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    }

                    @if (_isUploading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary">Uploading file, please wait...</MudText>
                    }
                </MudStack>
            </MudTabPanel>

            
            <MudTabPanel Text="Borrowing" Icon="@Icons.Material.Filled.Outbound">
                <MudStack Spacing="3" Class="mt-4">
                    <MudAlert Severity="@(_editDoc.IsBorrowed ? Severity.Error : Severity.Success)" Variant="Variant.Outlined">
                        Status: @(_editDoc.IsBorrowed ? $"OUT (Borrowed by {_editDoc.CurrentBorrower})" : "IN (Available)")
                    </MudAlert>
                    @if (_editDoc.IsBorrowed)
                    {
                        @* Document is borrowed — show Return toggle on the left *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSwitch @bind-Value="_editDoc.IsBorrowed"
                                       Color="Color.Warning"
                                       UnCheckedColor="Color.Success" />
                            <MudText Typo="Typo.body2" Color="Color.Warning"><b>Return</b></MudText>
                        </MudStack>
                    }
                    else
                    {
                        @* Document is available — show Borrow toggle on the right *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSwitch @bind-Value="_editDoc.IsBorrowed"
                                       Color="Color.Warning"
                                       UnCheckedColor="Color.Success" />
                            <MudText Typo="Typo.body2" Color="Color.Success"><b>Borrow</b></MudText>
                        </MudStack>
                    }
                    @if (_editDoc.IsBorrowed)
                    {
                        <MudTextField @bind-Value="_editDoc.CurrentBorrower" Label="Borrower Name" Variant="Variant.Outlined" Required="true" />
                        <MudDatePicker Label="Expected Return Date" @bind-Date="_editDoc.ExpectedReturnDate" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_editDoc.BorrowRemarks" Label="Borrow Remarks" Variant="Variant.Outlined" />
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates" Disabled="@_isUploading">
            @(_isUploading ? "Uploading..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Documents DocumentToEdit { get; set; } = default!;

    private Documents _editDoc = new();
    private List<ConfidentialityLevel> _levels = new();
    private IBrowserFile? _selectedFile;
    private bool _isUploading = false;
    private int _retentionYears = 2;
    private bool _pendingFileRemoval = false; // true = user marked file for deletion, not yet saved

    // Deep-copy options — prevents circular reference crash when cloning the document
    private JsonSerializerOptions _jsonOptions = new() { ReferenceHandler = ReferenceHandler.IgnoreCycles };

    protected override async Task OnInitializedAsync()
    {
        using var _context = await DbFactory.CreateDbContextAsync();
        _levels = await _context.ConfidentialityLevels.ToListAsync();
        
        if (DocumentToEdit != null)
        {
            var json = JsonSerializer.Serialize(DocumentToEdit, _jsonOptions);
            _editDoc = JsonSerializer.Deserialize<Documents>(json)!;

            if (_editDoc.DocumentDate.HasValue && _editDoc.DateOfDisposal.HasValue)
            {
                _retentionYears = _editDoc.DateOfDisposal.Value.Year - _editDoc.DocumentDate.Value.Year;
                if (_retentionYears < 1) _retentionYears = 2;
            }
        }
    }

    private void OnDocumentDateChanged(DateTime? newDate)
    {
        _editDoc.DocumentDate = newDate;
        CalculateDisposal();
    }

    private void CalculateDisposal()
    {
        if (_editDoc.DocumentDate.HasValue)
        {
            _editDoc.DateOfDisposal = _editDoc.DocumentDate.Value.AddYears(_retentionYears);
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        StateHasChanged();
    }

    private async Task SaveUpdates()

    {
        using var _context = await DbFactory.CreateDbContextAsync();
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Changes", "Update document record?", yesText: "Save", cancelText: "Cancel");
        if (confirm == null || confirm == false) return;

        var realDoc = await _context.Documents.FindAsync(_editDoc.Id);
        if (realDoc == null) return;

        try 
        {
            _isUploading = true;
            StateHasChanged();
            var user = await _currentUserService.GetCurrentFullNameAsync();
            
           
            List<string> changeLog = new();

            if (DocumentToEdit.Title != _editDoc.Title) 
                changeLog.Add($"Title: '{DocumentToEdit.Title}' → '{_editDoc.Title}'");

            if (DocumentToEdit.DocumentDate != _editDoc.DocumentDate) 
                changeLog.Add($"Date: {DocumentToEdit.DocumentDate?.ToString("MMM dd, yyyy")} → {_editDoc.DocumentDate?.ToString("MMM dd, yyyy")}");

            if (DocumentToEdit.ConfidentialityLevelId != _editDoc.ConfidentialityLevelId)
            {
                var oldLevel = _levels.FirstOrDefault(l => l.Id == DocumentToEdit.ConfidentialityLevelId)?.Name;
                var newLevel = _levels.FirstOrDefault(l => l.Id == _editDoc.ConfidentialityLevelId)?.Name;
                changeLog.Add($"Security: '{oldLevel}' → '{newLevel}'");
            }

            if (DocumentToEdit.Description != _editDoc.Description) 
                changeLog.Add("Description updated");

            if (DocumentToEdit.DateOfDisposal != _editDoc.DateOfDisposal)
                changeLog.Add($"Disposal Date: {DocumentToEdit.DateOfDisposal?.ToString("MMM dd, yyyy") ?? "None"} → {_editDoc.DateOfDisposal?.ToString("MMM dd, yyyy") ?? "None"}");

            
            if (!string.IsNullOrEmpty(DocumentToEdit.FilePath) && string.IsNullOrEmpty(_editDoc.FilePath))
                changeLog.Add("Digital file removed");

            
            if (_pendingFileRemoval && !string.IsNullOrEmpty(DocumentToEdit.FilePath))
            {
                try
                {
                    string conn = _config.GetConnectionString("AzureStorage");
                    var container = new BlobServiceClient(conn).GetBlobContainerClient("documents");
                    string blobName = Path.GetFileName(new Uri(DocumentToEdit.FilePath).LocalPath);
                    await container.GetBlobClient(blobName).DeleteIfExistsAsync();
                }
                catch { }

                realDoc.FilePath = null;
                realDoc.FileName = null;
                _editDoc.FilePath = null;
                if (!changeLog.Contains("Digital file removed"))
                    changeLog.Add("Digital file removed");
            }

            if (DocumentToEdit.IsBorrowed != _editDoc.IsBorrowed)
                changeLog.Add(_editDoc.IsBorrowed ? $"Marked as Borrowed by {_editDoc.CurrentBorrower}" : $"Returned by {DocumentToEdit.CurrentBorrower}");

            if (DocumentToEdit.IsBorrowed && _editDoc.IsBorrowed)
            {
                if (DocumentToEdit.CurrentBorrower != _editDoc.CurrentBorrower)
                    changeLog.Add($"Borrower: '{DocumentToEdit.CurrentBorrower}' → '{_editDoc.CurrentBorrower}'");
                if (DocumentToEdit.ExpectedReturnDate != _editDoc.ExpectedReturnDate)
                    changeLog.Add($"Due Date: {DocumentToEdit.ExpectedReturnDate?.ToString("MMM dd, yyyy")} → {_editDoc.ExpectedReturnDate?.ToString("MMM dd, yyyy")}");
                if (DocumentToEdit.BorrowRemarks != _editDoc.BorrowRemarks)
                    changeLog.Add("Borrow remarks updated");
            }
           


            
            if (_selectedFile != null)
            {
                
                if (!string.IsNullOrEmpty(realDoc.FilePath))
                {
                    Snackbar.Add("Please remove the current file before uploading a new one.", Severity.Warning);
                    return;
                }

                string conn = _config.GetConnectionString("AzureStorage");
                var container = new BlobServiceClient(conn).GetBlobContainerClient("documents");
                
                string safeFileName = _selectedFile.Name.Replace(" ", "_");
                string fileName = $"{Guid.NewGuid()}_{safeFileName}";
                var blob = container.GetBlobClient(fileName);

                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
                
                var headers = new BlobHttpHeaders { 
                    ContentType = _selectedFile.ContentType,
                    ContentDisposition = $"attachment; filename=\"{_selectedFile.Name}\"" 
                };

                await blob.UploadAsync(stream, headers);

                realDoc.FilePath = blob.Uri.ToString();
                realDoc.FileName = _selectedFile.Name;
                _editDoc.FilePath = realDoc.FilePath; 
                changeLog.Add($"Uploaded digital file: '{_selectedFile.Name}'");
            }

            if (!changeLog.Any() && _selectedFile == null && !_pendingFileRemoval)
            {
                Snackbar.Add("No changes were made.", Severity.Info);
                MudDialog.Cancel();
                return;
            }

            _context.Entry(realDoc).CurrentValues.SetValues(_editDoc);
            realDoc.UpdatedBy = user;

            
            if (_editDoc.IsBorrowed && realDoc.BorrowedAt == null) realDoc.BorrowedAt = DateTime.UtcNow.AddHours(8);
            if (!_editDoc.IsBorrowed) { realDoc.BorrowedAt = null; realDoc.CurrentBorrower = null; realDoc.ExpectedReturnDate = null; realDoc.BorrowRemarks = null; }

            _context.TransactionLogs.Add(new TransactionLog {
                FullName = user,
                EventName = "Document Modified",
                Description = $"Document '{DocumentToEdit.Title}': {string.Join(" | ", changeLog)}",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            Snackbar.Add("Document updated successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        finally { _isUploading = false; }
    }

    private void MarkFileForRemoval()
    {
        _pendingFileRemoval = true;
        _selectedFile = null;
        StateHasChanged();
    }

    private void UndoFileRemoval()
    {
        _pendingFileRemoval = false;
        _selectedFile = null;
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();
}