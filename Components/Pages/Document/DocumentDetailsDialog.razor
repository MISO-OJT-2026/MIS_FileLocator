@using FileLocator.Models
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @* --- EMPHASIZED LOCATION HEADER --- *@
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.LocationOn" Class="mb-6 py-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Style="text-transform: uppercase; letter-spacing: 1px;">Physical Storage Location</MudText>
                <MudText Typo="Typo.h5">
                    <b>@SelectedDoc.Folder?.FileBox?.FillingCabinet?.Name</b>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    @SelectedDoc.Folder?.FileBox?.Name
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    @SelectedDoc.Folder?.Name
                </MudText>
            </MudStack>
        </MudAlert>

        @* --- DOCUMENT INFO SECTION --- *@
        <MudText Typo="Typo.subtitle2" Color="Color.Primary">DOCUMENT TITLE</MudText>
        <MudText Typo="Typo.h4" Class="mb-4">@SelectedDoc.Title</MudText>

        <MudText Typo="Typo.subtitle2" Color="Color.Primary">DESCRIPTION</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">@(string.IsNullOrEmpty(SelectedDoc.Description) ? "No description provided." : SelectedDoc.Description)</MudText>

        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">DOCUMENT DATE</MudText>
                <MudText Typo="Typo.body2">@SelectedDoc.DocumentDate?.ToString("MMM dd, yyyy")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">CONFIDENTIALITY</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@SelectedDoc.ConfidentialityLevel?.Name</MudChip>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        @* --- BORROWING DETAILS SECTION --- *@
        @if (SelectedDoc.IsBorrowed)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4 border-dashed" Style="border-color: var(--mud-palette-error); background-color: #fff8f8;">
                <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="mb-3">BORROWING DETAILS</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="d-block">Borrower Name</MudText>
                        <MudText Typo="Typo.body2"><b>@SelectedDoc.CurrentBorrower</b></MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="d-block">Date Borrowed</MudText>
                        <MudText Typo="Typo.body2">@SelectedDoc.BorrowedAt?.ToString("MMM dd, yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="d-block">Remarks</MudText>
                        <MudText Typo="Typo.body2" Style="font-style: italic;">
                            @(string.IsNullOrEmpty(SelectedDoc.BorrowRemarks) ? "No remarks provided." : SelectedDoc.BorrowRemarks)
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudDivider Class="my-4" />

        @* --- DIGITAL ASSETS & METADATA SECTION --- *@
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">DIGITAL ASSETS</MudText>
                @if (!string.IsNullOrEmpty(SelectedDoc.FilePath))
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               Href="@SelectedDoc.FilePath"
                               Target="_blank">
                        View Digital Copy
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.CloudOff">
                        No Digital Copy Uploaded
                    </MudAlert>
                }
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">FILE METADATA</MudText>
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption"><b>Filed At:</b> @SelectedDoc.FiledAt.ToString("MMM dd, yyyy")</MudText>
                    <MudText Typo="Typo.caption"><b>Filed By:</b> @SelectedDoc.FiledBy</MudText>
                    <MudText Typo="Typo.caption"><b>Retention:</b> Disposal on @SelectedDoc.DateOfDisposal?.ToString("MMM dd, yyyy")</MudText>
                    @if (!string.IsNullOrEmpty(SelectedDoc.UpdatedBy))
                    {
                        <MudText Typo="Typo.caption"><b>Last Modified By:</b> @SelectedDoc.UpdatedBy</MudText>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Documents SelectedDoc { get; set; } = new();

    private void Close() => MudDialog.Close();
}