@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@using Microsoft.EntityFrameworkCore
@using System.Threading
@using System.Text.Json
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject IConfiguration _config

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            @* --- Basic Info --- *@
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_newForm.FormName" 
                              Label="Form Name (e.g., Adding/Changing Form)" 
                              Variant="Variant.Outlined" 
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newForm.FormNumber" 
                              Label="Form Number" 
                              Placeholder="TSU-OAR-SF-22"
                              Variant="Variant.Outlined" />
            </MudItem>

            @* --- DYNAMIC CATEGORY --- *@
            <MudItem xs="12">
                <MudAutocomplete T="string" Label="Issuing Office / Category" 
                                 @bind-Value="_newForm.Category" 
                                 SearchFunc="@SearchCategories"
                                 Placeholder="Select or type a new office..."
                                 Variant="Variant.Outlined" 
                                 Required="true"
                                 CoerceText="true" 
                                 CoerceValue="true"
                                 ResetValueOnEmptyText="false"
                                 AdornmentIcon="@Icons.Material.Filled.Business" 
                                 HelperText="New offices typed here will be saved to the database." />
            </MudItem>

            @* --- HYBRID DIGITAL ASSET SECTION --- *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Digital Template (Optional Upload or Link)</MudText>
                <MudPaper Variant="Variant.Outlined" Class="pa-4">
                    <MudStack Spacing="4">
                        <MudFileUpload T="IBrowserFile" 
                                       FilesChanged="OnFileSelected" 
                                       Accept=".pdf,.doc,.docx,.xls,.xlsx">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Info" 
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           FullWidth="true">
                                    @(_selectedFile == null ? "Upload Template (Word/Excel/PDF)" : _selectedFile.Name)
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (_selectedFile != null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" OnClose="@(() => _selectedFile = null)">
                                File Selected: @_selectedFile.Name (@(Math.Round(_selectedFile.Size / 1024.0 / 1024.0, 2)) MB)
                            </MudAlert>
                        }

                        <MudDivider />

                        <MudTextField @bind-Value="_newForm.PdfUrl"
                                      Label="Or Paste External URL"
                                      Placeholder="https://tsu.edu.ph/..."
                                      Variant="Variant.Outlined"
                                      Clearable="true"
                                      Disabled="@(_selectedFile != null)"
                                      HelperText="@(_selectedFile != null ? "File upload takes priority." : "Use this if the form is already hosted elsewhere.")" />
                    </MudStack>
                </MudPaper>

                @if (_isUploading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@_isUploading">
            @(_isUploading ? "Saving..." : "Save to Repository")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private FormTemplate _newForm = new();
    private IBrowserFile? _selectedFile;
    private bool _isUploading = false;
    private List<string> _existingCategories = new();

    protected override async Task OnInitializedAsync()
    {
        // Load distinct categories for the autocomplete search
        _existingCategories = await _context.FormTemplates
            .Where(f => !string.IsNullOrEmpty(f.Category))
            .Select(f => f.Category)
            .Distinct()
            .ToListAsync();
            
        if (!_existingCategories.Any())
        {
            _existingCategories.AddRange(new[] { "Registrar", "Admissions", "CCS", "Scholarship", "MIS" });
        }
    }

    // FIX: Added CancellationToken to match MudAutocomplete delegate requirement
    private async Task<IEnumerable<string>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _existingCategories;
        return _existingCategories.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        if (string.IsNullOrWhiteSpace(_newForm.FormName))
        {
            _newForm.FormName = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private async Task Save()
    {
        // Validation
        if (string.IsNullOrEmpty(_newForm.FormName) || string.IsNullOrEmpty(_newForm.Category))
        {
            Snackbar.Add("Please fill in Name and Category.", Severity.Error);
            return;
        }

        if (_selectedFile == null && string.IsNullOrEmpty(_newForm.PdfUrl))
        {
            Snackbar.Add("Please upload a file or provide a manual link.", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;
            StateHasChanged();

            var user = await _currentUserService.GetCurrentFullNameAsync();

            // 1. Handle Azure Blob Storage Upload
            if (_selectedFile != null)
            {
                string connectionString = _config.GetConnectionString("AzureStorage");
                var blobServiceClient = new BlobServiceClient(connectionString);
                var containerClient = blobServiceClient.GetBlobContainerClient("templates");
                
                await containerClient.CreateIfNotExistsAsync(PublicAccessType.Blob);

                string fileName = $"TEMPLATE_{Guid.NewGuid()}_{_selectedFile.Name}";
                var blobClient = containerClient.GetBlobClient(fileName);

                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
                
                var headers = new BlobHttpHeaders { 
                    ContentType = _selectedFile.ContentType, // Accurately set for Word/Excel/PDF
                    ContentDisposition = "inline" 
                };

                await blobClient.UploadAsync(stream, headers);
                _newForm.PdfUrl = blobClient.Uri.ToString();
            }

            // 2. Set Metadata
            _newForm.AddedBy = user;
            _newForm.DateAdded = DateTime.UtcNow.AddHours(8);

            // 3. Save Record to FormTemplates
            _context.FormTemplates.Add(_newForm);
            await _context.SaveChangesAsync();

            // 4. Save Detailed Audit Trail
            _context.AuditTrails.Add(new AuditTrails
            {
                FullName = user,
                Action = "Added",
                TableName = "FormTemplates",
                RecordId = _newForm.Id.ToString(),
                NewValues = JsonSerializer.Serialize(_newForm), // JSON Snapshot of the new record
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            
            Snackbar.Add("Form saved successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}