@page "/disposed"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Models
@using FileLocator.Models
@using MIS_FileLocator.Data
@using Microsoft.EntityFrameworkCore
@using System.Text

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Disposal Management</MudText>


<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-actions">
            @if (_activeTab == 0)
            {
                <MudIconButton Variant="Variant.Outlined" Color="Color.Success"
                               Icon="@Icons.Material.Filled.Print" OnClick="ExportPendingToCSV"
                               Disabled="@(!_pendingDisposal.Any())" />
                @if (_selectedItems.Any())
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="ProcessOfficialDisposal">
                        Dispose (@_selectedItems.Count)
                    </MudButton>
                }
            }
            else
            {
                <MudIconButton Variant="Variant.Outlined" Color="Color.Success"
                               Icon="@Icons.Material.Filled.Print" OnClick="ExportToCSV"
                               Disabled="@(!_disposedHistory.Any())" />
            }
        </div>
        <div class="toolbar-filters">
            @if (_activeTab == 0)
            {
                <MudDateRangePicker @bind-DateRange="_pendingDateRange" PlaceholderStart="From"
                                    PlaceholderEnd="To" Margin="Margin.Dense"
                                    Variant="Variant.Outlined" Clearable="true" />
                <MudTextField @bind-Value="_searchPending" Placeholder="Search Title/Location..."
                              Adornment="Adornment.Start" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            }
            else
            {
                <MudDateRangePicker @bind-DateRange="_historyDateRange" Margin="Margin.Dense"
                                    PlaceholderStart="From" PlaceholderEnd="To"
                                    Variant="Variant.Outlined" Clearable="true" />
                <MudTextField @bind-Value="_searchHistory" Placeholder="Search Title/Handler..."
                              Adornment="Adornment.Start" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            }
        </div>
    </div>
</MudPaper>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">


    <MudTabPanel Text="Pending Disposal" Icon="@Icons.Material.Filled.HourglassEmpty">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="mt-4">
            The following documents have reached or exceeded their retention period.
        </MudAlert>

        <MudDataGrid T="Documents"
                     Items="@_pendingDisposal"
                     MultiSelection="true"
                     @bind-SelectedItems="_selectedItems"
                     Hover="true"
                     Dense="true"
                     Filterable="false"
                     QuickFilter="@_pendingFilter">
            <Columns>
                <SelectColumn T="Documents" />
                <PropertyColumn Property="x => x.Title" Title="Document" />
                <PropertyColumn Property="x => x.DocumentDate" Title="Year" Format="MMM dd, yyyy" />
                <TemplateColumn Title="Scheduled Date">
                    <CellTemplate>
                        @context.Item.DateOfDisposal?.ToString("MMM dd, yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Location">
                    <CellTemplate>
                        <MudText Typo="Typo.caption">
                            @($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} > {context.Item.Folder?.FileBox?.Name} > {context.Item.Folder?.Name}")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

   
    <MudTabPanel Text="Disposal History" Icon="@Icons.Material.Filled.History">
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-3">
            Permanent record of documents physically destroyed or removed.
        </MudAlert>

        <MudDataGrid T="Documents" Items="@_disposedHistory" Hover="true" QuickFilter="@_historyFilter">
            <Columns>
                    <PropertyColumn Property="x => x.Title" Title="Document Title" />
                    <TemplateColumn Title="Date Disposed">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Color="Color.Error">
                                <b>@context.Item.DateOfDisposal?.ToString("MMM dd, yyyy")</b>
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.DocumentDate" Title="Year" Format="MMM dd, yyyy" />
                    <PropertyColumn Property="x => x.UpdatedBy" Title="Handled By" />
                    <TemplateColumn Title="Former Location">
                        <CellTemplate>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @($"{context.Item.Folder?.FileBox?.FillingCabinet?.Name} > {context.Item.Folder?.FileBox?.Name} > {context.Item.Folder?.Name}")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent><MudDataGridPager T="Documents" /></PagerContent>
            </MudDataGrid>
    </MudTabPanel>
</MudTabs>

@code {
    private List<Documents> _disposedHistory = new();
    private List<Documents> _pendingDisposal = new();
    private HashSet<Documents> _selectedItems = new();
    private int _activeTab = 0;

  
    private string _searchPending = "";
    private string _searchHistory = "";

    private DateRange _pendingDateRange = new DateRange(null, null);
    private DateRange _historyDateRange = new DateRange(null, null);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var _context = await DbFactory.CreateDbContextAsync();
        _pendingDisposal = await _context.Documents
            .Include(d => d.Folder).ThenInclude(f => f.FileBox).ThenInclude(b => b.FillingCabinet)
            .Where(d => !d.IsDisposal && !d.IsDeleted && d.DateOfDisposal <= DateTime.Now)
            .ToListAsync();

        _disposedHistory = await _context.Documents
            .Include(d => d.Folder).ThenInclude(f => f.FileBox).ThenInclude(b => b.FillingCabinet)
            .Where(d => d.IsDisposal && !d.IsDeleted)
            .OrderByDescending(d => d.DateOfDisposal)
            .ToListAsync();
    }

    private async Task LoadPendingDisposal()
    {
        using var _context = await DbFactory.CreateDbContextAsync();
        _pendingDisposal = await _context.Documents
            .Include(d => d.Folder).ThenInclude(f => f.FileBox).ThenInclude(b => b.FillingCabinet)
            .Where(d => !d.IsDisposal && !d.IsDeleted && d.DateOfDisposal <= DateTime.Now)
            .ToListAsync();
    }

   

    private Func<Documents, bool> _pendingFilter => x =>
    {
        if (!FilterByDateRange(x.DateOfDisposal, _pendingDateRange)) return false;
        if (string.IsNullOrWhiteSpace(_searchPending)) return true;
        if (x.Title.Contains(_searchPending, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Folder?.Name.Contains(_searchPending, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private Func<Documents, bool> _historyFilter => x =>
    {
        if (!FilterByDateRange(x.DateOfDisposal, _historyDateRange)) return false;
        if (string.IsNullOrWhiteSpace(_searchHistory)) return true;
        if (x.Title.Contains(_searchHistory, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.UpdatedBy?.Contains(_searchHistory, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private bool FilterByDateRange(DateTime? date, DateRange range)
    {
        if (range.Start == null && range.End == null) return true;
        if (date == null) return false;
        return date.Value.Date >= (range.Start?.Date ?? DateTime.MinValue) &&
               date.Value.Date <= (range.End?.Date ?? DateTime.MaxValue);
    }

    

    private async Task ProcessOfficialDisposal()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Official Disposal",
            $"Are you sure you want to officially dispose of {_selectedItems.Count} documents?",
            yesText: "Confirm Disposal",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            try
            {
                var user = await _currentUserService.GetCurrentFullNameAsync();
                var now = DateTime.UtcNow.AddHours(8);
                var selectedIds = _selectedItems.Select(d => d.Id).ToList();

                await using var db = await DbFactory.CreateDbContextAsync();
                db.CurrentUserOverride = user;

                // Re-fetch by ID in this context so EF tracks them properly
                var docsToDispose = await db.Documents
                    .Include(d => d.Folder).ThenInclude(f => f.FileBox).ThenInclude(b => b.FillingCabinet)
                    .Where(d => selectedIds.Contains(d.Id))
                    .ToListAsync();

                foreach (var doc in docsToDispose)
                {
                    doc.IsDisposal = true;
                    doc.DateOfDisposal = now;
                    doc.UpdatedBy = user;

                    db.TransactionLogs.Add(new TransactionLog
                    {
                        FullName = user,
                        EventName = "Document Disposed",
                        Description = $"Officially disposed '{doc.Title}' from {doc.Folder?.FileBox?.FillingCabinet?.Name} > {doc.Folder?.FileBox?.Name} > {doc.Folder?.Name}.",
                        Status = "Warning",
                        PerformedAt = now
                    });
                }

                await db.SaveChangesAsync();
                Snackbar.Add($"{docsToDispose.Count} documents disposed.", Severity.Success);
                _selectedItems.Clear();
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task ExportToCSV()
    {
        var csvBuilder = new StringBuilder();
        csvBuilder.AppendLine("Document Title,Year,Date Disposed,Handled By,Former Location");
        foreach (var doc in _disposedHistory)
        {
            var location = $"{doc.Folder?.FileBox?.FillingCabinet?.Name} > {doc.Folder?.FileBox?.Name} > {doc.Folder?.Name}";
            csvBuilder.AppendLine($"\"{doc.Title}\",{doc.DocumentDate},{doc.DateOfDisposal?.ToString("yyyy-MM-dd")},{doc.UpdatedBy},\"{location}\"");
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", $"Disposal_History_{DateTime.Now:yyyyMMdd}.csv", csvBuilder.ToString());
    }

    private async Task ExportPendingToCSV()
    {
        var csvBuilder = new StringBuilder();
        csvBuilder.AppendLine("Cabinet,Box,Folder,Document Title,Year,Scheduled Disposal Date");
        foreach (var doc in _pendingDisposal)
        {
            csvBuilder.AppendLine($"\"{doc.Folder?.FileBox?.FillingCabinet?.Name}\",\"{doc.Folder?.FileBox?.Name}\",\"{doc.Folder?.Name}\",\"{doc.Title}\",{doc.DocumentDate},{doc.DateOfDisposal?.ToString("yyyy-MM-dd")}");
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", $"Pending_Disposal_{DateTime.Now:yyyyMMdd}.csv", csvBuilder.ToString());
    }
}