@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@using Microsoft.EntityFrameworkCore
@using System.Threading
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject IConfiguration _config

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            @* --- Basic Info --- *@
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_newForm.FormName"
                              Label="Form Name (e.g., Adding/Changing Form)"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newForm.FormNumber"
                              Label="Form Number"
                              Placeholder="TSU-OAR-SF-22"
                              Variant="Variant.Outlined" />
            </MudItem>

            @* --- DYNAMIC CATEGORY (Type to Add New) --- *@
            <MudItem xs="12">
                <MudAutocomplete T="string" Label="Issuing Office / Category" 
                                 @bind-Value="_newForm.Category" 
                                 SearchFunc="@SearchCategories"
                                 Placeholder="Select an office or type a new one..."
                                 Variant="Variant.Outlined" 
                                 Required="true"
                                 CoerceText="true" 
                                 CoerceValue="true"
                                 ResetValueOnEmptyText="false"
                                 AdornmentIcon="@Icons.Material.Filled.Business" 
                                 HelperText="New offices typed here will be saved to the list automatically."/>
            </MudItem>

            @* --- HYBRID DIGITAL ASSET SECTION --- *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Digital Copy (Optional Upload or Link)</MudText>
                <MudPaper Variant="Variant.Outlined" Class="pa-4">
                    <MudStack Spacing="4">
                        @* Path 1: File Upload (Supports PDF and Office Files) *@
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.doc,.docx,.xls,.xlsx">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Info" 
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           FullWidth="true">
                                    @(_selectedFile == null ? "Upload File (PDF, Word, Excel)" : _selectedFile.Name)
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (_selectedFile != null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" OnClose="@(() => _selectedFile = null)">
                                Selected: @_selectedFile.Name (@(Math.Round(_selectedFile.Size / 1024.0 / 1024.0, 2)) MB)
                            </MudAlert>
                        }

                        <MudDivider />

                        @* Path 2: Manual Link *@
                        <MudTextField @bind-Value="_newForm.PdfUrl"
                                      Label="Or Paste Manual URL"
                                      Placeholder="https://tsu.edu.ph/..."
                                      Variant="Variant.Outlined"
                                      Clearable="true"
                                      Disabled="@(_selectedFile != null)"
                                      HelperText="@(_selectedFile != null ? "File upload will take priority." : "Use this if the form is already online.")" />
                    </MudStack>
                </MudPaper>

                @if (_isUploading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@_isUploading">
            @(_isUploading ? "Uploading..." : "Add to Repository")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private FormTemplate _newForm = new();
    private IBrowserFile? _selectedFile;
    private bool _isUploading = false;
    private List<string> _existingCategories = new();

    protected override async Task OnInitializedAsync()
    {
        var defaultCategories = new List<string> { "Registrar", "Admissions", "CCS", "Scholarship", "MIS" };

        var dbCategories = await _context.FormTemplates
            .Where(f => !string.IsNullOrEmpty(f.Category))
            .Select(f => f.Category)
            .Distinct()
            .ToListAsync();

        _existingCategories = defaultCategories
            .Union(dbCategories)
            .OrderBy(x => x)
            .ToList();
    }

    private async Task<IEnumerable<string>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _existingCategories;
        return _existingCategories.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        if (string.IsNullOrWhiteSpace(_newForm.FormName))
        {
            _newForm.FormName = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private async Task Save()
    {
        // 1. Validation
        if (string.IsNullOrEmpty(_newForm.FormName) || string.IsNullOrEmpty(_newForm.Category))
        {
            Snackbar.Add("Please fill in the Form Name and Office Category.", Severity.Error);
            return;
        }

       
        if (_selectedFile == null && string.IsNullOrEmpty(_newForm.PdfUrl))
        {
            Snackbar.Add("Please either upload a file or provide a manual link.", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;
            StateHasChanged();

            // 2. Handle Azure Upload
            if (_selectedFile != null)
            {
                string connectionString = _config.GetConnectionString("AzureStorage");
                var blobServiceClient = new BlobServiceClient(connectionString);
                var containerClient = blobServiceClient.GetBlobContainerClient("templates");
                
                await containerClient.CreateIfNotExistsAsync(PublicAccessType.Blob);

                // FIX: Sanitize filename to prevent BlobNotFound/404 errors
                string safeFileName = _selectedFile.Name.Replace(" ", "_");
                string fileName = $"TEMPLATE_{Guid.NewGuid()}_{safeFileName}";
                
                var blobClient = containerClient.GetBlobClient(fileName);

                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
                
                // FIX: Force Download Header to prevent XML tree errors
                var headers = new BlobHttpHeaders { 
                    ContentType = _selectedFile.ContentType,
                    ContentDisposition = $"attachment; filename=\"{_selectedFile.Name}\"" 
                };

                await blobClient.UploadAsync(stream, headers);
                _newForm.PdfUrl = blobClient.Uri.ToString();
            }

            var user = await _currentUserService.GetCurrentFullNameAsync();
            _newForm.AddedBy = user;
            _newForm.DateAdded = DateTime.UtcNow.AddHours(8);
            string source = _selectedFile != null ? "Uploaded File" : "Manual Link";
            
            _context.FormTemplates.Add(_newForm);

            _context.TransactionLogs.Add(new TransactionLog
            {
                FullName = user,
                EventName = "Form Created",
                Description = $"Added new form: '{_newForm.FormName}'. [No: {_newForm.FormNumber}, Category: {_newForm.Category}, Source: {source}]",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            
            Snackbar.Add("Form successfully added!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}