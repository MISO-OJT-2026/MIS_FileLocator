@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Threading
@using System.IO
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject MIS_FileLocator.Services.FileStorageService FileStorage

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
           
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_newForm.FormName"
                              Label="Form Name (e.g., Adding/Changing Form)"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newForm.FormNumber"
                              Label="Form Number"
                              Placeholder="TSU-OAR-SF-22"
                              Variant="Variant.Outlined" />
            </MudItem>

           
            <MudItem xs="12">
                <MudAutocomplete T="string" Label="Issuing Office / Category" 
                                 @bind-Value="_newForm.Category" 
                                 SearchFunc="@SearchCategories"
                                 Placeholder="Select an office or type a new one..."
                                 Variant="Variant.Outlined" 
                                 Required="true"
                                 CoerceText="true" 
                                 CoerceValue="true"
                                 ResetValueOnEmptyText="false"
                                 AdornmentIcon="@Icons.Material.Filled.Business" 
                                 HelperText="New offices typed here will be saved automatically."/>
            </MudItem>

            
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Digital Copy (Optional Upload or Link)</MudText>
                <MudPaper Variant="Variant.Outlined" Class="pa-4">
                    <MudStack Spacing="3">
                        
                        @if (_selectedFile != null)
                        {
                            
                            <MudPaper Elevation="2" Class="pa-3 rounded-lg d-flex align-center gap-4 w-100" Style="max-width: 100%; border-left: 6px solid; border-color: var(--file-color, #9e9e9e);">
                                <MudIcon Icon="@_fileIcon" Color="@_fileColor" Size="Size.Large" />
                                <div class="flex-grow-1 overflow-hidden">
                                    <MudText Typo="Typo.subtitle2" Class="text-truncate">@_selectedFile.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@((_selectedFile.Size / 1024.0 / 1024.0).ToString("0.00")) MB</MudText>
                                </div>
                                
                                <MudStack Row="true" Spacing="1">
                                    @if (_canPreview)
                                    {
                                        <MudTooltip Text="@(_showPreview ? "Hide Preview" : "Show Preview")">
                                            <MudIconButton Icon="@(_showPreview ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" 
                                                           Color="Color.Primary" Size="Size.Small" OnClick="TogglePreview" />
                                        </MudTooltip>
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="ClearFile" />
                                </MudStack>
                            </MudPaper>

                           
                            @if (_showPreview && !string.IsNullOrEmpty(_previewUrl))
                            {
                                <MudPaper Outlined="true" Class="w-100 mt-2 rounded-lg overflow-hidden shadow-inner" Style="height: 400px; background: white;">
                                    <iframe src="@_previewUrl" style="width:100%; height:100%; border:none;"></iframe>
                                </MudPaper>
                            }
                        }

                        
                        <MudFileUpload T="IBrowserFile" @ref="_fileUpload" FilesChanged="OnFileSelected" Accept=".pdf,.doc,.docx,.xls,.xlsx">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Info" 
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           FullWidth="true">
                                    @(_selectedFile == null ? "Upload File (PDF, Word, Excel)" : "Replace Selected File")
                                </MudButton>
                            </ActivatorContent>
                            

                        </MudFileUpload>

                        <MudDivider />

                        
                        <MudTextField @bind-Value="_newForm.PdfUrl"
                                      Label="Or Paste Manual URL"
                                      Placeholder="https://tsu.edu.ph/..."
                                      Variant="Variant.Outlined"
                                      Clearable="true"
                                      Disabled="@(_selectedFile != null)"
                                      HelperText="@(_selectedFile != null ? "File upload will take priority." : "Use this if the form is already online.")" />
                    </MudStack>
                </MudPaper>

                @if (_isUploading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@_isUploading">
            @(_isUploading ? "Uploading..." : "Add to Repository")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private FormTemplate _newForm = new();
    private IBrowserFile? _selectedFile;
    private MudFileUpload<IBrowserFile>? _fileUpload;
    
    private string? _previewUrl;
    private bool _showPreview = false;
    private bool _canPreview = false;
    private string _fileIcon = Icons.Material.Filled.InsertDriveFile;
    private Color _fileColor = Color.Default;

    private bool _isUploading = false;
    private List<string> _existingCategories = new();

    protected override async Task OnInitializedAsync()
    {
        var defaultCategories = new List<string> { "MISO" };
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbCategories = await db.FormTemplates
            .Where(f => !string.IsNullOrEmpty(f.Category))
            .Select(f => f.Category)
            .Distinct()
            .ToListAsync();

        _existingCategories = defaultCategories.Union(dbCategories).OrderBy(x => x).ToList();
    }

    private async Task<IEnumerable<string>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _existingCategories;
        return _existingCategories.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file == null) { 

            ClearFile(); return; 
        
        }

        _selectedFile = file;
        _previewUrl = null;
        _showPreview = false;

        
        if (string.IsNullOrWhiteSpace(_newForm.FormName))
            _newForm.FormName = Path.GetFileNameWithoutExtension(file.Name);

       
        string ext = Path.GetExtension(file.Name).ToLower();
        _canPreview = (ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png");

        switch (ext)
        {
            case ".pdf": _fileIcon = Icons.Material.Filled.PictureAsPdf; _fileColor = Color.Error; break;
            case ".doc": case ".docx": _fileIcon = Icons.Material.Filled.Description; _fileColor = Color.Info; break;
            case ".xls": case ".xlsx": _fileIcon = Icons.Custom.FileFormats.FileExcel; _fileColor = Color.Success; break;
            default: _fileIcon = Icons.Material.Filled.InsertDriveFile; _fileColor = Color.Default; break;
        }

        StateHasChanged();
    }

    private async Task TogglePreview()
    {
        _showPreview = !_showPreview;
        
        if (_showPreview && _selectedFile != null && string.IsNullOrEmpty(_previewUrl))
        {
            try 
            {
                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                _previewUrl = $"data:{_selectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            } 
            catch { _showPreview = false; Snackbar.Add("Preview generation failed.", Severity.Warning); }
        }
        StateHasChanged();
    }

    private async Task ClearFile()
    {
        _selectedFile = null;
        _previewUrl = null;
        _showPreview = false;
        _newForm.FormName = _newForm.FormName; // keep form data
        _fileIcon = Icons.Material.Filled.InsertDriveFile;
        _fileColor = Color.Default;
        if (_fileUpload != null)
            await _fileUpload.ResetAsync();
        StateHasChanged();
    }

    private async Task Save()
    {
        if (string.IsNullOrEmpty(_newForm.FormName) || string.IsNullOrEmpty(_newForm.Category))
        {
            Snackbar.Add("Please fill in the Form Name and Office Category.", Severity.Error);
            return;
        }

        if (_selectedFile == null && string.IsNullOrEmpty(_newForm.PdfUrl))
        {
            Snackbar.Add("Please either upload a file or provide a manual link.", Severity.Warning);
            return;
        }

        try
        {
            _isUploading = true;
            StateHasChanged();

            if (_selectedFile != null)
            {
                _newForm.PdfUrl = await FileStorage.SaveFileAsync(_selectedFile, "templates");
            }

            var user = await _currentUserService.GetCurrentFullNameAsync();
            _newForm.AddedBy = user;
            _newForm.DateAdded = DateTime.UtcNow.AddHours(8);
            string source = _selectedFile != null ? "Uploaded File" : "Manual Link";
            
            await using var db = await DbFactory.CreateDbContextAsync();
            db.FormTemplates.Add(_newForm);

            db.TransactionLogs.Add(new TransactionLog
            {
                FullName = user,
                EventName = "Form Created",
                Description = $"Added new form: '{_newForm.FormName}'. [No: {_newForm.FormNumber}, Category: {_newForm.Category}, Source: {source}]",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            db.CurrentUserOverride = user;
            await db.SaveChangesAsync();
            
            Snackbar.Add("Form successfully added!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error: " + ex.Message, Severity.Error);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}