@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_newForm.FormName"
                              Label="Form Name (e.g., Adding/Changing Form)"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_newForm.FormNumber"
                              Label="Form Number"
                              Placeholder="TSU-OAR-SF-22"
                              Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="string" Label="Issuing Office/Category"
                           @bind-Value="_newForm.Category"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem Value="@("Registrar")">Office of the Registrar</MudSelectItem>
                    <MudSelectItem Value="@("Admissions")">Admissions</MudSelectItem>
                    <MudSelectItem Value="@("CCS")">College of Computer Studies</MudSelectItem>
                    <MudSelectItem Value="@("Scholarship")">Scholarship Office</MudSelectItem>
                    <MudSelectItem Value="@("MIS")">MIS Office</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_newForm.PdfUrl"
                              Label="PDF Link / URL"
                              HelperText="Paste the tsu.edu.ph link here"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Add to Repository</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private FormTemplate _newForm = new();

    private async Task Save()
    {
        if (string.IsNullOrEmpty(_newForm.FormName) || string.IsNullOrEmpty(_newForm.PdfUrl))
        {
            Snackbar.Add("Please fill in the Name and Link.", Severity.Warning);
            return;
        }

        var user = await _currentUserService.GetCurrentFullNameAsync();
        _newForm.AddedBy = user;

        _context.FormTemplates.Add(_newForm);

        // TRANSACTION LOG
        _context.TransactionLogs.Add(new TransactionLog
        {
            FullName = user,
            EventName = "Repository Updated",
            Description = $"Added new university form: {_newForm.FormName} ({_newForm.FormNumber})",
            Status = "Success",
            PerformedAt = DateTime.UtcNow.AddHours(8)
        });

        await _context.SaveChangesAsync();
        Snackbar.Add("Form added to repository!", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
    private void Cancel() => MudDialog.Cancel();
}