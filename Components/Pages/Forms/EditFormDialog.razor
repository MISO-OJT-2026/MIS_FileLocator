@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudTextField @bind-Value="_editForm.FormName" Label="Form Name" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_editForm.FormNumber" Label="Form Number" Variant="Variant.Outlined" />

            <MudSelect T="string" Label="Category" @bind-Value="_editForm.Category" Variant="Variant.Outlined">
                <MudSelectItem Value="@("Registrar")">Registrar</MudSelectItem>
                <MudSelectItem Value="@("Admissions")">Admissions</MudSelectItem>
                <MudSelectItem Value="@("CCS")">CCS</MudSelectItem>
                <MudSelectItem Value="@("Scholarship")">Scholarship</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_editForm.PdfUrl" Label="PDF Link" Variant="Variant.Outlined" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Update Form</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public FormTemplate FormToEdit { get; set; } = new();

    private FormTemplate _editForm = new();

    protected override void OnInitialized()
    {
        // Clone the data to prevent live-editing the list
        _editForm.Id = FormToEdit.Id;
        _editForm.FormName = FormToEdit.FormName;
        _editForm.FormNumber = FormToEdit.FormNumber;
        _editForm.Category = FormToEdit.Category;
        _editForm.PdfUrl = FormToEdit.PdfUrl;
    }

    private async Task Save()
    {
        var dbEntry = await _context.FormTemplates.FindAsync(_editForm.Id);
        if (dbEntry != null)
        {
            dbEntry.FormName = _editForm.FormName;
            dbEntry.FormNumber = _editForm.FormNumber;
            dbEntry.Category = _editForm.Category;
            dbEntry.PdfUrl = _editForm.PdfUrl;

            var user = await _currentUserService.GetCurrentFullNameAsync();

            _context.TransactionLogs.Add(new TransactionLog
            {
                FullName = user,
                EventName = "Repository Updated",
                Description = $"Updated info for form: {dbEntry.FormName}",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            Snackbar.Add("Form updated!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
    private void Cancel() => MudDialog.Cancel();
}