@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@using Microsoft.EntityFrameworkCore
@using System.Threading
@using System.IO
@using System.Text.RegularExpressions
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject IConfiguration _config
@inject IDialogService DialogService
@inject IJSRuntime JS

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudGrid Spacing="3">
            @* --- Form Identification --- *@
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_editForm.FormName" 
                              Label="Form Name" 
                              Variant="Variant.Outlined" 
                              Required="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_editForm.FormNumber" 
                              Label="Form Number" 
                              Placeholder="TSU-OAR-SF-22"
                              Variant="Variant.Outlined" />
            </MudItem>

            @* --- Responsive Category (Dynamic) --- *@
            <MudItem xs="12">
                <MudAutocomplete T="string" Label="Issuing Office / Category" 
                                 @bind-Value="_editForm.Category" 
                                 SearchFunc="@SearchCategories"
                                 Placeholder="Select or type a new office..."
                                 Variant="Variant.Outlined" 
                                 Required="true"
                                 CoerceText="true" 
                                 CoerceValue="true"
                                 AdornmentIcon="@Icons.Material.Filled.Business" />
            </MudItem>

            @* --- Digital Asset Section with Integrated Preview --- *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Digital Template Management</MudText>
                <MudPaper Variant="Variant.Outlined" Class="pa-4">
                    <MudStack Spacing="3">
                        
                        @* 1. Display Current File / Preview Toggle *@
                        @if (!string.IsNullOrEmpty(_editForm.PdfUrl))
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" NoIcon="false" Class="py-1">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                                    <MudText>
                                        Current: <b>@Path.GetFileName(new Uri(_editForm.PdfUrl).LocalPath).Split('_').Last()</b>
                                    </MudText>
                                    <MudStack Row="true" Spacing="1">
                                        @if (_canPreview)
                                        {
                                            <MudIconButton Icon="@(_showPreview ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" 
                                                           Color="Color.Inherit" OnClick="TogglePreview" Title="Toggle Preview" />
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                       Color="Color.Error" 
                                                       OnClick="RemoveDigitalFile" 
                                                       Title="Delete file from cloud" />
                                    </MudStack>
                                </MudStack>
                            </MudAlert>
                        }  
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">No digital template attached.</MudAlert>
                        }

                        @* INTERNAL IFRAME PREVIEW AREA *@
                        @if (_showPreview && !string.IsNullOrEmpty(_previewUrl))
                        {
                            <MudPaper Outlined="true" Class="w-100 rounded-lg overflow-hidden border-2" Style="height: 450px; background: white; border-color: var(--mud-palette-primary);">
                                <iframe src="@_previewUrl" style="width:100%; height:100%; border:none;"></iframe>
                            </MudPaper>
                        }

                        <MudDivider Class="my-2" />

                        @* 2. Replace/Upload New File *@
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf,.doc,.docx,.xls,.xlsx">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    @(_selectedFile == null ? "REPLACE / UPLOAD NEW FILE" : _selectedFile.Name)
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (_selectedFile != null)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" OnClose="ClearSelectedFile">
                                New Selection: @_selectedFile.Name (@(Math.Round(_selectedFile.Size / 1024.0 / 1024.0, 2)) MB)
                            </MudAlert>
                        }

                        @* 3. Edit/Provide Link *@
                        <MudTextField @bind-Value="_editForm.PdfUrl" 
                                      Label="Direct URL / Manual Link" 
                                      Variant="Variant.Outlined" 
                                      Placeholder="https://tsu.edu.ph/..."
                                      Disabled="@(_selectedFile != null)"
                                      HelperText="@(_selectedFile != null ? "New file upload will overwrite this link." : "Edit the cloud storage path directly.")" />
                    </MudStack>
                </MudPaper>

                @if (_isUploading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="DeleteForm" Class="mr-auto">Delete Record</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@_isUploading">
            @(_isUploading ? "Updating..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public FormTemplate FormToEdit { get; set; } = new();

    private FormTemplate _editForm = new();
    private IBrowserFile? _selectedFile;
    private string? _previewUrl;
    private bool _showPreview = false;
    private bool _canPreview = false;
    private bool _isUploading = false;
    private List<string> _existingCategories = new();

    protected override async Task OnInitializedAsync()
    {
        var defaults = new List<string> { "Registrar", "Admissions", "CCS", "Scholarship", "MIS" };
        var dbCats = await _context.FormTemplates
            .Where(f => !string.IsNullOrEmpty(f.Category))
            .Select(f => f.Category)
            .Distinct()
            .ToListAsync();

        _existingCategories = defaults.Union(dbCats).OrderBy(x => x).ToList();

        // Clone current data
        _editForm.Id = FormToEdit.Id;
        _editForm.FormName = FormToEdit.FormName;
        _editForm.FormNumber = FormToEdit.FormNumber;
        _editForm.Category = FormToEdit.Category;
        _editForm.PdfUrl = FormToEdit.PdfUrl;

        CheckIfPreviewable(_editForm.PdfUrl);
    }

    private void CheckIfPreviewable(string? url)
    {
        if (string.IsNullOrEmpty(url)) { _canPreview = false; return; }
        string ext = Path.GetExtension(url).ToLower();
        _canPreview = (ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png");
    }

    private async Task<IEnumerable<string>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _existingCategories;
        return _existingCategories.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file == null) return;
        _selectedFile = file;
        _previewUrl = null;
        _showPreview = false;
        CheckIfPreviewable(file.Name);
        StateHasChanged();
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
        _previewUrl = null;
        _showPreview = false;
        CheckIfPreviewable(_editForm.PdfUrl);
    }

    private async Task TogglePreview()
    {
        _showPreview = !_showPreview;

        if (_showPreview && string.IsNullOrEmpty(_previewUrl))
        {
            try 
            {
                if (_selectedFile != null)
                {
                    // Generate local preview for newly selected file
                    using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    _previewUrl = $"data:{_selectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                }
                else if (!string.IsNullOrEmpty(_editForm.PdfUrl))
                {
                    // Use existing Azure URL
                    _previewUrl = _editForm.PdfUrl;
                }
            }
            catch { _showPreview = false; Snackbar.Add("Preview failed.", Severity.Warning); }
        }
        StateHasChanged();
    }

    private async Task RemoveDigitalFile()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Remove File", "Permanently delete the file from cloud storage?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                if (!string.IsNullOrEmpty(_editForm.PdfUrl) && _editForm.PdfUrl.Contains("blob.core.windows.net"))
                {
                    string conn = _config.GetConnectionString("AzureStorage");
                    var client = new BlobServiceClient(conn).GetBlobContainerClient("templates");
                    string blobName = Path.GetFileName(new Uri(_editForm.PdfUrl).LocalPath);
                    await client.GetBlobClient(blobName).DeleteIfExistsAsync();
                }
                _editForm.PdfUrl = "";
                _previewUrl = null;
                _showPreview = false;
                _canPreview = false;
                Snackbar.Add("File removed.", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        }
    }

    private async Task Save()
    {
        try
        {
            _isUploading = true;
            var dbEntry = await _context.FormTemplates.FindAsync(_editForm.Id);
            if (dbEntry == null) return;

            List<string> changes = new();
            if (dbEntry.FormName != _editForm.FormName) changes.Add("Name Updated");
            if (dbEntry.Category != _editForm.Category) changes.Add("Category Updated");

            if (_selectedFile != null)
            {
                string conn = _config.GetConnectionString("AzureStorage");
                var container = new BlobServiceClient(conn).GetBlobContainerClient("templates");
                await container.CreateIfNotExistsAsync(PublicAccessType.Blob);

                // SANITIZATION: Replace spaces with underscores for Azure compatibility
                string safeName = Regex.Replace(_selectedFile.Name, @"\s+", "_");
                string fileName = $"TEMPLATE_UPD_{Guid.NewGuid()}_{safeName}";
                var blob = container.GetBlobClient(fileName);

                using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
                
                // FORCE DOWNLOAD HEADERS
                await blob.UploadAsync(stream, new BlobHttpHeaders { 
                    ContentType = _selectedFile.ContentType,
                    ContentDisposition = $"attachment; filename=\"{_selectedFile.Name}\"" 
                });

                _editForm.PdfUrl = blob.Uri.ToString();
                changes.Add("Replaced Digital File");
            }

            dbEntry.FormName = _editForm.FormName;
            dbEntry.FormNumber = _editForm.FormNumber;
            dbEntry.Category = _editForm.Category;
            dbEntry.PdfUrl = _editForm.PdfUrl;

            var user = await _currentUserService.GetCurrentFullNameAsync();
            _context.TransactionLogs.Add(new TransactionLog {
                FullName = user, EventName = "Form Updated",
                Description = $"Edited '{dbEntry.FormName}': {string.Join(", ", changes)}",
                Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
            });

            await _context.SaveChangesAsync();
            Snackbar.Add("Updated successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        finally { _isUploading = false; }
    }

    private async Task DeleteForm()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Confirm Delete", "Permanently remove this form template?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            var doc = await _context.FormTemplates.FindAsync(_editForm.Id);
            if (doc != null) {
                _context.FormTemplates.Remove(doc);
                await _context.SaveChangesAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}