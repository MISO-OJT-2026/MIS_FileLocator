@page "/forms"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using FileLocator.Models
@using FileLocator.Services
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore


@inject NavigationManager Nav
@inject ApplicationDbContext _context
@inject IDialogService DialogService
@inject IJSRuntime jSRunTime 
@inject ICurrentUserService _currentUserService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    @* --- Header Section --- *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h4">University Forms Repository</MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenAddDialog"
                   Size="Size.Large">
            Add New For
        </MudButton>
    </MudStack>

    @* --- Filter & Search Section --- *@
    <MudPaper Elevation="3" Class="pa-6 mb-6">
        <MudGrid Spacing="3" AlignItems="AlignItems.Center">
            @* Search by Name or Number *@
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_searchString" 
                              Label="Search Forms"
                              Placeholder="Type form name or TSU number..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              IconSize="Size.Medium" 
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true" />
            </MudItem>

            @* Filter by Office/Category *@
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="Issuing Office" 
                           @bind-Value="_selectedCategory" 
                           AnchorOrigin="Origin.BottomCenter"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@((string)null)">All Offices</MudSelectItem>
                    @foreach (var cat in _categories)
                    {
                        <MudSelectItem Value="@cat">@cat</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* Filter Actions *@
            <MudItem xs="12" md="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                  
                    @if (!string.IsNullOrWhiteSpace(_searchString) || !string.IsNullOrEmpty(_selectedCategory))
                    {
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Error" 
                                   OnClick="ResetFilters" 
                                   StartIcon="@Icons.Material.Filled.FilterAltOff">
                            Reset
                        </MudButton>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* --- Repository Table --- *@
    <MudTable Items="@FilteredForms" 
              Hover="true" 
              Breakpoint="Breakpoint.Sm" 
              Loading="@_loading" 
              LoadingProgressColor="Color.Info"
              Elevation="3"
              Class="rounded-lg"
              Dense="true">
        <HeaderContent>
            <MudTh Style="font-weight: bold;">Form Details</MudTh>
            <MudTh Style="font-weight: bold;">Form Number</MudTh>
            <MudTh Style="font-weight: bold;">Office / Category</MudTh>
            <MudTh Style="font-weight: bold;">Added By</MudTh>
            <MudTh Style="font-weight: bold; text-align: center;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Form Name">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body1" >@context.FormName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Added: @context.DateAdded.ToString("MMM dd, yyyy")</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Form Number">
                <MudText Typo="Typo.body2" Class="font-monospace">@(string.IsNullOrEmpty(context.FormNumber) ? "---" : context.FormNumber)</MudText>
            </MudTd>
            <MudTd DataLabel="Category">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Label="true">@context.Category</MudChip>
            </MudTd>
            <MudTd DataLabel="Added By">@context.AddedBy</MudTd>
            <MudTd DataLabel="Action" Style="text-align: center;">
                <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                    <MudTooltip Text="View/Download PDF">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Color="Color.Primary" 
                                       Href="@context.PdfUrl" 
                                       Target="_blank" />
                    </MudTooltip>
                    <MudTooltip Text="Edit Metadata">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Default" 
                                       Size="Size.Small" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="ma-4">
                No forms match the current search or filter criteria.
            </MudAlert>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<FormTemplate> _allForms = new();
    private List<string> _categories = new();
    private string _searchString = "";
    private string _selectedCategory = null;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _allForms = await _context.FormTemplates
                .Where(f => !f.IsArchived)
                .OrderByDescending(f => f.DateAdded)
                .ToListAsync();

            // Populate the filter dropdown from actual database values
            _categories = _allForms
                .Select(f => f.Category)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading repository: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Logic for filtering the list in memory for better performance
    private IEnumerable<FormTemplate> FilteredForms => _allForms
        .Where(f => 
            (string.IsNullOrWhiteSpace(_searchString) || 
             f.FormName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || 
             f.FormNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_selectedCategory) || f.Category == _selectedCategory)
        );

    private void ResetFilters()
    {
        _searchString = "";
        _selectedCategory = null;
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddFormDialog>("Add New University Form", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData(); // Refresh the list and filters after adding a new entry
        }
    }
}