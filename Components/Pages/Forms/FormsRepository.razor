@page "/forms"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using FileLocator.Models
@using FileLocator.Services
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using static MudBlazor.CategoryTypes

@inject NavigationManager Nav
@inject ApplicationDbContext _context
@inject IDialogService DialogService
@inject IJSRuntime jSRunTime 
@inject ICurrentUserService _currentUserService
@inject ISnackbar Snackbar


    
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h4" Color="Color.Primary">University Forms Repository</MudText>
        
    </MudStack>

    
<MudPaper Elevation="3" Class="pa-2 mb-3">
   
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">

       
        <MudItem>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Medium"
                       OnClick="OpenAddDialog"
                       Style="height: 40px; text-transform: none;">
                
                Add New Form
            </MudButton>
        </MudItem>

        <MudSpacer />

    
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_searchString"
                          PlaceHolder="Search Forms"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Style="height: 40px;" /> 
        </MudItem>

      
        <MudItem xs="12" md="3">
            <MudSelect T="string" 
                       @bind-Value="_selectedCategory"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Style="height: 40px;">
              
                <MudSelectItem Value="@((string)null)">All Offices</MudSelectItem>
                @foreach (var cat in _categories)
                {
                    <MudSelectItem Value="@cat">@cat</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

            
        </MudGrid>
    </MudPaper>

   
    <MudTable Items="@FilteredForms" 
              Hover="true" 
              Breakpoint="Breakpoint.Sm" 
              Loading="@_loading" 
              LoadingProgressColor="Color.Info"
              Elevation="3"
              Class="rounded-lg"
              Dense="true">
        <HeaderContent>
            <MudTh>Form Details</MudTh>
            <MudTh>Form Number</MudTh>
            <MudTh>Office / Category</MudTh>
            <MudTh>Added By</MudTh>
            <MudTh Style="text-align: center;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Form Name">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body1" >@context.FormName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Added: @context.DateAdded.ToString("MMM dd, yyyy")</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Form Number">
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(context.FormNumber) ? "---" : context.FormNumber)</MudText>
            </MudTd>
            <MudTd DataLabel="Category">
                <MudChip T="string" Color="Color.Info"  Size="Size.Small" Variant="Variant.Text" Label="true">@context.Category</MudChip>
            </MudTd> 
            <MudTd DataLabel="Added By">@context.AddedBy</MudTd>
            <MudTd DataLabel="Action" Style="text-align: center;">
                <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                    <MudTooltip Text="View/Download PDF">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" 
                                       Color="Color.Primary" 
                                       Href="@context.PdfUrl" 
                                       Target="_blank" 
                                       Size="Size.Small"/>
                    </MudTooltip>
                    <MudTooltip Text="Edit Form">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Warning" 
                                        Size="Size.Small"
                                        OnClick="@(() =>OpenEditDialog(context) )"/>
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="ma-4">
                No forms match the current search or filter criteria.
            </MudAlert>
        </NoRecordsContent>
    </MudTable>


@code {
    private List<FormTemplate> _allForms = new();
    private List<string> _categories = new();
    private string _searchString = "";
    private string _selectedCategory = null;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _allForms = await _context.FormTemplates
                .Where(f => !f.IsArchived)
                .OrderByDescending(f => f.DateAdded)
                .ToListAsync();

            
            _categories = _allForms
                .Select(f => f.Category)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading repository: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    
    private IEnumerable<FormTemplate> FilteredForms => _allForms
        .Where(f => 
            (string.IsNullOrWhiteSpace(_searchString) || 
             f.FormName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || 
             f.FormNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_selectedCategory) || f.Category == _selectedCategory)
        );

    //OPEN EDIT DIALOG

    private async Task OpenEditDialog(FormTemplate form)
    {
        
        var parameters = new DialogParameters<EditFormDialog>();
        parameters.Add(x => x.FormToEdit, form);

        
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        
        var dialog = await DialogService.ShowAsync<EditFormDialog>("Edit Form Information", parameters, options);

       
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadData();
        }
    }


    private void ResetFilters()
    {
        _searchString = "";
        _selectedCategory = null;
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddFormDialog>("Add New University Form", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData(); 
        }
    }
}