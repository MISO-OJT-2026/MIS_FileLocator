@page "/qr/box/{BoxId:int}"
@layout QrSimpleLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using FileLocator.Models
@using MIS_FileLocator.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

<MudText Typo="Typo.h4" Class="mt-10 mb-2" Color="Color.Primary">Filing box</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else if (_box == null)
{
    <MudAlert Severity="Severity.Warning">This box was not found or is archived.</MudAlert>
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mb-1"><b>@_box.Name</b></MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@_locationPath</MudText>

    <MudText Typo="Typo.subtitle2" Class="mb-2">Folders in this box</MudText>
    @if (_folders.Count == 0)
    {
        <MudText Typo="Typo.body2"  Class="mud-text-secondary">No folders in this box.</MudText>
    }
    else
    {
        <MudStack Spacing="2" Class="mb-6">
            @foreach (var f in _folders)
            {
                <MudPaper Outlined="true" Class="pa-3" Style="color:#1a3a52;">
                    <MudLink Href="@($"/qr/folder/{f.Id}")" Typo="Typo.body1" Style="font-weight: 600;">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1" />@f.Name
                    </MudLink>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_docsInFolder.GetValueOrDefault(f.Id, 0) document(s)</MudText>
                </MudPaper>
            }
        </MudStack>
    }

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle2" Class="mb-2">All documents in this box</MudText>
    @if (_documents.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No active documents.</MudText>
    }
    else
    {
        <MudTable Items="@_documents" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Folder</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Folder">@context.Folder?.Name</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsBorrowed)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">Borrowed</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">In</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public int BoxId { get; set; }

    private FileBoxes? _box;
    private List<Folder> _folders = new();
    private List<Documents> _documents = new();
    private Dictionary<int, int> _docsInFolder = new();
    private string _locationPath = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _box = await _context.FileBoxes
            .AsNoTracking()
            .Include(b => b.FillingCabinet)
            .FirstOrDefaultAsync(b => b.Id == BoxId);

        if (_box == null)
        {
            _loading = false;
            return;
        }

        if (_box.IsArchived)
        {
            _box = null;
            _loading = false;
            return;
        }

        _locationPath = $"{_box.FillingCabinet?.Name ?? "Cabinet"} › {_box.Name}";

        _folders = await _context.Folders.AsNoTracking()
            .Where(f => f.FileBoxId == BoxId && !f.IsArchived)
            .OrderBy(f => f.Name)
            .ToListAsync();

        var folderIds = _folders.Select(f => f.Id).ToList();
        var docs = await _context.Documents.AsNoTracking()
            .Include(d => d.Folder)
            .Where(d => folderIds.Contains(d.FolderId) && !d.IsDeleted && !d.IsDisposal)
            .OrderBy(d => d.Title)
            .ToListAsync();

        _documents = docs;
        _docsInFolder = docs.GroupBy(d => d.FolderId).ToDictionary(g => g.Key, g => g.Count());

        _loading = false;
    }
}
