@page "/qr/folder/{FolderId:int}"
@layout QrSimpleLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject IDialogService DialogService
@inject IRoleService RoleService
@inject AuthenticationStateProvider AuthStateProvider

@if (_loading)
{
    <MudPaper Class="pa-8" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1">Loading folder information...</MudText>
        </MudStack>
    </MudPaper>
}
else if (_folder == null)
{
    <MudPaper Class="pa-6" Elevation="2">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            <MudText Typo="Typo.h6">Folder Not Found</MudText>
            <MudText Typo="Typo.body2">This folder was not found or has been archived.</MudText>
        </MudAlert>
    </MudPaper>
}
else
{
    @* Header Card *@
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 600;">@_folder.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                        @_locationPath
                    </MudText>
                </div>
            </MudStack>
            
            @if (!string.IsNullOrEmpty(_folder.Description))
            {
                <MudText Typo="Typo.body2" Class="mt-2">@_folder.Description</MudText>
            }
        </MudStack>
    </MudPaper>

    @* Documents Section *@
    <MudPaper Class="pa-6" Elevation="2">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                    Documents in this Folder
                </MudText>
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@_documents.Count document(s)</MudChip>
            </MudStack>

            @if (_documents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No active documents in this folder.</MudAlert>
            }
            else
            {
                <MudTable Items="@_documents" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Class="mt-2">
                    <HeaderContent>
                        <MudTh Style="font-weight: 600;">Title</MudTh>
                        <MudTh Style="font-weight: 600; text-align: center;">Status</MudTh>
                        <MudTh Style="font-weight: 600; text-align: center; width: 180px;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Title">
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Title</MudText>
                            @if (!string.IsNullOrEmpty(context.Description))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Status" Style="text-align: center;">
                            @if (context.IsBorrowed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Outbound">Borrowed</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Available</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: center;">
                            <AuthorizeView Context="authContext">
                                <Authorized>
                                    @if (_canBorrow && !context.IsBorrowed && !context.IsDeleted && !context.IsDisposal)
                                    {
                                        <MudButton Size="Size.Small" 
                                                   Variant="Variant.Filled" 
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.LibraryAdd"
                                                   OnClick="@(() => QuickBorrow(context))">
                                            Quick Borrow
                                        </MudButton>
                                    }
                                    else if (context.IsBorrowed)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Not Available</MudText>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    <MudButton Size="Size.Small" 
                                               Variant="Variant.Outlined" 
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Login"
                                               Href="@GetLoginHref()">
                                        Sign In to Borrow
                                    </MudButton>
                                </NotAuthorized>
                            </AuthorizeView>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public int FolderId { get; set; }

    private Folder? _folder;
    private List<Documents> _documents = new();
    private string _locationPath = "";
    private bool _loading = true;
    private bool _canBorrow;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var role = auth.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        _canBorrow = RoleService.CanAddEditDocuments(role);

        _folder = await _context.Folders
            .AsNoTracking()
            .Include(f => f.FileBox)!.ThenInclude(b => b!.FillingCabinet)
            .FirstOrDefaultAsync(f => f.Id == FolderId);

        if (_folder == null)
        {
            _loading = false;
            return;
        }

        if (_folder.IsArchived)
        {
            _folder = null;
            _loading = false;
            return;
        }

        var box = _folder.FileBox;
        _locationPath = $"{box?.FillingCabinet?.Name ?? "Cabinet"} › {box?.Name ?? "Box"} › {_folder.Name}";

        _documents = await _context.Documents.AsNoTracking()
            .Where(d => d.FolderId == FolderId && !d.IsDeleted && !d.IsDisposal)
            .OrderBy(d => d.Title)
            .ToListAsync();

        _loading = false;
    }

    private string GetLoginHref()
    {
        var returnUrl = Uri.EscapeDataString($"/qr/folder/{FolderId}");
        return $"/Account/Login?ReturnUrl={returnUrl}";
    }

    private async Task QuickBorrow(Documents doc)
    {
        var parameters = new DialogParameters<QuickBorrowDialog>
        {
            { x => x.DocumentId, doc.Id },
            { x => x.DocumentTitle, doc.Title }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<QuickBorrowDialog>("Quick Borrow Document", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await ReloadDocs();
    }

    private async Task ReloadDocs()
    {
        _documents = await _context.Documents.AsNoTracking()
            .Where(d => d.FolderId == FolderId && !d.IsDeleted && !d.IsDisposal)
            .OrderBy(d => d.Title)
            .ToListAsync();
        StateHasChanged();
    }
}
