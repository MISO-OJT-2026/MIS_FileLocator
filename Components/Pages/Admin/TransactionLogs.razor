@page "/transaction-logs"
@attribute [Authorize(Roles = "Admin")]
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

<MudText Typo="Typo.h4" Class="mb-4 " Color="Color.Primary">System Activity Logs</MudText>

@* transactionLog in t came from mmodel clas. only accept data from thereeee *@

<MudDataGrid T="TransactionLog" Items="@_logs" SortMode="SortMode.Multiple" Filterable="false" QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center" Class="w-100 py-2">
            <MudSpacer />

            @* Filter and Search Group *@
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @* Filter Menu *@
                <MudMenu Label="Filter Logs"
                         Variant="Variant.Outlined"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Dense="true"
                         StartIcon="@Icons.Material.Filled.FilterList"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Margin="Margin.Dense"
                         Style="width: 200px;">
                    <div class="pa-4" style="min-width: 300px;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Filter Logs</MudText>
                        
                        @* Action Filter *@
                        <MudSelect T="string" Label="Action" @bind-Value="_selectedAction"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                            <MudSelectItem Value="@("")">All Actions</MudSelectItem>
                            @foreach (var action in GetAvailableActions())
                            {
                                <MudSelectItem Value="@action">@action</MudSelectItem>
                            }
                        </MudSelect>

                        @* Date Range Filter *@
                        <MudDatePicker Label="From Date" @bind-Date="_fromDate"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-2" />
                        <MudDatePicker Label="To Date" @bind-Date="_toDate"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-2" />
                        
                        <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="ResetFilters" Class="mt-2">Reset All Filters</MudButton>
                    </div>
                </MudMenu>

                @* Search Field *@
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="width: 300px;" />
            </MudStack>
        </MudStack>
    </ToolBarContent>

    <Columns>

        <PropertyColumn Property="x => x.PerformedAt" Title="Date & Time" Format="MMM dd, yyyy hh:mm tt" />

        <PropertyColumn Property="x => x.FullName" Title="Full Name" />

        <PropertyColumn Property="x => x.EventName" Title="Action" />

        <PropertyColumn Property="x => x.Description" Title="Details" />

    </Columns>

    <PagerContent>

        <MudDataGridPager T="TransactionLog" />

    </PagerContent>

</MudDataGrid>

@code {
    private string _searchString = string.Empty;
    private string _selectedAction = "";
    private DateTime? _fromDate = null;
    private DateTime? _toDate = null;
    private List<TransactionLog> _logs = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Fetch the data when the page loads
        _logs = await _context.TransactionLogs
                              .OrderByDescending(x => x.PerformedAt)
                              .ToListAsync();
    }

    // 2. Change the chip color based on the status text
    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Success" => Color.Success,
            "Warning" => Color.Warning,
            "Error" => Color.Error,
            _ => Color.Default
        };
    }

    // 3. The logic for the search bar and filters
    private Func<TransactionLog, bool> _quickFilter => x =>
    {
        // Filter by Action
        if (!string.IsNullOrWhiteSpace(_selectedAction))
        {
            if (x.EventName != _selectedAction) return false;
        }

        // Filter by Date Range
        if (_fromDate.HasValue)
        {
            if (x.PerformedAt < _fromDate.Value) return false;
        }

        if (_toDate.HasValue)
        {
            if (x.PerformedAt > _toDate.Value.AddDays(1).AddTicks(-1)) return false;
        }

        // Search text
        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.FullName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            if (x.EventName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.Description.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            return false;
        }

        return true;
    };

    private void ResetFilters()
    {
        _selectedAction = "";
        _fromDate = null;
        _toDate = null;
        _searchString = "";
    }

    private IEnumerable<string> GetAvailableActions()
    {
        return _logs
            .Select(l => l.EventName)
            .Distinct()
            .OrderBy(a => a);
    }
}