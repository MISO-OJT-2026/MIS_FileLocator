@page "/storages/cabinets"
@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Components.Pages  
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudText Typo="Typo.h4" Class="mb-4">Filing Cabinets</MudText>

<MudDataGrid T="FillingCabinet" Items="@_cabinets" Filterable="true" QuickFilter="@_quickFilter">
    <ToolBarContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
            Add Cabinet
        </MudButton>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search cabinets..." Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Cabinet Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />

        @* The C# way to count nested items! *@
        <TemplateColumn Title="Contents">
            <CellTemplate>
                <div class="d-flex flex-column gap-1">
                    <MudChip Size="Size.Small" Color="Color.Info">
                        @(context.Item.FileBox?.Count ?? 0) Boxes
                    </MudChip>
                    <MudChip Size="Size.Small" Color="Color.Secondary">
                        @(context.Item.FileBox?.Sum(b => b.Folders?.Count ?? 0) ?? 0) Folders
                    </MudChip>
                    <MudChip Size="Size.Small" Color="Color.Tertiary">
                        @(context.Item.FileBox?.Sum(b => b.Folders?.Sum(f => f.Documents?.Count ?? 0) ?? 0) ?? 0) Docs
                    </MudChip>
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip Size="Size.Small" Color="@(context.Item.IsArchived? Color.Error: Color.Success)">
                    @(context.Item.IsArchived ? "Archived" : "Active")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Actions">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2"
                           OnClick="@(() => ViewBoxes(context.Item.Id))">
                    View Boxes
                </MudButton>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(() => EditCabinet(context.Item))" />

                @* Changed from Delete to Archive *@
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Archive" Color="Color.Error"
                               OnClick="@(() => ArchiveCabinet(context.Item))"
                               Disabled="@context.Item.IsArchived" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="FillingCabinet" />
    </PagerContent>
</MudDataGrid>

@code {
    private List<FillingCabinet> _cabinets = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCabinets();
    }

    private async Task LoadCabinets()
    {
        // Fetch Cabinets -> Boxes -> Folders -> Documents so we can count them all
        _cabinets = await _context.FillingCabinets
            .Include(c => c.FileBox)
                .ThenInclude(b => b.Folders)
                    .ThenInclude(f => f.Documents)
            .ToListAsync();
    }

    private Func<FillingCabinet, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private void ViewBoxes(int cabinetId)
    {
        NavigationManager.NavigateTo($"/storages/boxes?cabinetId={cabinetId}");
    }

    
    private async Task ArchiveCabinet(FillingCabinet cabinet)
    {
        // Check if the cabinet has  boxes 
        if (cabinet.FileBox != null && cabinet.FileBox.Count > 0)
        {
            // Throw an error message and stop the process!
            Snackbar.Add($"Cannot archive '{cabinet.Name}'. You must empty or move all boxes first!", Severity.Error);
            return;
        }

        cabinet.IsArchived = true;
        _context.FillingCabinets.Update(cabinet);

       
        await _context.SaveChangesAsync();

        Snackbar.Add($"Cabinet '{cabinet.Name}' successfully archived.", Severity.Success);
        await LoadCabinets(); // Refresh the table
    }

    // Placeholders
    private async Task OpenAddDialog()
    {
       
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        // open AddCabinetDialog component
        var dialog = await DialogService.ShowAsync<AddCabinetDialog>("Add New Cabinet", options);

        // Wait here until the user closes the dialog
        var result = await dialog.Result;

        //  If they clicked "Save" (and not "Cancel"), refresh our table!
        if (!result.Canceled)
        {
            await LoadCabinets();
        }
    }
    private void EditCabinet(FillingCabinet cabinet) {  }
}