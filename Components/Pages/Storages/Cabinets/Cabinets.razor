@page "/storages/cabinets"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Components.Pages  
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using FileLocator.Models
@using MIS_FileLocator.Components.Pages.Storages
@using System.Text

@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService _currentUserService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Filing Cabinets</MudText>

@* ── Toolbar above tabs ── *@
<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-actions">
            @if (_activeTab == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                    Add Cabinet
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => ExportToCSV(false))">
                    Export
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Print" OnClick="@(() => ExportToCSV(true))">
                    Export Archived
                </MudButton>
            }
        </div>
        <div class="toolbar-filters">
            <MudMenu Label="Filter Cabinets" Variant="Variant.Outlined" Dense="true"
                     EndIcon="@Icons.Material.Filled.FilterList">
                <div class="pa-4" style="min-width: 300px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Filter Options</MudText>

                    <MudSelect T="string" @bind-Value="_selectedCabinetNumber" Label="Cabinet No."
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-3">
                        <MudSelectItem Value="@("")">All Numbers</MudSelectItem>
                        @foreach (var num in _cabinetNumbers)
                        {
                            <MudSelectItem Value="@num">Cabinet @num</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string" @bind-Value="_selectedCabinetLevel" Label="Level"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Class="mb-3">
                        <MudSelectItem Value="@("")">All Levels</MudSelectItem>
                        @foreach (var lvl in _cabinetLevels)
                        {
                            <MudSelectItem Value="@lvl">Level @lvl</MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true"
                               OnClick="ResetFilters" Class="mt-2">
                        Reset Filters
                    </MudButton>
                </div>
            </MudMenu>
            <MudTextField @bind-Value="_searchString" Placeholder="Search..."
                          Adornment="Adornment.Start" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    </div>
</MudPaper>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" SliderColor="Color.Primary" Color="Color.Transparent">

    @* --- ACTIVE CABINETS PANEL --- *@
    <MudTabPanel Text="Active Cabinets" Icon="@Icons.Material.Filled.Folder">
        <MudDataGrid T="FillingCabinet" 
                     Items="@_cabinets.Where(c => !c.IsArchived)" 
                     Filterable="false" 
                     QuickFilter="@_quickFilter" 
                     Dense="false" 
                     Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Cabinet Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <TemplateColumn Title="Contents">
                    <CellTemplate>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Inventory" 
                                   Color="Color.Info" Size="Size.Small" 
                                   OnClick="@(() => OpenCabinetExplorer(context.Item))">
                            @(context.Item.FileBox?.Count(f => !f.IsArchived) ?? 0) Boxes
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" HeaderStyle="text-align:right;" CellStyle="text-align:right;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning"
                                           OnClick="@(() => EditCabinet(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => ConfirmArchive(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FillingCabinet" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    @* --- ARCHIVED CABINETS PANEL --- *@
    <MudTabPanel Text="Archived Cabinets" Icon="@Icons.Material.Filled.Archive">
        <MudDataGrid T="FillingCabinet" Items="@_cabinets.Where(c => c.IsArchived)" Filterable="false" QuickFilter="@_quickFilter" Dense="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Cabinet Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.ArchivedBy" Title="Archived By" />
                <PropertyColumn Property="x => x.ArchivedAt" Title="Date Archived" Format="MMM dd, yyyy" />
                <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="@(() => UnarchiveCabinet(context.Item))">
                            Restore
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FillingCabinet" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

</MudTabs>


@code {
    private List<FillingCabinet> _cabinets = new();
    private string _selectedCabinetNumber = "";
    private string _selectedCabinetLevel = "";
    private string _searchString = "";
    private int _activeTab = 0;

    // Parsed distinct numbers (e.g. "1","2","3") and levels (e.g. "A","B","C") from cabinet names
    private IEnumerable<string> _cabinetNumbers =>
        _cabinets.Select(c => ParseCabinetNumber(c.Name))
                 .Where(n => n != null).Select(n => n!)
                 .Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> _cabinetLevels =>
        _cabinets.Select(c => ParseCabinetLevel(c.Name))
                 .Where(l => l != null).Select(l => l!)
                 .Distinct().OrderBy(l => l, StringComparer.OrdinalIgnoreCase);

    // Parses "Cabinet 1A" -> "1", "Cabinet 12B" -> "12"
    private static string? ParseCabinetNumber(string name)
    {
        var match = System.Text.RegularExpressions.Regex.Match(name, @"(\d+)[A-Za-z]?$");
        return match.Success ? match.Groups[1].Value : null;
    }

    // Parses "Cabinet 1A" -> "A", "Cabinet 12B" -> "B"
    private static string? ParseCabinetLevel(string name)
    {
        var match = System.Text.RegularExpressions.Regex.Match(name, @"\d+([A-Za-z])$");
        return match.Success ? match.Groups[1].Value.ToUpper() : null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCabinets();
    }

    private async Task LoadCabinets()
    {
        _cabinets = await _context.FillingCabinets
            .Include(c => c.FileBox)
                .ThenInclude(b => b.Folders)
                    .ThenInclude(f => f.Documents)
            .ToListAsync();

        StateHasChanged();
    }

    private Func<FillingCabinet, bool> _quickFilter => x =>
    {
        if (!string.IsNullOrWhiteSpace(_selectedCabinetNumber))
        {
            if (ParseCabinetNumber(x.Name) != _selectedCabinetNumber) return false;
        }

        if (!string.IsNullOrWhiteSpace(_selectedCabinetLevel))
        {
            if (!string.Equals(ParseCabinetLevel(x.Name), _selectedCabinetLevel, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            return false;
        }

        return true;
    };

    private void ResetFilters()
    {
        _selectedCabinetNumber = "";
        _selectedCabinetLevel = "";
        _searchString = "";
        StateHasChanged();
    }

    private void ViewBoxes(int cabinetId)
    {
        NavigationManager.NavigateTo($"/storages/boxes?cabinetId={cabinetId}");
    }


    private async Task ArchiveCabinet(FillingCabinet cabinet)
    {
        
        if (cabinet.FileBox != null && cabinet.FileBox.Count > 0)
        {
          
            Snackbar.Add($"Cannot archive '{cabinet.Name}'. You must empty or move all boxes first!", Severity.Error);
            return;
        }
        var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

        cabinet.IsArchived = true;
        cabinet.ArchivedAt = DateTime.UtcNow.AddHours(8);
        cabinet.ArchivedBy = currentAdmin;




        var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Archived",
                Description = $"Archived cabinet '{cabinet.Name}'.",
                Status = "Warning",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

        _context.FillingCabinets.Update(cabinet);
        _context.TransactionLogs.Add(log);
        await _context.SaveChangesAsync();

        Snackbar.Add($"Cabinet '{cabinet.Name}' successfully archived.", Severity.Success);
        await LoadCabinets(); // Refresh the table
    }

    // CONFIRMATION MODALLLLL
    private async Task ConfirmArchive(FillingCabinet cabinet)
    {
        if (cabinet.FileBox != null && cabinet.FileBox.Count > 0)
        {
            Snackbar.Add($"Cannot archive '{cabinet.Name}'. You must empty or move all boxes first!", Severity.Error);
            return;
        }


        bool? result = await DialogService.ShowMessageBoxAsync(
            "Archive Confirmation",
            $"Are you sure you want to archive '{cabinet.Name}'? You won't be able to add new boxes to it while it is archived.",
            yesText: "Archive It",
            cancelText: "Cancel"
        );


        if (result == true)
        {
            await ArchiveCabinet(cabinet);

        }

    }

    private async Task UnarchiveCabinet(FillingCabinet cabinet)
    {
     
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Restore Cabinet",
            $"Restore '{cabinet.Name}' to active status?",
            yesText: "Restore",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

            cabinet.IsArchived = false;
            cabinet.ArchivedAt = null;
            cabinet.ArchivedBy = null;

            var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Restored",
                Description = $"Restored cabinet '{cabinet.Name}' back to active status.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

            _context.FillingCabinets.Update(cabinet);
            _context.TransactionLogs.Add(log); 
            await _context.SaveChangesAsync();

            Snackbar.Add($"Cabinet '{cabinet.Name}' successfully restored.", Severity.Success);
            await LoadCabinets();
        }
    }

    
    private async Task OpenAddDialog()
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

       
        var dialog = await DialogService.ShowAsync<AddCabinetDialog>("Add New Cabinet", options);

        
        var result = await dialog.Result;

       
        if (!result.Canceled)
        {
            await LoadCabinets();
        }
    }
    private async Task EditCabinet(FillingCabinet cabinet)
    {
        
    
        var parameters = new DialogParameters<EditCabinetDialog>
        {
            { x => x.CabinetToEdit, cabinet }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        
        var dialog = await DialogService.ShowAsync<EditCabinetDialog>("Edit Cabinet", parameters, options);
        
        
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCabinets();
        }

    }

    private async Task OpenCabinetExplorer(FillingCabinet cabinet)
    {
        
        var parameters = new DialogParameters
    {
        { "SelectedCabinet", cabinet }
    };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogService.ShowAsync<CabinetExplorerDialog>($"Contents of {cabinet.Name}", parameters, options);
    }
    
    //EXPORT  CSV
    private async Task ExportToCSV(bool exportArchived)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Cabinet Name,Description,Status,Date Archived,Archived By");

        
        var cabinetsToExport = _cabinets.Where(c => c.IsArchived == exportArchived).ToList();

        foreach (var cab in cabinetsToExport)
        {
            var status = cab.IsArchived ? "Archived" : "Active";
            var dateArchived = cab.ArchivedAt?.ToString("MMM dd, yyyy") ?? "N/A";
            var archivedBy = cab.ArchivedBy ?? "N/A";

            builder.AppendLine($"\"{cab.Name}\",\"{cab.Description}\",\"{status}\",\"{dateArchived}\",\"{archivedBy}\"");
        }

        
        string fileName = exportArchived ? "Archived_Cabinets_{DateTime.Now:yyyyMMdd.csv" : "Active_Cabinets_{DateTime.Now:yyyyMMdd.csv";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, builder.ToString());
    }
}