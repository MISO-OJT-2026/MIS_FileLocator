@page "/storages/cabinets"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Components.Pages  
@using MIS_FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using FileLocator.Models
@using MIS_FileLocator.Components.Pages.Storages
@using System.Text

@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService _currentUserService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Filing Cabinets</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" SliderColor="Color.Primary"
         Color="Color.Transparent">


 
    <MudTabPanel Text="Active Cabinets" 
                 Icon="@Icons.Material.Filled.Folder" >
        <MudDataGrid T="FillingCabinet" Items="@_cabinets.Where(c => !c.IsArchived)" Filterable="false" QuickFilter="@_quickFilter" Dense="true" Hover="true">
            <ToolBarContent>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Center" Class="w-100 py-2">
                    @* Action Buttons Group *@
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddDialog">
                            Add Cabinet
                        </MudButton>
                        <MudTooltip Text="Export to CSV">
                            <MudIconButton Variant="Variant.Outlined"
                                           Color="Color.Success"
                                           Icon="@Icons.Material.Filled.Print"
                                           OnClick="@(() => ExportToCSV(false))" />
                        </MudTooltip>
                    </MudStack>

                    <MudSpacer />

                    @* Filters Group *@
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="flex-grow-1 justify-end">
                        @* Dynamic Cabinet Name Filter *@
                        <MudSelect T="string"
                                   @bind-Value="_selectedCabinetName"
                                   Clearable="true"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Style="width: 200px;"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList">
                            @* <--- ADD THIS '>' HERE *@
                            <MudSelectItem Value="@("")">All Cabinets / Shelves</MudSelectItem>
                            @foreach (var name in _cabinets.Where(c => !c.IsArchived).Select(c => c.Name).Distinct().OrderBy(n => n))
                            {
                                <MudSelectItem Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>

                        @* Text Search *@
                        <MudTextField @bind-Value="_searchString"
                                      Placeholder="Search..."
                                      Adornment="Adornment.Start"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                    AdornmentIcon="@Icons.Material.Filled.Search"
                                      Style="width: 300px;" />
                    </MudStack>
                </MudStack>
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Cabinet Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                   
                <TemplateColumn Title="Contents">
                    <CellTemplate>
                        <MudButton Variant="Variant.Text" 
                       StartIcon="@Icons.Material.Filled.Inventory" 
                       Color="Color.Info" 
                       Size="Size.Small"
                       OnClick="@(() => OpenCabinetExplorer(context.Item))">
                       @(context.Item.FileBox?.Count(f => !f.IsArchived) ?? 0) Boxes
                       </MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <CellTemplate>
                
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(() => EditCabinet(context.Item))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Archive" Color="Color.Error" OnClick="@(() => ConfirmArchive(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FillingCabinet" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    
    <MudTabPanel Text="Archived Cabinets" Icon="@Icons.Material.Filled.Archive" >
        <MudDataGrid T="FillingCabinet" Items="@_cabinets.Where(c => c.IsArchived)" Filterable="true" QuickFilter="@_quickFilter">
            <ToolBarContent>
               
                <MudTooltip Text="Export Archived Cabinets to CSV" Placement="Placement.Top">
                    <MudIconButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Icon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => ExportToCSV(true))"
                                   Class="mr-2" />
                </MudTooltip>
                
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search archived cabinets..." Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Cabinet Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />

               
                <PropertyColumn Property="x => x.ArchivedBy" Title="Archived By" />
                <PropertyColumn Property="x => x.ArchivedAt" Title="Date Archived" Format="MMM dd, yyyy" />

                <TemplateColumn Title="Actions">
                    <CellTemplate>
                        
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="@(() => UnarchiveCabinet(context.Item))">
                            Restore
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FillingCabinet" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

</MudTabs>


@code {
    private List<FillingCabinet> _cabinets = new();
    private string _selectedCabinetName = ""; 
    private string _searchString = "";
    

    protected override async Task OnInitializedAsync()
    {
        await LoadCabinets();
    }

    private async Task LoadCabinets()
    {

        _cabinets = await _context.FillingCabinets
            .Include(c => c.FileBox)
                .ThenInclude(b => b.Folders)
                    .ThenInclude(f => f.Documents)
            .ToListAsync();

        

        StateHasChanged();

    }
    private string ExtractLevel(string description)
    {
        var parts = description.Split(',');
        return parts[0].Trim();
    }

    private Func<FillingCabinet, bool> _quickFilter => x =>
{
    
    if (!string.IsNullOrWhiteSpace(_selectedCabinetName))
    {
        if (!x.Name.Equals(_selectedCabinetName, StringComparison.OrdinalIgnoreCase))
            return false;
    }

    
    if (!string.IsNullOrWhiteSpace(_searchString))
    {
        if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    return true;
};

    private void ViewBoxes(int cabinetId)
    {
        NavigationManager.NavigateTo($"/storages/boxes?cabinetId={cabinetId}");
    }


    private async Task ArchiveCabinet(FillingCabinet cabinet)
    {
        
        if (cabinet.FileBox != null && cabinet.FileBox.Count > 0)
        {
          
            Snackbar.Add($"Cannot archive '{cabinet.Name}'. You must empty or move all boxes first!", Severity.Error);
            return;
        }
        var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

        cabinet.IsArchived = true;
        cabinet.ArchivedAt = DateTime.UtcNow.AddHours(8);
        cabinet.ArchivedBy = currentAdmin;




        var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Archived",
                Description = $"Archived cabinet '{cabinet.Name}'.",
                Status = "Warning",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

        _context.FillingCabinets.Update(cabinet);
        _context.TransactionLogs.Add(log);
        await _context.SaveChangesAsync();

        Snackbar.Add($"Cabinet '{cabinet.Name}' successfully archived.", Severity.Success);
        await LoadCabinets(); // Refresh the table
    }

    // CONFIRMATION MODALLLLL
    private async Task ConfirmArchive(FillingCabinet cabinet)
    {
        if (cabinet.FileBox != null && cabinet.FileBox.Count > 0)
        {
            Snackbar.Add($"Cannot archive '{cabinet.Name}'. You must empty or move all boxes first!", Severity.Error);
            return;
        }


        bool? result = await DialogService.ShowMessageBoxAsync(
            "Archive Confirmation",
            $"Are you sure you want to archive '{cabinet.Name}'? You won't be able to add new boxes to it while it is archived.",
            yesText: "Archive It",
            cancelText: "Cancel"
        );


        if (result == true)
        {
            await ArchiveCabinet(cabinet);

        }

    }

    private async Task UnarchiveCabinet(FillingCabinet cabinet)
    {
     
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Restore Cabinet",
            $"Restore '{cabinet.Name}' to active status?",
            yesText: "Restore",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

            cabinet.IsArchived = false;
            cabinet.ArchivedAt = null;
            cabinet.ArchivedBy = null;

            var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Restored",
                Description = $"Restored cabinet '{cabinet.Name}' back to active status.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

            _context.FillingCabinets.Update(cabinet);
            _context.TransactionLogs.Add(log); 
            await _context.SaveChangesAsync();

            Snackbar.Add($"Cabinet '{cabinet.Name}' successfully restored.", Severity.Success);
            await LoadCabinets();
        }
    }

    
    private async Task OpenAddDialog()
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

       
        var dialog = await DialogService.ShowAsync<AddCabinetDialog>("Add New Cabinet", options);

        
        var result = await dialog.Result;

       
        if (!result.Canceled)
        {
            await LoadCabinets();
        }
    }
    private async Task EditCabinet(FillingCabinet cabinet)
    {
        
    
        var parameters = new DialogParameters<EditCabinetDialog>
        {
            { x => x.CabinetToEdit, cabinet }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        
        var dialog = await DialogService.ShowAsync<EditCabinetDialog>("Edit Cabinet", parameters, options);
        
        
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCabinets();
        }

    }

    private async Task OpenCabinetExplorer(FillingCabinet cabinet)
    {
        
        var parameters = new DialogParameters
    {
        { "SelectedCabinet", cabinet }
    };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogService.ShowAsync<CabinetExplorerDialog>($"Contents of {cabinet.Name}", parameters, options);
    }
    
    //EXPORT  CSV
    private async Task ExportToCSV(bool exportArchived)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Cabinet Name,Description,Status,Date Archived,Archived By");

        
        var cabinetsToExport = _cabinets.Where(c => c.IsArchived == exportArchived).ToList();

        foreach (var cab in cabinetsToExport)
        {
            var status = cab.IsArchived ? "Archived" : "Active";
            var dateArchived = cab.ArchivedAt?.ToString("MMM dd, yyyy") ?? "N/A";
            var archivedBy = cab.ArchivedBy ?? "N/A";

            builder.AppendLine($"\"{cab.Name}\",\"{cab.Description}\",\"{status}\",\"{dateArchived}\",\"{archivedBy}\"");
        }

        
        string fileName = exportArchived ? "Archived_Cabinets_{DateTime.Now:yyyyMMdd.csv" : "Active_Cabinets_{DateTime.Now:yyyyMMdd.csv";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, builder.ToString());
    }
}