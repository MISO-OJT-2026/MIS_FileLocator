
@using FileLocator.Services
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using MIS_FileLocator.Data
@using Microsoft.EntityFrameworkCore

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject ApplicationDbContext _context



<MudDialog >
    <DialogContent>
        <EditForm Model="_newCabinet" OnValidSubmit="SaveCabinet">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_newCabinet.Name" Label="Cabinet Name" Required="true"
                          Variant="Variant.Outlined" Class="mb-3" Placeholder="e.g., Cabinet A" />

            <MudTextField @bind-Value="_newCabinet.Description" Label="Description (Optional)"
                          Variant="Variant.Outlined" Lines="3" Placeholder="e.g., Located in the Server Room" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCabinet">Save Cabinet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // This allows the dialog to close itself
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // Our empty bucket for the new data
    private FillingCabinet _newCabinet = new();



    private async Task SaveCabinet()
    {

        if (string.IsNullOrWhiteSpace(_newCabinet.Name))
        {
            Snackbar.Add("Cabinet name is required.", Severity.Error);
            return;
        }
        // Check if the cabinet name already exists
        var existingActive = await _context.FillingCabinets.AnyAsync(c => c.Name.ToLower() == _newCabinet.Name.ToLower() && !c.IsArchived);
        
        if(existingActive)
        {
            Snackbar.Add("A cabinet with this name already exists. Please choose a different name.", Severity.Error);
            return;
        }
        // check archived din 
        var existingArchived = await _context.FillingCabinets.FirstOrDefaultAsync(c => c.Name.ToLower() == _newCabinet.Name.ToLower() && c.IsArchived);
        _context.FillingCabinets.Add(_newCabinet);

        //get admin o r editor 
        var curentAdmin = await _currentUserService.GetCurrentFullNameAsync();

        if (existingArchived != null)
        {
            // ask if change name or restore 
            Snackbar.Add("A cabinet with this name exists in the Archives. Please restore it or use a different name.", Severity.Info);
            return;
        }
        try
        {
            // Add to database
            _context.FillingCabinets.Add(_newCabinet);

            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

            var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Created",
                Description = $"Added a new physical cabinet named '{_newCabinet.Name}'.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

            _context.TransactionLogs.Add(log);

            await _context.SaveChangesAsync();

            Snackbar.Add("Cabinet created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving cabinet: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}