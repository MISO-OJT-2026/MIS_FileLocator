
@using FileLocator.Services
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using MIS_FileLocator.Data
@using Microsoft.EntityFrameworkCore


@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject ApplicationDbContext _context



<MudDialog>
    <DialogContent>
        <EditForm Model="_newCabinet" OnValidSubmit="SaveCabinet">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_newCabinet.Name" Label="Cabinet Name" Required="true"
                          Variant="Variant.Outlined" Class="mb-3" Placeholder="e.g., Cabinet A" />

            <MudTextField @bind-Value="_newCabinet.Description" Label="Description (Optional)"
                          Variant="Variant.Outlined" Lines="3" Placeholder="e.g., Located in the Server Room" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCabinet">Save Cabinet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // This allows the dialog to close itself
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // Our empty bucket for the new data
    private FillingCabinet _newCabinet = new();
    


    private async Task SaveCabinet()
    {

        if (string.IsNullOrWhiteSpace(_newCabinet.Name))
        {
            Snackbar.Add("Cabinet name is required.", Severity.Error);
            return;
        }
        //add in databaseeee
        _context.FillingCabinets.Add(_newCabinet);

        //get admin o r editor 
        var curentAdmin = await _currentUserService.GetCurrentFullNameAsync();

        var log = new TransactionLog
            {
                FullName = curentAdmin,
                EventName = "Cabinet Created",
                Description = $"Added a new physical cabinet named '{_newCabinet.Name}' to the system.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

        _context.TransactionLogs.Add(log);


        //save cabinet and log
        await _context.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
        }
    private void Cancel() => MudDialog.Cancel();
}