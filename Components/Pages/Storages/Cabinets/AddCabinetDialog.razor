
@using FileLocator.Services
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using MIS_FileLocator.Data
@using Microsoft.EntityFrameworkCore

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject IDbContextFactory<ApplicationDbContext> DbFactory



<MudDialog >
    <DialogContent>
        <EditForm Model="_newCabinet" OnValidSubmit="SaveCabinet">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_newCabinet.Name" Label="Cabinet Name" Required="true"
                          Variant="Variant.Outlined" Class="mb-3" Placeholder="e.g., Cabinet A" />

            <MudTextField @bind-Value="_newCabinet.Description" Label="Description (Optional)"
                          Variant="Variant.Outlined" Lines="3" Placeholder="e.g., Located in the Server Room" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCabinet" Disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Save Cabinet")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private FillingCabinet _newCabinet = new();
    private bool _isSaving = false;

    private async Task SaveCabinet()
    {
        if (_isSaving) return;
        if (string.IsNullOrWhiteSpace(_newCabinet.Name))
        {
            Snackbar.Add("Cabinet name is required.", Severity.Error);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var existingActive = await db.FillingCabinets.AnyAsync(c => c.Name.ToLower() == _newCabinet.Name.ToLower() && !c.IsArchived);
        if (existingActive) { Snackbar.Add("A cabinet with this name already exists.", Severity.Error); return; }
        var existingArchived = await db.FillingCabinets.FirstOrDefaultAsync(c => c.Name.ToLower() == _newCabinet.Name.ToLower() && c.IsArchived);
        if (existingArchived != null) { Snackbar.Add("This name exists in Archives. Restore it or use a different name.", Severity.Info); return; }

        _isSaving = true;
        StateHasChanged();
        try
        {
            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
            db.FillingCabinets.Add(_newCabinet);
            db.TransactionLogs.Add(new TransactionLog
            {
                FullName = currentAdmin, EventName = "Cabinet Created",
                Description = $"Added a new physical cabinet named '{_newCabinet.Name}'.",
                Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
            });
            db.CurrentUserOverride = currentAdmin;
            await db.SaveChangesAsync();
            Snackbar.Add("Cabinet created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void Cancel() { if (!_isSaving) MudDialog.Cancel(); }
}