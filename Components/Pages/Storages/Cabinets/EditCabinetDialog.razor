@using FileLocator.Models

@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <EditForm Model="_editCabinet" OnValidSubmit="SaveUpdates">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_editCabinet.Name" Label="Cabinet Name" Required="true"
                          Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField @bind-Value="_editCabinet.Description" Label="Description (Optional)"
                          Variant="Variant.Outlined" Lines="3" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates">Save Changes</MudButton>
    </DialogActions>
</MudDialog>

@code{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!; //  parang $SESSION to pass the value between components,the it allows you to open the modal and close. "DEFAULT!" ALLOWS TO SET VALUES LATER 

    [Parameter] public FillingCabinet CabinetToEdit { get; set;} = default!; // how its receive data from cabinet.razor.this line catches it. noal na catch 

    private FillingCabinet _editCabinet = new(); // creating temporary holder for new values

    protected override void OnInitialized() // put it here ganun for the boxes to have something to display. SERVES AS TEMPORARY COPY SO THE USER CAN STILL CANCEL THE CHANGESSSSS 
    {
        _editCabinet.Id = CabinetToEdit.Id;
        _editCabinet.Name = CabinetToEdit.Name;
        _editCabinet.Description = CabinetToEdit.Description;


    }

    private async Task SaveUpdates()
    {
        if (string.IsNullOrWhiteSpace(_editCabinet.Name))
        {
            Snackbar.Add("Cabinet name is required.", Severity.Warning);
            return;
        }

        // find the cabinet selected 
        var realCabinet = await _context.FillingCabinets.FindAsync(_editCabinet.Id);
        if(realCabinet  == null) return;


        //update valuess
        realCabinet.Name = _editCabinet.Name;
        realCabinet.Description = _editCabinet.Description;

        //create transaction log 
        var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
        var log = new TransactionLog

        {
            FullName= currentAdmin, 
            EventName = "Cabinet Updated",
            Description = $"Updated the details for cabinet '{realCabinet.Name}'.",
            Status = "Success",
            PerformedAt = DateTime.UtcNow.AddHours(8)
        };

        _context.TransactionLogs.Add(log);

        // save my everything and nice

        await _context.SaveChangesAsync();
        Snackbar.Add($"Cabinet updated successfully!", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));

    }
    private void Cancel() => MudDialog.Cancel();

}