@using FileLocator.Models

@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <EditForm Model="_editCabinet" OnValidSubmit="SaveUpdates">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_editCabinet.Name" Label="Cabinet Name" Required="true"
                          Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField @bind-Value="_editCabinet.Description" Label="Description (Optional)"
                          Variant="Variant.Outlined" Lines="3" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates" Disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public FillingCabinet CabinetToEdit { get; set; } = default!; //to identify what cabinet is slected 
    private FillingCabinet _editCabinet = new();
    private bool _isSaving = false;

    protected override void OnInitialized()
    {
        _editCabinet.Id = CabinetToEdit.Id;
        _editCabinet.Name = CabinetToEdit.Name;
        _editCabinet.Description = CabinetToEdit.Description;
    }

    private async Task SaveUpdates()
    {
        if (_isSaving) return;
        if (string.IsNullOrWhiteSpace(_editCabinet.Name)) { Snackbar.Add("Cabinet name is required.", Severity.Warning); return; }

        // Detect changes before saving
        var changes = new List<string>();
        if (CabinetToEdit.Name != _editCabinet.Name)
            changes.Add($"Name: '{CabinetToEdit.Name}' → '{_editCabinet.Name}'");
        if ((CabinetToEdit.Description ?? "") != (_editCabinet.Description ?? ""))
            changes.Add("Description updated");

        if (!changes.Any())
        {
            Snackbar.Add("No changes were made.", Severity.Info);
            MudDialog.Cancel();
            return;
        }

        _isSaving = true;
        StateHasChanged();
        try
        {
            bool isDuplicate = await _context.FillingCabinets.AnyAsync(c => c.Name.ToLower() == _editCabinet.Name.ToLower() && c.Id != _editCabinet.Id);
            if (isDuplicate) { Snackbar.Add($"Cabinet name '{_editCabinet.Name}' is already taken.", Severity.Error); return; }
            var realCabinet = await _context.FillingCabinets.FindAsync(_editCabinet.Id);
            if (realCabinet == null) { Snackbar.Add("Cabinet not found.", Severity.Error); return; }
            realCabinet.Name = _editCabinet.Name;
            realCabinet.Description = _editCabinet.Description;
            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
            _context.TransactionLogs.Add(new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Cabinet Updated",
                Description = $"Cabinet '{CabinetToEdit.Name}': {string.Join(" | ", changes)}",
                Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
            });
            await _context.SaveChangesAsync();
            Snackbar.Add("Cabinet updated successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void Cancel() { if (!_isSaving) MudDialog.Cancel(); }
}