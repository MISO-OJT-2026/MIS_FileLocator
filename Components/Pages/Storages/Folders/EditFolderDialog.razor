@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <EditForm Model="_editFolder" OnValidSubmit="SaveUpdates">
            <DataAnnotationsValidator />

            @* MOVE LOGIC: Dropdown to change the parent Box *@
            <MudSelect T="int"
                       Label="Current Storage Box"
                       @bind-Value="_editFolder.FileBoxId"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       HelperText="Change this to move the folder to another box"
                       Class="mb-3">
                @foreach (var box in _activeBoxes)
                {
                    <MudSelectItem Value="@box.Id">
                        @($"{box.Name} (Cabinet: {box.FillingCabinet?.Name ?? "N/A"})")
                    </MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_editFolder.Name" Label="Folder Name" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_editFolder.Description" Label="Description" Variant="Variant.Outlined" Lines="3" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates" Disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Folder FolderToEdit { get; set; } = default!;
    private Folder _editFolder = new();
    private List<FileBoxes> _activeBoxes = new();
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        _editFolder.Id = FolderToEdit.Id;
        _editFolder.Name = FolderToEdit.Name;
        _editFolder.Description = FolderToEdit.Description;
        _editFolder.FileBoxId = FolderToEdit.FileBoxId;
        _activeBoxes = await _context.FileBoxes.Include(b => b.FillingCabinet).Where(b => !b.IsArchived).OrderBy(b => b.Name).ToListAsync();
    }

    private async Task SaveUpdates()
    {
        if (_isSaving) return;
        if (string.IsNullOrWhiteSpace(_editFolder.Name)) { Snackbar.Add("Folder name is required.", Severity.Error); return; }
        _isSaving = true;
        StateHasChanged();
        try
        {
            bool isDuplicate = await _context.Folders.AnyAsync(f => f.Name.ToLower() == _editFolder.Name.ToLower() && f.Id != _editFolder.Id && f.FileBoxId == _editFolder.FileBoxId);
            if (isDuplicate) { Snackbar.Add($"Folder name '{_editFolder.Name}' is already taken in this box.", Severity.Error); return; }
            var realFolder = await _context.Folders.FindAsync(_editFolder.Id);
            if (realFolder == null) return;
            bool isMoving = realFolder.FileBoxId != _editFolder.FileBoxId;
            realFolder.Name = _editFolder.Name;
            realFolder.Description = _editFolder.Description;
            realFolder.FileBoxId = _editFolder.FileBoxId;
            var boxName = await _context.FileBoxes.Where(b => b.Id == _editFolder.FileBoxId).Select(b => b.Name).FirstOrDefaultAsync();
            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
            _context.TransactionLogs.Add(new TransactionLog
            {
                FullName = currentAdmin,
                EventName = isMoving ? "Folder Moved" : "Folder Updated",
                Description = isMoving ? $"Moved folder '{realFolder.Name}' to Box '{boxName}'." : $"Updated details for folder '{realFolder.Name}'.",
                Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
            });
            await _context.SaveChangesAsync();
            Snackbar.Add("Folder updated successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void Cancel() { if (!_isSaving) MudDialog.Cancel(); }
}