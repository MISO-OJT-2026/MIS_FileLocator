@page "/storages/folders"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text
@using MIS_FileLocator.Components.Pages.Storages
@using MIS_FileLocator.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService // to open dialog but cannot control (IMudDialogInstance)
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider
@inject ICurrentUserService CurrentUserService

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Storage Folders</MudText>


<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-actions">
            @if (_activeTab == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                    Add Folder
                </MudButton>
            }
            <MudIconButton Variant="Variant.Outlined" Color="Color.Success"
                           Icon="@Icons.Material.Filled.Print"
                           OnClick="@(() => ExportToCSV(_activeTab == 1))" />
        </div>
        <div class="toolbar-filters">
            <MudMenu Label="Filter Folders" Variant="Variant.Outlined" Dense="true" Typo="Typo.subtitle2"
                     EndIcon="@Icons.Material.Filled.FilterList">
                <div class="pa-4" style="min-width: 300px;">
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Filter Options</MudText>
                    
                    <MudSelect T="string" Value="_selectedCabinet" Label="Cabinet"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" ValueChanged="OnFolderCabinetChanged" Class="mb-3">
                        <MudSelectItem Value="@("")">All Cabinets</MudSelectItem>
                        @if (_folders != null)
                        {
                            @foreach (var cab in _folders.Where(f => f.FileBox?.FillingCabinet != null)
                                                          .Select(f => f.FileBox.FillingCabinet.Name)
                                                          .Distinct().OrderBy(n => n))
                            {
                                <MudSelectItem Value="@cab">@cab</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="string" @bind-Value="_selectedBox" Label="Box"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Searchable="true" Disabled="@string.IsNullOrWhiteSpace(_selectedCabinet)" Class="mb-3">
                        <MudSelectItem Value="@("")">All Boxes</MudSelectItem>
                        @if (_folders != null && !string.IsNullOrWhiteSpace(_selectedCabinet))
                        {
                            @foreach (var box in _folders
                                .Where(f => f.FileBox?.FillingCabinet?.Name == _selectedCabinet && f.FileBox != null)
                                .Select(f => f.FileBox!.Name).Distinct().OrderBy(n => n))
                            {
                                <MudSelectItem Value="@box">@box</MudSelectItem>
                            }
                        }
                    </MudSelect>
                    
                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" 
                               OnClick="ResetFilters" Class="mt-2">
                        Reset Filters
                    </MudButton>
                </div>
            </MudMenu>
            <MudTextField @bind-Value="_searchString" Placeholder="Search folders..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </div>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    <MudText Align="Align.Center" Class="my-4">Loading folders...</MudText>
}
else if (_folders == null || !_folders.Any())
{
    <MudAlert Severity="Severity.Info" Class="my-4">No folders found. Click "Add Folder" to create your first folder.</MudAlert>
}
else
{
<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" SliderColor="Color.Primary">

  
    <MudTabPanel Text="Active Folders" Icon="@Icons.Material.Filled.Folder">
        <MudDataGrid T="Folder"
                     Items="@(_folders?.Where(f => !f.IsArchived) ?? Enumerable.Empty<Folder>())"
                     QuickFilter="@_quickFilter"
                     Dense="true"
                     Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Folder Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <TemplateColumn Title="Location">
                    <CellTemplate>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2"><b>Box:</b> @(context.Item.FileBox?.Name ?? "N/A")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Cabinet:</b> @(context.Item.FileBox?.FillingCabinet?.Name ?? "N/A")</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Contents">
                    <CellTemplate>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Description"
                                   Color="Color.Info" Size="Size.Small"
                                   OnClick="@(() => OpenFolderExplorer(context.Item))">
                            @(context.Item.Documents?.Count(d => !d.IsDeleted && !d.IsDisposal) ?? 0) Documents
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" CellStyle="text-align:right;">
                    <CellTemplate>
                        <MudStack Spacing="1" Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Archive" Color="Color.Error" OnClick="@(() => ConfirmArchive(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="Folder" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    
    <MudTabPanel Text="Archived Folders" Icon="@Icons.Material.Filled.Archive">
        <MudDataGrid T="Folder" Items="@(_folders?.Where(f => f.IsArchived) ?? Enumerable.Empty<Folder>())" QuickFilter="@_quickFilter">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Folder Name" />
                <TemplateColumn Title="Last Known Location">
                    <CellTemplate>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2"><b>Box:</b> @(context.Item.FileBox?.Name ?? "Unknown")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Cabinet:</b> @(context.Item.FileBox?.FillingCabinet?.Name ?? "Unknown")</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ArchivedBy" Title="Archived By" />
                <PropertyColumn Property="x => x.ArchivedAt" Title="Date Archived" Format="MMM dd, yyyy" />
                <TemplateColumn Title="Actions" CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="@(() => UnarchiveFolder(context.Item))">
                            Restore
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="Folder" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>
}
<style>
    .mud-button-label{
        font-weight:100 !important;
    }
</style>

@code {
    private List<Folder>? _folders = null;
    private string _searchString = "";
    private string _selectedCabinet = "";
    private string _selectedBox = "";
    private int _activeTab = 0;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadFolders();

    private async Task LoadFolders()
    {
        try
        {
            _isLoading = true;
            using var scope = ServiceProvider.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            _folders = await context.Folders
                .AsNoTracking()
                .Include(f => f.FileBox)
                    .ThenInclude(b => b.FillingCabinet)
                .Include(f => f.Documents)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading folders: {ex.Message}", Severity.Error);
            _folders = new List<Folder>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // When cabinet changes, reset box selection so stale box doesn't remain
    private void OnFolderCabinetChanged(string value)
    {
        _selectedCabinet = value;
        _selectedBox = "";
        StateHasChanged();
    }

    private void ResetFilters()
    {
        _selectedCabinet = "";
        _selectedBox = "";
        _searchString = "";
        StateHasChanged();
    }

    private Func<Folder, bool> _quickFilter => x =>
    {
        if (!string.IsNullOrWhiteSpace(_selectedCabinet))
        {
            if (x.FileBox?.FillingCabinet?.Name != _selectedCabinet) return false;
        }

        if (!string.IsNullOrWhiteSpace(_selectedBox))
        {
            if (x.FileBox?.Name != _selectedBox) return false;
        }

        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
            if (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
            return false;
        }

        return true;
    };

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddFolderDialog>("Add New Folder", options);

        var result = await dialog.Result;

        if (!result.Canceled) await LoadFolders();
    }

    private async Task OpenEditDialog(Folder folder)
    {
        var parameters = new DialogParameters
        { 
            ["FolderToEdit"] = folder 
        };
        var options = new DialogOptions 
        {
            CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true 
        };

        var dialog = await DialogService.ShowAsync<EditFolderDialog>("Edit / Move Folder", parameters, options);

        if (!(await dialog.Result).Canceled) await LoadFolders();
    }

    private async Task OpenFolderExplorer(Folder folder)
    {
        var parameters = new DialogParameters 
        { 
            ["SelectedFolder"] = folder 
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true 
        };

        await DialogService.ShowAsync<FolderExplorerDialog>($"Contents of {folder.Name}", parameters, options);
    }

    private async Task ConfirmArchive(Folder folder)
    {
        if (folder.Documents?.Any(d => !d.IsDeleted) == true)
        {
            Snackbar.Add($"Cannot archive '{folder.Name}'. Please archive or move its documents first!", Severity.Error);
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync("Archive Confirmation", $"Are you sure?", yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                var currentUserName = await CurrentUserService.GetCurrentFullNameAsync();

                await using var archCtx = await DbFactory.CreateDbContextAsync();
                await archCtx.Folders
                    .Where(f => f.Id == folder.Id)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(f => f.IsArchived, true)
                        .SetProperty(f => f.ArchivedAt, DateTime.UtcNow.AddHours(8))
                        .SetProperty(f => f.ArchivedBy, currentUserName));

                await LoadFolders();
                Snackbar.Add("Folder archived successfully.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error archiving folder: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task UnarchiveFolder(Folder folder)
    {
        bool? result = await DialogService.ShowMessageBoxAsync("Restore Folder", $"Restore '{folder.Name}'?", yesText: "Restore", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await using var restCtx = await DbFactory.CreateDbContextAsync();
                await restCtx.Folders
                    .Where(f => f.Id == folder.Id)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(f => f.IsArchived, false)
                        .SetProperty(f => f.ArchivedAt, (DateTime?)null)
                        .SetProperty(f => f.ArchivedBy, (string?)null));

                await LoadFolders();
                Snackbar.Add("Restored.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error restoring folder: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ExportToCSV(bool exportArchived)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Folder Name,Box,Cabinet,Description,Status,Date Archived,Archived By");
        var foldersToExport = _folders.Where(f => f.IsArchived == exportArchived).ToList();
        foreach (var folder in foldersToExport)
        {
            builder.AppendLine($"\"{folder.Name}\",\"{folder.FileBox?.Name}\",\"{folder.FileBox?.FillingCabinet?.Name}\",\"{folder.Description}\",\"{(folder.IsArchived ? "Archived" : "Active")}\",\"{folder.ArchivedAt}\",\"{folder.ArchivedBy}\"");
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", (exportArchived ? "Archived" : "Active") + "_Folders.csv", builder.ToString());
    }
}