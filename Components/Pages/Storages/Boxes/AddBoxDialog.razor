@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor

@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService
@inject ApplicationDbContext _context

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <DialogContent>
        <MudPaper Class="pa-4">
            <MudStack Spacing="3">

                <MudStack Row="true" AnchorOrigin="Origin.BottomCenter" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Medium" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Create New Storage Box</MudText>
                </MudStack>

                <EditForm Model="_newBox" OnValidSubmit="SaveBox">
                    <DataAnnotationsValidator />

                    <MudSelect T="int"
                               Label="Assign to Cabinet"
                               @bind-Value="_newBox.FillingCabinetId"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Required="true"
                               Class="mb-3"
                               HelperText="Select where this box will be stored">

                        @foreach (var cab in _activeCabinets)
                        {
                            <MudSelectItem Value="@cab.Id">@cab.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_newBox.Name"
                                  Label="Box Name / Number"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Class="mb-3"
                                  Placeholder="e.g., Box 001"
                                  HelperText="Use a unique box name inside the selected cabinet" />

                    <MudTextField @bind-Value="_newBox.Description"
                                  Label="Description (Optional)"
                                  Variant="Variant.Outlined"
                                  Lines="3" />
                </EditForm>

            </MudStack>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveBox"
                   StartIcon="@Icons.Material.Filled.Save">
            Save Box
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    private FileBoxes _newBox = new();
    private List<FillingCabinet> _activeCabinets = new();

    protected override async Task OnInitializedAsync()
    {
        _activeCabinets = await _context.FillingCabinets
            .Where(c => !c.IsArchived)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task SaveBox()
    {
        if (_newBox.FillingCabinetId == 0)
        {
            Snackbar.Add("Please select a cabinet.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newBox.Name))
        {
            Snackbar.Add("Box name is required.", Severity.Warning);
            return;
        }

        var nameExists = await _context.FileBoxes.AnyAsync(b =>
            b.Name.ToLower() == _newBox.Name.ToLower() &&
            b.FillingCabinetId == _newBox.FillingCabinetId &&
            !b.IsArchived);

        if (nameExists)
        {
            Snackbar.Add("A box with this name already exists in the selected cabinet.", Severity.Error);
            return;
        }

        try
        {
            _context.FileBoxes.Add(_newBox);

            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

            var log = new TransactionLog
            {
                FullName = currentAdmin,
                EventName = "Box Created",
                Description = $"Created box '{_newBox.Name}' in Cabinet ID {_newBox.FillingCabinetId}.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            };

            _context.TransactionLogs.Add(log);
            await _context.SaveChangesAsync();

            Snackbar.Add("Box created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}