@page "/storages/boxes"
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text

@using MIS_FileLocator.Components.Pages.Storages

@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService _currentUserService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4">Storage Boxes</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" SliderColor="Color.Secondary">

    <MudTabPanel Text="Active Boxes" Icon="@Icons.Material.Filled.Inventory">

        <MudDataGrid T="FileBoxes"
                     Items="@_boxes.Where(b => !b.IsArchived)"
                     Context="box"
                     Filterable="true"
                     QuickFilter="@_quickFilter">

            <ToolBarContent>
                <MudStack Row ="true" Spacing ="2" AlignItems ="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog">
                    Add Box
                </MudButton>
                    <MudTooltip Text="Export Active to CSV" Placement="Placement.Top">
                        <MudIconButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Icon="@Icons.Material.Filled.Print"
                                       OnClick="@(() => ExportToCSV(false))"
                                       Class="mr-2" />
                    </MudTooltip>
                </MudStack>
                <MudSpacer />

            
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search boxes..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>

            <Columns>

                <PropertyColumn Property="x => x.Name" Title="Box Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />

                <TemplateColumn Title="Cabinet">
                    <CellTemplate Context="box">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">
                            @(box.Item.FillingCabinet?.Name ?? "Unassigned")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Contents">
                    <CellTemplate Context="box">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Inventory"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenBoxExplorer(box.Item))">
                            @(box.Item.Folders?.Count(f => !f.IsArchived) ?? 0) Folders
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Actions">
                    <CellTemplate  Context="box">

                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       OnClick="@(() => OpenEditDialog(box.Item))" />

                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Archive"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmArchive(box.Item))" />
                    </CellTemplate>
                </TemplateColumn>

            </Columns>

            <PagerContent>
                <MudDataGridPager T="FileBoxes" />
            </PagerContent>

        </MudDataGrid>

    </MudTabPanel>


    <MudTabPanel Text="Archived Boxes" Icon="@Icons.Material.Filled.Archive">

        <MudDataGrid T="FileBoxes"
                     Items="@_boxes.Where(b => b.IsArchived)"
                     Context="archivedBox">

            <ToolBarContent>

                <MudTooltip Text="Export Archived to CSV" Placement="Placement.Top">
                    <MudIconButton Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Icon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => ExportToCSV(true))"
                                   Class="mr-2" />
                </MudTooltip>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Search archived cabinets..." Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />

            </ToolBarContent>
            <Columns>

                <PropertyColumn Property="x => x.Name" Title="Box Name" />
                <TemplateColumn Title="Assigned Cabinet">
                    <CellTemplate Context="archivedBox">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Info" />
                            <MudText Typo="Typo.body2">
                                @(archivedBox.Item.FillingCabinet?.Name ?? "Unassigned/General Storage")
                            </MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ArchivedBy" Title="Archived By" />

                <PropertyColumn Property="x => x.ArchivedAt"
                                Title="Date Archived"
                                Format="MMM dd, yyyy" />

                <TemplateColumn Title="Actions">
                    <CellTemplate Context="archivedBox">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Restore"
                                   OnClick="@(() => UnarchiveBox(archivedBox.Item))">
                            Restore
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>

            </Columns>

        </MudDataGrid>

    </MudTabPanel>

</MudTabs>

@code {
    private List<FileBoxes> _boxes = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadBoxes();
    }

    private async Task LoadBoxes()
    {
        _boxes = await _context.FileBoxes
            .Include(b => b.FillingCabinet)
            .Include(b => b.Folders)
            .ToListAsync();
    }

    private Func<FileBoxes, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (x.FillingCabinet?.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
        if (x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    };

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddBoxDialog>("Add New Box", options);
        if (!(await dialog.Result).Canceled) await LoadBoxes();
    }

    private async Task OpenEditDialog(FileBoxes box)
    {
        var parameters = new DialogParameters { ["BoxToEdit"] = box };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditBoxDialog>("Edit / Move Box", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadBoxes();
    }

    private async Task OpenBoxExplorer(FileBoxes box)
    {
        var parameters = new DialogParameters { ["SelectedBox"] = box };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        await DialogService.ShowAsync<BoxExplorerDialog>($"Contents of  {box.Name}", parameters, options);
    }

    private async Task ConfirmArchive(FileBoxes box)
    {
        if (box.Folders?.Any(f => !f.IsArchived) == true)
        {
            Snackbar.Add($"Cannot archive '{box.Name}'. Move or archive its folders first!", Severity.Error);
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync("Archive Confirmation", $"Are you sure you want to archive '{box.Name}'? You won't be able to add new folders to it while it is archived." , yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            var admin = await _currentUserService.GetCurrentFullNameAsync();
            box.IsArchived = true;
            box.ArchivedAt = DateTime.UtcNow.AddHours(8);
            box.ArchivedBy = admin;

            _context.FileBoxes.Update(box);
            await _context.SaveChangesAsync();
            await LoadBoxes();
            Snackbar.Add("Box archived.", Severity.Success);
        }
    }

    private async Task UnarchiveBox(FileBoxes box)
    {
        // 1. Show Confirmation Dialog
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Restore Box",
            $"Are you sure you want to restore '{box.Name}' to active status?",
            yesText: "Restore",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            try
            {
                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

                var cabinetName = await _context.FileBoxes
                .Where(b => b.Id == box.Id)
                .Select(b => b.FillingCabinet.Name)
                .FirstOrDefaultAsync();

                // 2. Reset Archive Metadata
                box.IsArchived = false;
                box.ArchivedAt = null;
                box.ArchivedBy = null;

                // 3. Create Transaction Log entry
                var log = new TransactionLog
                {
                    FullName = currentAdmin,
                    EventName = "Box Restored",
                    Description = $"Restored box '{box.Name}' back to active status in Cabinet: {cabinetName ?? "Unassigned"}.",
                    Status = "Success",
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                };

                // 4. Update Database context
                _context.FileBoxes.Update(box);
                _context.TransactionLogs.Add(log);
                await _context.SaveChangesAsync();

                // 5. Refresh UI and Notify User
                Snackbar.Add($"Box '{box.Name}' has been restored successfully.", Severity.Success);
                await LoadBoxes(); // This will move the item from the Archived tab to Active tab
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error restoring box: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ExportToCSV(bool exportArchived)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Bpx Name, Cabinet, Description, Status,Date, Archived, Archive By");

        var boxesToExport = _boxes.Where(c => c.IsArchived == exportArchived).ToList();

        foreach(var box in boxesToExport)
        {
            var cabinetName = box.FillingCabinet != null ? box.FillingCabinet.Name : "Unassigned";
            var status = box.IsArchived ? "Archived" : "Active";
            var archivedDate = box.ArchivedAt.HasValue ? box.ArchivedAt.Value.ToString("yyyy-MM-dd") : "";
            var archivedBy = box.ArchivedBy ?? "";
            builder.AppendLine($"\"{box.Name}\",\"{cabinetName}\",\"{box.Description}\",\"{status}\",\"{archivedDate}\",\"{archivedBy}\"");
        }

        string fileName = exportArchived ? $"Archived_Boxes_{DateTime.Now:yyyyMMdd}.csv" : $"Active_Boxes_{DateTime.Now:yyyyMMdd}.csv";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, builder.ToString
       ());

}
}