@page "/storages/boxes"
@attribute [Authorize(Roles = "Admin,Editor")]
@using Microsoft.AspNetCore.Authorization
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using System.Text

@using MIS_FileLocator.Components.Pages.Storages

@inject ApplicationDbContext _context
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService _currentUserService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary">Storage Boxes</MudText>

@* ── Toolbar above tabs ── *@
<MudPaper Outlined="true" Class="pa-3 mb-3">
    <div class="page-toolbar">
        <div class="toolbar-actions">
            @if (_activeTab == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                    Add Box
                </MudButton>
            }
            <MudIconButton Variant="Variant.Outlined" Color="Color.Success"
                           Icon="@Icons.Material.Filled.Print"
                           OnClick="@(() => ExportToCSV(_activeTab == 1))" />
        </div>
        <div class="toolbar-filters">
            <MudSelect T="string" @bind-Value="_selectedCabinet" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Label="Filter Cabinet"
                       AdornmentIcon="@Icons.Material.Filled.FilterList">
                <MudSelectItem Value="@("")">All Cabinets</MudSelectItem>
                @if (_cabinetNames != null)
                {
                    @foreach (var name in _cabinetNames)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudTextField @bind-Value="_searchString" Placeholder="Search..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </div>
</MudPaper>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" SliderColor="Color.Primary">

    <MudTabPanel Text="Active Boxes" Icon="@Icons.Material.Filled.Inventory">
        <MudDataGrid T="FileBoxes"
                     Items="@(_boxes?.Where(b => !b.IsArchived) ?? Enumerable.Empty<FileBoxes>())"
                     QuickFilter="@_quickFilter"
                     Dense="false"
                     Hover="true"
                     Breakpoint="Breakpoint.Sm">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Box Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <TemplateColumn Title="Cabinet">
                    <CellTemplate>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">
                            @(context.Item.FillingCabinet?.Name ?? "Unassigned")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" CellStyle="text-align:;">
                    <CellTemplate>
                        <MudStack Spacing="1" Row="true" AlignItems="AlignItems.Center">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Archive" Color="Color.Error" OnClick="@(() => ConfirmArchive(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FileBoxes" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>


    @* --- ARCHIVED BOXES PANEL --- *@
    <MudTabPanel Text="Archived Boxes" Icon="@Icons.Material.Filled.Archive">
        <MudDataGrid T="FileBoxes"
                     Items="@(_boxes?.Where(b => b.IsArchived) ?? Enumerable.Empty<FileBoxes>())"
                     QuickFilter="@_quickFilter"
                     Dense="false"
                     Hover="true"
                     Breakpoint="Breakpoint.Sm">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Box Name" />
                <PropertyColumn Property="x => x.ArchivedBy" Title="Archived By" />
                <PropertyColumn Property="x => x.ArchivedAt" Title="Date Archived" Format="MMM dd, yyyy" />
                <TemplateColumn Title="Actions" HeaderStyle="text-align: right;" CellStyle="text-align:;">
                    <CellTemplate>
                        <MudStack Spacing="2" Row="true" AlignItems="AlignItems.Center">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Restore" OnClick="@(() => UnarchiveBox(context.Item))">
                            Restore
                        </MudButton>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent><MudDataGridPager T="FileBoxes" /></PagerContent>
        </MudDataGrid>
    </MudTabPanel>

</MudTabs>

@code {
    private List<FileBoxes> _boxes = new();
    private List<string> _cabinetNames = new();
    private string _searchString = "";
    private string _selectedCabinet = "";
    private int _activeTab = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoxes();
    }

    private async Task LoadBoxes()
    {
        _boxes = await _context.FileBoxes
            .Include(b => b.FillingCabinet)
            .Include(b => b.Folders)
            .ToListAsync();

        _cabinetNames = _boxes
        .Where(b => b.FillingCabinet != null)
        .Select(b =>b.FillingCabinet!.Name)
        .Distinct()
        .OrderBy(name => name)
        .ToList()
        ;

        StateHasChanged();

    }

    private Func<FileBoxes, bool> _quickFilter => x =>
{
   
    if (!string.IsNullOrWhiteSpace(_selectedCabinet))
    {
        if (_selectedCabinet == "Unassigned")
        {
            if (x.FillingCabinet != null) return false;
        }
        else if (x.FillingCabinet?.Name != _selectedCabinet)
        {
            return false;
        }
    }

   
    if (!string.IsNullOrWhiteSpace(_searchString))
    {
        bool matchesName = x.Name?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false;
        bool matchesDesc = x.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false;
        
        // Return true only if it matches name OR description
        if (matchesName || matchesDesc) return true;
        
        return false;
    }

    return true;
};

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddBoxDialog>("Add New Box", options);
        if (!(await dialog.Result).Canceled) await LoadBoxes();
    }

    private async Task OpenEditDialog(FileBoxes box)
    {
        var parameters = new DialogParameters { ["BoxToEdit"] = box };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditBoxDialog>("Edit / Move Box", parameters, options);
        if (!(await dialog.Result).Canceled) await LoadBoxes();
    }

    private async Task OpenBoxExplorer(FileBoxes box)
    {
        var parameters = new DialogParameters { ["SelectedBox"] = box };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        await DialogService.ShowAsync<BoxExplorerDialog>($"Contents of  {box.Name}", parameters, options);
    }

    private async Task ConfirmArchive(FileBoxes box)
    {
        if (box.Folders?.Any(f => !f.IsArchived) == true)
        {
            Snackbar.Add($"Cannot archive '{box.Name}'. Move or archive its folders first!", Severity.Error);
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync("Archive Confirmation", $"Are you sure you want to archive '{box.Name}'? You won't be able to add new folders to it while it is archived." , yesText: "Archive", cancelText: "Cancel");
        if (result == true)
        {
            var admin = await _currentUserService.GetCurrentFullNameAsync();
            box.IsArchived = true;
            box.ArchivedAt = DateTime.UtcNow.AddHours(8);
            box.ArchivedBy = admin;

            _context.FileBoxes.Update(box);
            await _context.SaveChangesAsync();
            await LoadBoxes();
            Snackbar.Add("Box archived.", Severity.Success);
        }
    }

    private async Task UnarchiveBox(FileBoxes box)
    {
        // 1. Show Confirmation Dialog
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Restore Box",
            $"Are you sure you want to restore '{box.Name}' to active status?",
            yesText: "Restore",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            try
            {
                var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();

                var cabinetName = await _context.FileBoxes
                .Where(b => b.Id == box.Id)
                .Select(b => b.FillingCabinet.Name)
                .FirstOrDefaultAsync();

                // 2. Reset Archive Metadata
                box.IsArchived = false;
                box.ArchivedAt = null;
                box.ArchivedBy = null;

                // 3. Create Transaction Log entry
                var log = new TransactionLog
                {
                    FullName = currentAdmin,
                    EventName = "Box Restored",
                    Description = $"Restored box '{box.Name}' back to active status in Cabinet: {cabinetName ?? "Unassigned"}.",
                    Status = "Success",
                    PerformedAt = DateTime.UtcNow.AddHours(8)
                };

                // 4. Update Database context
                _context.FileBoxes.Update(box);
                _context.TransactionLogs.Add(log);
                await _context.SaveChangesAsync();

                // 5. Refresh UI and Notify User
                Snackbar.Add($"Box '{box.Name}' has been restored successfully.", Severity.Success);
                await LoadBoxes(); // This will move the item from the Archived tab to Active tab
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error restoring box: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ExportToCSV(bool exportArchived)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Bpx Name, Cabinet, Description, Status,Date, Archived, Archive By");

        var boxesToExport = _boxes.Where(c => c.IsArchived == exportArchived).ToList();

        foreach(var box in boxesToExport)
        {
            var cabinetName = box.FillingCabinet != null ? box.FillingCabinet.Name : "Unassigned";
            var status = box.IsArchived ? "Archived" : "Active";
            var archivedDate = box.ArchivedAt.HasValue ? box.ArchivedAt.Value.ToString("yyyy-MM-dd") : "";
            var archivedBy = box.ArchivedBy ?? "";
            builder.AppendLine($"\"{box.Name}\",\"{cabinetName}\",\"{box.Description}\",\"{status}\",\"{archivedDate}\",\"{archivedBy}\"");
        }

        string fileName = exportArchived ? $"Archived_Boxes_{DateTime.Now:yyyyMMdd}.csv" : $"Active_Boxes_{DateTime.Now:yyyyMMdd}.csv";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, builder.ToString
       ());

}
}