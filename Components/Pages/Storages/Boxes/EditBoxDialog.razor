@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService

<MudDialog>
    <DialogContent>
        <EditForm Model="_editBox" OnValidSubmit="SaveUpdates">
            <DataAnnotationsValidator />

           
            <MudSelect T="int" Label="Current Cabinet" @bind-Value="_editBox.FillingCabinetId"
                       Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" HelperText="Change this to move the box to another cabinet" Class="mb-3">
                @foreach (var cab in _activeCabinets)
                {
                    <MudSelectItem Value="@cab.Id">@cab.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_editBox.Name" Label="Box Name" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_editBox.Description" Label="Description" Variant="Variant.Outlined" Lines="3" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates" Disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!; //DIALOG CONTROLLER
    [Parameter] public FileBoxes BoxToEdit { get; set; } = default!; // assign selected box from parent to BoxToEDIT
    private FileBoxes _editBox = new();
    private List<FillingCabinet> _activeCabinets = new();
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _editBox.Id = BoxToEdit.Id;
        _editBox.Name = BoxToEdit.Name;
        _editBox.Description = BoxToEdit.Description;
        _editBox.FillingCabinetId = BoxToEdit.FillingCabinetId;
        _activeCabinets = await db.FillingCabinets.Where(c => !c.IsArchived).ToListAsync();
    }

    private async Task SaveUpdates()
    {
        if (_isSaving) return;
        if (string.IsNullOrWhiteSpace(_editBox.Name)) { Snackbar.Add("Box name is required.", Severity.Error); return; }

        _editBox.Name = _editBox.Name.Trim();

        // Detect changes
        var changes = new List<string>();
        if (!string.Equals(BoxToEdit.Name, _editBox.Name, StringComparison.OrdinalIgnoreCase))
            changes.Add($"Name: '{BoxToEdit.Name}' → '{_editBox.Name}'");
        if ((BoxToEdit.Description ?? "") != (_editBox.Description ?? ""))
            changes.Add("Description updated");
        if (BoxToEdit.FillingCabinetId != _editBox.FillingCabinetId)
            changes.Add("Moved to a different cabinet");

        if (!changes.Any())
        {
            Snackbar.Add("No changes were made.", Severity.Info);
            MudDialog.Cancel();
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var nameLower = _editBox.Name.ToLower();
            var existingNames = await db.FileBoxes
                .Where(b => b.FillingCabinetId == _editBox.FillingCabinetId && b.Id != _editBox.Id && !b.IsArchived)
                .Select(b => b.Name)
                .ToListAsync();

            if (existingNames.Any(n => n.Trim().ToLower() == nameLower))
            {
                Snackbar.Add($"A box named '{_editBox.Name}' already exists in this cabinet.", Severity.Error);
                return;
            }

            var realBox = await db.FileBoxes.FindAsync(_editBox.Id);
            if (realBox == null) return;

            bool isMoving = realBox.FillingCabinetId != _editBox.FillingCabinetId;
            realBox.Name = _editBox.Name;
            realBox.Description = _editBox.Description;
            realBox.FillingCabinetId = _editBox.FillingCabinetId;

            var cabinetName = await db.FillingCabinets
                .Where(c => c.Id == _editBox.FillingCabinetId)
                .Select(c => c.Name)
                .FirstOrDefaultAsync();

            var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
            db.TransactionLogs.Add(new TransactionLog
            {
                FullName = currentAdmin,
                EventName = isMoving ? "Box Moved" : "Box Updated",
                Description = isMoving
                    ? $"Box '{BoxToEdit.Name}' moved to Cabinet '{cabinetName}'"
                    : $"Box '{BoxToEdit.Name}': {string.Join(" | ", changes)}",
                Status = "Success", PerformedAt = DateTime.UtcNow.AddHours(8)
            });
            db.CurrentUserOverride = currentAdmin;
            await db.SaveChangesAsync();
            Snackbar.Add("Box updated successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; StateHasChanged(); }
    }

    private void Cancel() { if (!_isSaving) MudDialog.Cancel(); }
}