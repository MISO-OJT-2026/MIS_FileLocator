    // ── Export ──
    private async Task ExportCSV(bool archived)
    {
        var sb = new StringBuilder();
        sb.AppendLine("Type,Name,Location,Status,Archived By,Date Archived");
        foreach (var c in _cabinets.Where(x => x.IsArchived == archived))
            sb.AppendLine($"Cabinet,\"{c.Name}\",—,{(archived ? "Archived" : "Active")},\"{c.ArchivedBy ?? ""}\",\"{c.ArchivedAt?.ToString("MMM dd, yyyy") ?? ""}\"");
        foreach (var b in _boxes.Where(x => x.IsArchived == archived))
            sb.AppendLine($"Box,\"{b.Name}\",\"{b.FillingCabinet?.Name ?? ""}\",{(archived ? "Archived" : "Active")},\"{b.ArchivedBy ?? ""}\",\"{b.ArchivedAt?.ToString("MMM dd, yyyy") ?? ""}\"");
        foreach (var f in _folders.Where(x => x.IsArchived == archived))
            sb.AppendLine($"Folder,\"{f.Name}\",\"{f.FileBox?.Name ?? ""} > {f.FileBox?.FillingCabinet?.Name ?? ""}\",{(archived ? "Archived" : "Active")},\"{f.ArchivedBy ?? ""}\",\"{f.ArchivedAt?.ToString("MMM dd, yyyy") ?? ""}\"");
        await JSRuntime.InvokeVoidAsync("downloadFile", $"{(archived ? "Archived" : "Active")}_Storage_{DateTime.Now:yyyyMMdd}.csv", sb.ToString());
    }
