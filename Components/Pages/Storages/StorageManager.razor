    // ── Archive ──
    private async Task ArchiveCabinet(FillingCabinet cabinet)
    {
        if (cabinet.FileBox?.Any(b => !b.IsArchived) == true)
        { Snackbar.Add("Move or archive all boxes first.", Severity.Error); return; }
        bool? r = await DialogService.ShowMessageBoxAsync("Archive Cabinet", $"Archive '{cabinet.Name}'?", yesText: "Archive", cancelText: "Cancel");
        if (r != true) return;
        var admin = await _currentUserService.GetCurrentFullNameAsync();
        cabinet.IsArchived = true; cabinet.ArchivedAt = DateTime.UtcNow.AddHours(8); cabinet.ArchivedBy = admin;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.FillingCabinets.Update(cabinet); db.CurrentUserOverride = admin;
        db.TransactionLogs.Add(new TransactionLog { FullName = admin, EventName = "Cabinet Archived", Description = $"Archived '{cabinet.Name}'.", Status = "Warning", PerformedAt = DateTime.UtcNow.AddHours(8) });
        await db.SaveChangesAsync(); await LoadAll();
        Snackbar.Add("Cabinet archived.", Severity.Success);
    }

