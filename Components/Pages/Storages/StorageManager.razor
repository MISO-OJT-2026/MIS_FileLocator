    private async Task ArchiveFolder(Folder folder)
    {
        if (folder.Documents?.Any(d => !d.IsDeleted) == true)
        { Snackbar.Add("Move or archive all documents first.", Severity.Error); return; }
        bool? r = await DialogService.ShowMessageBoxAsync("Archive Folder", $"Archive '{folder.Name}'?", yesText: "Archive", cancelText: "Cancel");
        if (r != true) return;
        var admin = await _currentUserService.GetCurrentFullNameAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Folders.Where(f => f.Id == folder.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(f => f.IsArchived, true)
                .SetProperty(f => f.ArchivedAt, DateTime.UtcNow.AddHours(8))
                .SetProperty(f => f.ArchivedBy, admin));
        await LoadAll();
        Snackbar.Add("Folder archived.", Severity.Success);
    }

