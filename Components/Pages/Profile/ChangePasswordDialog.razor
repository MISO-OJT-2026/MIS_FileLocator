@using System.Text.RegularExpressions
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject MIS_FileLocator.Services.ICurrentUserService _currentUserService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                Security verification for Employee ID: <b>@_inputEmployeeId</b>
            </MudAlert>

            <MudTextField @bind-Value="_inputEmployeeId" Label="Confirm Employee ID"
                          Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" />

            <MudTextField @bind-Value="_currentPassword" Label="Current Password"
                          InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined" Required="true" Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showCurrent = !_showCurrent)" />

            <MudDivider Class="my-2" />

            <MudTextField @bind-Value="_newPassword" Label="New Password"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showNew = !_showNew)" />

            @* --- PASSWORD STRENGTH METER --- *@
            <div>
                <MudProgressLinear Color="@GetStrengthColor()" Value="@_strengthScore"
                                   Size="Size.Small" SecondaryColor="Color.Inherit" />
                <div class="d-flex justify-space-between mt-1">
                    <MudText Typo="Typo.caption" Color="@GetStrengthColor()">
                        <b>Strength: @GetStrengthText()</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_strengthScore%</MudText>
                </div>
            </div>

            <MudTextField @bind-Value="_confirmPassword" Label="Confirm New Password"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined" Required="true" Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                          Error="@(_newPassword != _confirmPassword && !string.IsNullOrEmpty(_confirmPassword))"
                          ErrorText="Passwords do not match" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_strengthScore < 75 || _newPassword != _confirmPassword || _isProcessing)"
                   OnClick="SubmitChange">Update Password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private string _inputEmployeeId = "", _currentPassword = "", _newPassword = "", _confirmPassword = "";
    private bool _isProcessing = false;
    private bool _showCurrent = false, _showNew = false, _showConfirm = false;

    // --- STRENGTH LOGIC ---
    private int _strengthScore => CalculateStrength();

    private int CalculateStrength()
    {
        if (string.IsNullOrEmpty(_newPassword)) return 0;
        int score = 0;
        if (_newPassword.Length >= 8) score += 25;
        if (Regex.IsMatch(_newPassword, @"[A-Z]")) score += 25;
        if (Regex.IsMatch(_newPassword, @"[0-9]")) score += 25;
        if (Regex.IsMatch(_newPassword, @"[^a-zA-Z0-9]")) score += 25;
        return score;
    }

    private Color GetStrengthColor() => _strengthScore switch
    {
        <= 25 => Color.Error,
        50 => Color.Warning,
        75 => Color.Info,
        _ => Color.Success
    };

    private string GetStrengthText() => _strengthScore switch
    {
        <= 25 => "Very Weak",
        50 => "Weak",
        75 => "Good",
        _ => "Strong"
    };

    private async Task SubmitChange()
    {
        _isProcessing = true;
        var internalId = await _currentUserService.GetCurrentUserIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.Users.FirstOrDefaultAsync(u => u.Id == internalId);
		

        if (user == null || user.EmployeeId != _inputEmployeeId)
        {
            Snackbar.Add("Verification failed: Employee ID mismatch.", Severity.Error);
            _isProcessing = false;
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, _currentPassword, _newPassword);

        if (result.Succeeded)
        {
			
            db.TransactionLogs.Add(new TransactionLog
            {
                FullName = user.FullName,
                EventName = "Security Update",
                Description = $"User {user.EmployeeId} changed their password.",
                Status = "Success",
                PerformedAt = DateTime.UtcNow.AddHours(8)
            });
            await db.SaveChangesAsync();

            Snackbar.Add("Password updated! Please log in again with your new credentials.", Severity.Success);

            MudDialog.Close(DialogResult.Ok(true));

            
            Nav.NavigateTo("/profile", forceLoad: true);
        }
        else
        {
            foreach (var err in result.Errors) Snackbar.Add(err.Description, Severity.Error);
        }
        _isProcessing = false;
    }

    private void Cancel() => MudDialog.Cancel();
}