@page "/"
@page "/dashboard"
@using MudBlazor
@using MudBlazor.Charts
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using System.Text.RegularExpressions
@using System.Globalization
@rendermode InteractiveServer

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject ICurrentUserService CurrentUser
@inject IRoleService RoleService

<MudStack Spacing="4" Class="pa-4">
    @if (_loading)
    {
        <MudPaper Class="pa-12 d-flex flex-column glass-midnight align-center justify-center" Elevation="0" Style="background:transparent; min-height: 400px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Primary">Loading records...</MudText>
        </MudPaper>
    }
    else
    {
        @* Hero Section - Uses MudBlazor text colors for Dark Mode compatibility *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-8 glass-midnight rounded-xl border-solid border-2 mud-border-primary">
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 700;">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</MudText>
            <MudText Typo="Typo.h3" Style="font-weight: 800;" Class="mud-text-primary">Hello, @_greetingName</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Welcome back to the MIS File Locator System.</MudText>
        </MudPaper>

        <MudGrid Spacing="3">
            @* Stat Tiles *@
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Filing cabinets" Value="@_cabinets.ToString()" Icon="@Icons.Material.Filled.Inventory2" Href="/storages/cabinets" Background="var(--mud-palette-primary)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Filing boxes" Value="@_boxes.ToString()" Icon="@Icons.Material.Filled.Archive" Href="/storages/boxes" Background="#b42318" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Folders" Value="@_folders.ToString()" Icon="@Icons.Material.Filled.Folder" Href="/storages/folders" Background="#7b6ab3" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Active documents" Value="@_activeDocuments.ToString()" Icon="@Icons.Material.Filled.Description" Href="/documentsPage" Background="#3a6351" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Pending disposal" Value="@_pendingForSelectedYear.ToString()" Icon="@Icons.Material.Filled.HourglassTop" Href="/disposed" Background="#7d1c1c" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Total users" Value="@_totalUsers.ToString()" Icon="@Icons.Material.Filled.People" Href="/admin/users" Background="#0e1824" />
            </MudItem>

            @* Disposal Trend *@
            <MudItem xs="12" lg="8">
                <MudPaper Outlined="true" Class="pa-6 pb-10 rounded-xl h-100">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mud-text-primary">Disposal Trend</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-4 d-block">Activity vs. Disposals (Last 6 Years)</MudText>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_series"
                              ChartLabels="@_xAxisLabels" 
                              Width="100%"
                              Height="500px"
                              CanHideSeries="true"
                              ChartOptions="@_chartOptions"
                              ChartPalette="@(new[] { "#5eb5f7", "#f87171" })" />
                </MudPaper>
            </MudItem>

            @* Top 5 Contributors *@
            <MudItem xs="12" lg="4">
                <MudPaper Outlined="true" Class="pa-6 glass-midnight rounded-xl h-100">
                    <MudText Typo="Typo.h6" Class="mb-4 mud-text-primary" Style="font-weight: 700;">Top 5 Contributors</MudText>
                    <MudStack Spacing="2">
                        @foreach (var c in _topContributors)
                        {
                            <div class="d-flex align-center gap-3 py-2">
                                <MudAvatar Color="Color.Primary" Size="Size.Medium" Variant="Variant.Filled">@GetInitials(c.Name)</MudAvatar>
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;" Class="mud-text-primary">@c.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Success">@c.Count actions recorded</MudText>
                                </div>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Disposal Progress *@
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-6 glass-midnightrounded-xl h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mud-text-primary">Disposal Progress</MudText>
                        <MudSelect T="int" Value="_selectedDisposalYear" ValueChanged="OnDisposalYearChanged" Dense="true" Variant="Variant.Outlined" Style="width:120px;">
                            @foreach (var y in _yearChoices)
                            {
                                <MudSelectItem Value="y">@y</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    <div class="mt-8">
                        
                        @{
                            var status = GetDisposalStatus();
                        }

                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle2" Class="mud-text-primary">
                                Year Compliance: <b>@GetPipelinePercent().ToString("F0")%</b>
                            </MudText>
                            <MudChip T="string"
                                     Variant="Variant.Text"
                                     Color="@status.Color"
                                     Size="Size.Small"
                                     Icon="@status.Icon"
                                     Style="font-weight: 700;">
                                @status.Text
                            </MudChip>
                        </MudStack>
                        <MudProgressLinear Color="Color.Primary" Size="Size.Large" Value="@GetPipelinePercent()" Rounded="true" />
                        <div class="d-flex justify-space-between mt-2">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_disposedInSelectedYear Disposed</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Target: @_totalPipelineYear</MudText>
                        </div>
                    </div>
 
                </MudPaper>
            </MudItem>

            @* Recent Activity *@
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-6 rounded-xl h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mud-text-primary">Recent Activity</MudText>
                        <MudButton Href="/transaction-logs" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">View Log</MudButton>
                    </MudStack>
                    <div style="max-height: 350px; overflow-y: auto;" class="no-scrollbar">
                        <MudTimeline TimelinePosition="TimelinePosition.Start">
                            @foreach (var log in _activityFeed.Take(8))
                            {
                                var line = GetActivityDisplay(log);
                                <MudTimelineItem Color="Color.Info" Size="Size.Small">
                                    <MudText Typo="Typo.body2" Class="mud-text-primary"><b>@line.Name</b> @line.Phrase "@line.Title"</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@line.PerformedAt.ToString("MMM dd, h:mm tt")</MudText>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private bool _loading = true;
    private string _greetingName = "there";
    private int _cabinets, _boxes, _folders, _activeDocuments, _totalUsers;
    private int _pendingForSelectedYear, _disposedInSelectedYear, _totalPipelineYear, _selectedDisposalYear;
    private List<int> _yearChoices = new();
    private List<TransactionLog> _activityFeed = new();
    private List<ContributorRow> _topContributors = new();
    private readonly Dictionary<string, string> _employeeDisplayByKey = new(StringComparer.OrdinalIgnoreCase);

    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = { };
    private LineChartOptions _chartOptions = new()
    {
        XAxisTitle = "Year",
        XAxisLabelRotation = 45,
        LineStrokeWidth = 3,
    };

    protected override async Task OnInitializedAsync()
    {


       
        _selectedDisposalYear = DateTime.Now.Year;
        await LoadAsync();
        _selectedDisposalYear = DateTime.Now.Year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var now = DateTime.Now;

        var fullName = await CurrentUser.GetCurrentFullNameAsync();
        _greetingName = GetFirstName(fullName);

        var users = await UserManager.Users.AsNoTracking().ToListAsync();
        BuildEmployeeNameLookup(users);

        _cabinets = await Db.FillingCabinets.CountAsync();
        _boxes = await Db.FileBoxes.CountAsync();
        _folders = await Db.Folders.CountAsync();
        _activeDocuments = await Db.Documents.CountAsync(d => !d.IsDeleted && !d.IsDisposal);
        _totalUsers = users.Count;

        _yearChoices = Enumerable.Range(now.Year - 10, 15).ToList();

        // CHART DATA
        var labels = new List<string>();
        var disposalData = new List<double>();
        var activeData = new List<double>();

        for (var i = 0; i < 6; i++)
        {
            var year = now.Year - 5 + i;
            labels.Add(year.ToString());
            var ys = new DateTime(year, 1, 1); var ye = ys.AddYears(1);
            disposalData.Add(await Db.Documents.CountAsync(d => d.IsDisposal && !d.IsDeleted && d.DateOfDisposal >= ys && d.DateOfDisposal < ye));
            activeData.Add(await Db.Documents.CountAsync(d => !d.IsDeleted && !d.IsDisposal && d.FiledAt >= ys && d.FiledAt < ye));
        }

        _xAxisLabels = labels.ToArray();
        _series = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "New Filing", Data = activeData.ToArray() },
            new ChartSeries<double> { Name = "Official Disposals", Data = disposalData.ToArray() }
        };

        var topRaw = await Db.TransactionLogs.AsNoTracking()
            .Where(t => !string.IsNullOrEmpty(t.FullName))
            .GroupBy(t => t.FullName!)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count).Take(5).ToListAsync();

        _topContributors = topRaw.Select(x => new ContributorRow(ResolveEmployeeName(x.Name), x.Count)).ToList();
        _activityFeed = await Db.TransactionLogs.AsNoTracking().OrderByDescending(t => t.PerformedAt).Take(15).ToListAsync();

        await LoadDisposalYearDataAsync();
        _loading = false;
    }

    private async Task OnDisposalYearChanged(int year) { _selectedDisposalYear = year; await LoadDisposalYearDataAsync(); }

    private async Task LoadDisposalYearDataAsync()
    {
        var y = _selectedDisposalYear; var now = DateTime.Now; var ys = new DateTime(y, 1, 1); var ye = ys.AddYears(1);
        _disposedInSelectedYear = await Db.Documents.CountAsync(d => d.IsDisposal && !d.IsDeleted && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _totalPipelineYear = await Db.Documents.CountAsync(d => !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _pendingForSelectedYear = await Db.Documents.CountAsync(d => !d.IsDisposal && !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye && d.DateOfDisposal <= now);
    }

    private int _outstandingPipeline => Math.Max(0, _totalPipelineYear - _disposedInSelectedYear);


    private double GetPipelinePercent() => _totalPipelineYear <= 0 ? 0 : Math.Min(100, (double)_disposedInSelectedYear / _totalPipelineYear * 100.0);

    private (string Text, Color Color, string Icon) GetDisposalStatus()
    {
        var pct = GetPipelinePercent();
        if (pct >= 100) return ("Fully Compliant", Color.Info, Icons.Material.Filled.CheckCircle);
        if (pct >= 80) return ("Almost Complete", Color.Success, Icons.Material.Filled.TrendingUp);
        if (pct >= 40) return ("On Track", Color.Warning, Icons.Material.Filled.Assessment);
        return ("Action Required", Color.Error, Icons.Material.Filled.Error);
    }
    private static string GetFirstName(string? n) => string.IsNullOrWhiteSpace(n) ? "there" : n.Trim().Split(' ')[0];

    private ActivityLine GetActivityDisplay(TransactionLog log) => new ActivityLine(ResolveEmployeeName(log.FullName), ExtractQuotedTitle(log.Description), MapEventToPhrase(log.EventName), "", log.PerformedAt);


    private static string? ExtractQuotedTitle(string? d) 
    {
        
        if (string.IsNullOrEmpty(d)) return null; var m = Regex.Match(d, @"'([^']*)'"); return m.Success ? m.Groups[1].Value : null;
    }


    private static string MapEventToPhrase(string e) => e switch 
    {
        "Document Disposed" => "disposed of", "Document Created" => "filed", _ => e.ToLower() 
    };
    private void BuildEmployeeNameLookup(IEnumerable<ApplicationUser> users) 
    {
        foreach (var u in users) _employeeDisplayByKey[u.FullName ?? u.UserName!] = u.FullName ?? u.UserName!; 
    }
    private string ResolveEmployeeName(string? r) => string.IsNullOrEmpty(r) ? "System" : _employeeDisplayByKey.GetValueOrDefault(r, r);

    private static string GetInitials(string n) => string.IsNullOrEmpty(n) ? "?" : string.Join("", n.Split(' ').Select(x => x[0])).ToUpper();

    private record ActivityLine(string Name, string? Title, string Phrase, string Fallback, DateTime PerformedAt);


    private record ContributorRow(string Name, int Count);
}