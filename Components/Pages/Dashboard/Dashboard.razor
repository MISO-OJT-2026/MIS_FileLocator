@page "/dashboard"
@attribute [Authorize(Roles = "Admin,Editor")]
@using MudBlazor
@using MudBlazor.Charts
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using System.Globalization
@rendermode InteractiveServer

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject ICurrentUserService CurrentUser
@inject IRoleService RoleService


<MudStack Spacing="4" Class="pa-4 pa-md-6">
    @if (_loading)
    {
        <MudPaper Class="pa-12 glass-midnight d-flex flex-column align-center justify-center" Elevation="0" Style="background:transparent; min-height: 400px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Primary">Optimizing your view...</MudText>
        </MudPaper>
    }
    else
    {
        @* HERO SECTION *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-6 glass-midnight rounded-xl border-solid border-2 mud-border-primary">
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 700;">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mud-text-primary">Hello, @_greetingName</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Welcome back to the MIS File Locator System.</MudText>
        </MudPaper>

        <MudGrid Spacing="3">
            @* STAT TILES - 2 per row on mobile, 6 across on desktop *@
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Cabinets" Value="@_cabinets.ToString()" Icon="@Icons.Material.Filled.Inventory2" Href="/storages/cabinets" Background="var(--mud-palette-primary)" />
            </MudItem>
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Boxes" Value="@_boxes.ToString()" Icon="@Icons.Material.Filled.Archive" Href="/storages/boxes" Background="#b42318" />
            </MudItem>
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Folders" Value="@_folders.ToString()" Icon="@Icons.Material.Filled.Folder" Href="/storages/folders" Background="#7b6ab3" />
            </MudItem>
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Documents" Value="@_activeDocuments.ToString()" Icon="@Icons.Material.Filled.Description" Href="/documentsPage" Background="#3a6351" />
            </MudItem>
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Pending" Value="@_pendingForSelectedYear.ToString()" Icon="@Icons.Material.Filled.HourglassTop" Href="/disposed" Background="#7d1c1c" />
            </MudItem>
            <MudItem xs="6" sm="6" md="2">
                <SolidStatTile Title="Users" Value="@_totalUsers.ToString()" Icon="@Icons.Material.Filled.People" Href="/admin/users" Background="#0e1824" />
            </MudItem>

            @* TREND CHART - scrollable on mobile *@
            <MudItem xs="12" lg="8">
                <MudPaper Outlined="true" Class="pa-6 glass-midnight rounded-xl h-100">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mud-text-primary">Disposal Trend</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-4 d-block">Activity vs. Disposals (Last 6 Years)</MudText>
                    @* Horizontal scroll wrapper on mobile so chart keeps its size *@
                    <div class="chart-scroll-wrapper">
                        <div class="chart-inner">
                            <MudChart ChartType="ChartType.Line"
                                      ChartSeries="@_series"
                                      ChartLabels="@_xAxisLabels"
                                      Width="100%"
                                      Height="380px"
                                      CanHideSeries="true"
                                      ChartOptions="@_chartOptions"
                                      ChartPalette="@(new[] { "#5eb5f7", "#f87171" })" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            @* CIRCULATION - The "Donut" *@
            <MudItem xs="12" lg="4">
                <MudPaper Outlined="true" Class="pa-6 rounded-xl h-100 glass-midnight d-flex flex-column">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">File Circulation</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Yearly storage overview
                            </MudText>
                        </div>
                        <MudSpacer/>
                        <div style="min-width:120px">
                        <MudSelect T="int"
                                   Value="_selectedCirculationYear"
                                   ValueChanged="OnCirculationYearChanged"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Style="min-width:120px">
                            @foreach (var y in _yearChoices)
                            {
                                <MudSelectItem Value="@y">@y</MudSelectItem>
                            }
                        </MudSelect>
                        </div>
                    </div>

                    @* DONUT CHART WITH TOOLTIP *@
                    <div class="d-flex justify-center align-center" style="height: 200px; width: 100%;">
                        <MudTooltip Text="@($"{_totalBorrowed} Borrowed, {_totalDocsForSelectedYear - _totalBorrowed} In Storage")">
                            <div class="circulation-donut" style="@GetBorrowDonutStyle()">
                                <div class="circulation-donut-center">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Borrowed</MudText>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@($"{_borrowedPercent:F0}%")</MudText>
                                </div>
                            </div>
                        </MudTooltip>
                       
                    </div>
                    <div class="d-flex justify-center mt-3 gap-4">
                        <div class="d-flex align-center gap-1">
                            <div style="width:10px;height:10px;background:#f59e0b;border-radius:50%;"></div>
                            <MudText Typo="Typo.caption">Borrowed</MudText>
                        </div>

                        <div class="d-flex align-center gap-1">
                            <div style="width:10px;height:10px;background:#1f2937;border-radius:50%;"></div>
                            <MudText Typo="Typo.caption">In Storage</MudText>
                        </div>
                    </div>
                    @* COMPLIANCE BAR *@
                    <MudStack Spacing="1" Class="mt-4">
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.body2" Style="font-size: 0.8rem;">Return Compliance</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success" Style="font-weight: 700;">@_returnRate%</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Success" Value="@_returnRate" Size="Size.Small" Rounded="true" />
                    </MudStack>

                    @* OVERDUE HIGHLIGHTS - This fills the white space *@
                    <div class="mt-6 flex-grow-1">
                        <MudText Typo="Typo.overline" Style="font-weight: 700; color: #b42318; letter-spacing: 1px;">OVERDUE HIGHLIGHTS</MudText>

                        <div style="max-height: 180px; overflow-y: auto;" class="no-scrollbar mt-2">
                            @if (_overdueItems.Any())
                            {
                                <MudStack Spacing="2">
                                    @foreach (var item in _overdueItems.Take(3))
                                    {
                                        <div class="pa-3 rounded-lg" style="background: rgba(180, 35, 24, 0.1); border-left: 4px solid #b42318;">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@item.Title</MudText>
                                                <MudText Typo="Typo.caption" Style="color: #b42318; font-weight: 800;">LATE</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">Borrowed by: @item.Borrower</MudText>
                                            <MudText Typo="Typo.caption" Style="font-style: italic;">Due: @item.DueDate.ToString("MMM dd yyyy")</MudText>
                                        </div>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-center justify-center py-4" style="border: 2px dashed rgba(0,0,0,0.05); border-radius: 12px;">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Medium" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">All borrowed files are on track.</MudText>
                                </div>
                            }
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

            @* BOTTOM ROW: THREE EQUAL COLUMNS *@
            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="pa-6 glass-midnight rounded-xl h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6" Style="font-weight:700;">Disposal Progress</MudText>
                        <MudSelect T="int" Value="_selectedDisposalYear" ValueChanged="OnDisposalYearChanged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px;">
                        
                            
                            @foreach (var y in _yearChoices)
                            {
                                <MudSelectItem Value="y">@y</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Year Compliance: <b>@GetPipelinePercent().ToString("F0")%</b></MudText>
                    <MudProgressLinear Color="Color.Primary" Size="Size.Large" Value="@GetPipelinePercent()" Rounded="true" Class="mb-2" />
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption">@_disposedInSelectedYear Disposed</MudText>
                        <MudText Typo="Typo.caption">Target: @_totalPipelineYear</MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="pa-6 glass-midnight rounded-xl h-100">
                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight:700;">Top Contributors</MudText>
                    <MudStack Spacing="1">
                        @foreach (var c in _topContributors)
                        {
                            <div class="d-flex align-center gap-3 py-1">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">@GetInitials(c.Name)</MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@c.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Success">@c.Count Actions</MudText>
                                </div>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Outlined="true" Class="pa-6 glass-midnight rounded-xl h-100">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Recent Activity</MudText>
                        <MudButton Href="/transaction-logs" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">View All</MudButton>
                    </div>
                    <div style="max-height: 250px; overflow-y: auto;" class="no-scrollbar">
                        <MudTimeline TimelinePosition="TimelinePosition.Start" Dense="true">
                            @foreach (var log in _activityFeed.Take(15))
                            {
                                var line = GetActivityDisplay(log);
                                <MudTimelineItem Color="Color.Info" Size="Size.Small">
                                    <MudText Typo="Typo.caption" Class="d-block" Style="font-weight:700;">@line.ActorName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@line.Action · @line.PerformedAt.ToString("MMM dd, yyyy • h:mm tt")</MudText>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

<style>
    .circulation-donut {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        display: grid;
        place-items: center;
    }

    .circulation-donut-center {
        width: 122px;
        height: 122px;
        border-radius: 50%;
        background: var(--mud-palette-background);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.2);
    }

    
    .chart-scroll-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        
        padding-bottom: 8px;
    }

    .chart-inner {
        min-width: 100%;
    }

    @@media (max-width: 959px) {
        .chart-inner {
            min-width: 560px; 
        }
        
        .chart-scroll-wrapper {
            border-radius: 8px;
        }
    }
</style>

@code {
    private bool _loading = true;
    private string _greetingName = "there";
    private int _cabinets, _boxes, _folders, _activeDocuments, _totalUsers;
    private int _pendingForSelectedYear, _disposedInSelectedYear, _totalPipelineYear, _selectedDisposalYear;
    private List<int> _yearChoices = new();
    private List<TransactionLog> _activityFeed = new();
    private List<ContributorRow> _topContributors = new();
    private readonly Dictionary<string, string> _employeeDisplayByKey = new(StringComparer.OrdinalIgnoreCase);

    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = { };
    private LineChartOptions _chartOptions = new()
    {
        XAxisTitle = "Year",
        XAxisLabelRotation = 45,
        LineStrokeWidth = 5,
		YAxisTicks = 20 ,

    };

    protected override async Task OnInitializedAsync()
    {
        _selectedCirculationYear = DateTime.Now.Year;
        _selectedDisposalYear = DateTime.Now.Year;
        _yearChoices = Enumerable.Range(_selectedDisposalYear - 5, 6).Reverse().ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
		using var Db = await DbFactory.CreateDbContextAsync();
        _loading = true;
        var now = DateTime.Now;


        var fullName = await CurrentUser.GetCurrentFullNameAsync();
        _greetingName = GetFirstName(fullName);


        var users = await UserManager.Users
            .AsNoTracking()
            .Select(u => new { u.FullName, u.UserName })
            .ToListAsync();

        _totalUsers = users.Count;
        _employeeDisplayByKey.Clear();
        foreach (var u in users) _employeeDisplayByKey[u.FullName ?? u.UserName!] = u.FullName ?? u.UserName!;


        var stats = await Db.Documents
            .AsNoTracking()
            .Select(d => new { d.IsDeleted, d.IsDisposal })
            .GroupBy(x => 1) 
            .Select(g => new {
                ActiveDocs = g.Count(d => !d.IsDeleted && !d.IsDisposal),
                DisposedDocs = g.Count(d => d.IsDisposal && !d.IsDeleted)
            })
            .FirstOrDefaultAsync();

        _activeDocuments = stats?.ActiveDocs ?? 0;
        _cabinets = await Db.FillingCabinets.CountAsync();
        _boxes = await Db.FileBoxes.CountAsync();
        _folders = await Db.Folders.CountAsync();


        var sixYearsAgo = now.Year - 5;
        var rawChartData = await Db.Documents
            .AsNoTracking()
                .Where(d => !d.IsDeleted && d.FiledAt.Year >= sixYearsAgo)
                .GroupBy(d => d.FiledAt.Year)
            .Select(g => new { 
                Year = g.Key, 
                Active = g.Count(d => !d.IsDisposal), 
                Disposed = g.Count(d => d.IsDisposal) 
            })
            .ToListAsync();


        var labels = new List<string>();
        var activeData = new List<double>();
        var disposalData = new List<double>();

        for (var i = 0; i < 6; i++)
        {
            var year = sixYearsAgo + i;
            labels.Add(year.ToString());
            var yearMatch = rawChartData.FirstOrDefault(x => x.Year == year);
            activeData.Add(yearMatch?.Active ?? 0);
            disposalData.Add(yearMatch?.Disposed ?? 0);
        }

        _xAxisLabels = labels.ToArray();
        _series = new List<ChartSeries<double>>
    {
        new ChartSeries<double> { Name = "New Filing", Data = activeData.ToArray() },
        new ChartSeries<double> { Name = "Official Disposals", Data = disposalData.ToArray() }
    };

        //  ACTIVITY & CONTRIBUTORS
        _activityFeed = await Db.TransactionLogs
            .AsNoTracking()
            .OrderByDescending(t => t.PerformedAt)
            .Take(15)
            .ToListAsync();

        var topRaw = await Db.TransactionLogs
            .AsNoTracking()
            .Where(t => !string.IsNullOrEmpty(t.FullName))
            .GroupBy(t => t.FullName!)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .Take(15)
            .ToListAsync();

        _topContributors = topRaw.Select(x => new ContributorRow(ResolveEmployeeName(x.Name), x.Count)).ToList();

        await LoadBorrowStatsAsync();
        await LoadDisposalYearDataAsync();
        _loading = false;
    }
    // BORROWED SECTION 

    private int _totalBorrowed, _overdueDocuments;
    private double _returnRate;
    private double[] _borrowData = { 0, 0 };
    private string[] _borrowLabels = { "In Storage", "Borrowed" };
    private bool _hasBorrowableDocs;
    private double _borrowedPercent;
    private List<OverdueItem> _overdueItems = new();
    private int _selectedCirculationYear;
    private int _totalDocsForSelectedYear;

    //DITO DITO YUNG BORROW WAG KANA TUMINGIN SA IBA SAKIN NALANG
    private async Task LoadBorrowStatsAsync()
    {
		using var Db = await DbFactory.CreateDbContextAsync();
        var start = new DateTime(_selectedCirculationYear, 1, 1);
        var end = start.AddYears(1);

        var borrowStats = await Db.Documents
            .AsNoTracking()
            .Where(d => !d.IsDeleted && !d.IsDisposal
         && d.FiledAt >= start
         && d.FiledAt < end)
            .GroupBy(x => 1)
            .Select(g => new {
                Total = g.Count(),
                Borrowed = g.Count(d => d.IsBorrowed), 
                Overdue = g.Count(d => d.IsBorrowed && d.BorrowedAt < DateTime.Now),
                InStorage = g.Count(d => !d.IsBorrowed)
            })
            .FirstOrDefaultAsync();

        if (borrowStats != null)
        {
            _totalDocsForSelectedYear = borrowStats.Total; 
            _totalBorrowed = borrowStats.Borrowed;

            _borrowedPercent = _totalDocsForSelectedYear <= 0
                ? 0
                : (double)_totalBorrowed / _totalDocsForSelectedYear * 100.0;

            _returnRate = _totalDocsForSelectedYear <= 0
                ? 0
                : Math.Round((double)borrowStats.InStorage / _totalDocsForSelectedYear * 100, 0);
        }
        else
        {
            // Reset if no data for that year
            _totalDocsForSelectedYear = 0;
            _totalBorrowed = 0;
            _borrowedPercent = 0;
            _returnRate = 0;
        }

        _overdueItems = await Db.Documents
            .AsNoTracking()
            .Where(d => d.IsBorrowed && !d.IsDeleted && d.BorrowedAt < DateTime.Now)
            .OrderBy(d => d.BorrowedAt)
            .Select(d => new OverdueItem
            {
                Title = d.Title,
                Borrower = d.CurrentBorrower ?? "Unknown", 
                DueDate = d.ExpectedReturnDate ?? DateTime.Now,

            })
            .Take(5)
            .ToListAsync();
    }

    private async Task OnCirculationYearChanged(int year)
    {
        _selectedCirculationYear = year;
        await LoadBorrowStatsAsync();
        StateHasChanged();
    }
    private record OverdueItem
    {
        public string Title { get; set; } = "";
        public string Borrower { get; set; } = "";
        public DateTime DueDate { get; set; }
}

private string GetBorrowDonutStyle()
{
		
    var p = Math.Clamp(_borrowedPercent, 0, 100);
    return $"background: conic-gradient(#f59e0b 0% {p:F2}%, #1f2937 {p:F2}% 100%);";
}

    private async Task OnDisposalYearChanged(int year) { _selectedDisposalYear = year; await LoadDisposalYearDataAsync(); }

    private async Task LoadDisposalYearDataAsync()
    {
        using var Db = DbFactory.CreateDbContext();
        var y = _selectedDisposalYear; var now = DateTime.Now; var ys = new DateTime(y, 1, 1); var ye = ys.AddYears(1);
        _disposedInSelectedYear = await Db.Documents.CountAsync(d => d.IsDisposal && !d.IsDeleted && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _totalPipelineYear = await Db.Documents.CountAsync(d => !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _pendingForSelectedYear = await Db.Documents.CountAsync(d => !d.IsDisposal && !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye && d.DateOfDisposal <= now);
    }

    private int _outstandingPipeline => Math.Max(0, _totalPipelineYear - _disposedInSelectedYear);


    private double GetPipelinePercent() => _totalPipelineYear <= 0 ? 0 : Math.Min(100, (double)_disposedInSelectedYear / _totalPipelineYear * 100.0);

    private (string Text, Color Color, string Icon) GetDisposalStatus()
    {
        var pct = GetPipelinePercent();
        if (pct >= 100) return ("Fully Compliant", Color.Info, Icons.Material.Filled.CheckCircle);
        if (pct >= 80) return ("Almost Complete", Color.Success, Icons.Material.Filled.TrendingUp);
        if (pct >= 40) return ("On Track", Color.Warning, Icons.Material.Filled.Assessment);
        return ("Action Required", Color.Error, Icons.Material.Filled.Error);
    }
    private static string GetFirstName(string? n) => string.IsNullOrWhiteSpace(n) ? "there" : n.Trim().Split(' ')[0];

    private ActivityLine GetActivityDisplay(TransactionLog log)
    {
        var action = string.IsNullOrWhiteSpace(log.EventName) ? "Activity" : log.EventName.Trim();
        var detail = string.IsNullOrWhiteSpace(log.Description) ? null : log.Description.Trim();
        return new ActivityLine(ResolveEmployeeName(log.FullName), action, detail, log.PerformedAt);
    }
    private void BuildEmployeeNameLookup(IEnumerable<ApplicationUser> users) 
    {
        foreach (var u in users) _employeeDisplayByKey[u.FullName ?? u.UserName!] = u.FullName ?? u.UserName!; 
    }
    private string ResolveEmployeeName(string? r) => string.IsNullOrEmpty(r) ? "System" : _employeeDisplayByKey.GetValueOrDefault(r, r);

    private static string GetInitials(string n) => string.IsNullOrEmpty(n) ? "?" : string.Join("", n.Split(' ').Select(x => x[0])).ToUpper();

    private record ActivityLine(string ActorName, string Action, string? Detail, DateTime PerformedAt);


    private record ContributorRow(string Name, int Count);
}