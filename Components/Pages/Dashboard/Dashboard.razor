@page "/"
@page "/dashboard"
@using MudBlazor
@using MudBlazor.Charts
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using FileLocator.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using System.Text.RegularExpressions
@using System.Globalization
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject ICurrentUserService CurrentUser

<MudStack Spacing="4" Class="pa-4">
    @if (_loading)
    {
        <MudPaper Class="pa-12 d-flex justify-center" Elevation="0" Style="background:transparent">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudPaper>
    }
    else
    {
        @* Hero Section *@
        <MudPaper Elevation="0" Class="pa-8 rounded-xl glass-midnight">
            <MudText Typo="Typo.caption" Class="dashboard-hero-date">@DateTime.Now.ToString("ddd, MMM d")</MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0e1824;">Hello, @_greetingName</MudText>
            <MudText Typo="Typo.body1" Class="dashboard-hero-tagline">What would you like to do today?</MudText>
        </MudPaper>

        <MudGrid Spacing="3">
            @* Stat Tiles *@
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Filing cabinets" Value="@_cabinets.ToString()" Icon="@Icons.Material.Filled.Inventory2" Href="/storages/cabinets" Background="linear-gradient(135deg, #1a3a52 0%, #2a5a7a 100%)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Filing boxes" Value="@_boxes.ToString()" Icon="@Icons.Material.Filled.Archive" Href="/storages/boxes" Background="linear-gradient(135deg, #b42318 0%, #e3362a 100%)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Folders" Value="@_folders.ToString()" Icon="@Icons.Material.Filled.Folder" Href="/storages/folders" Background="linear-gradient(135deg, #7b6ab3 0%, #9b8fc9 100%)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Active documents" Value="@_activeDocuments.ToString()" Icon="@Icons.Material.Filled.Description" Href="/documentsPage" Background="linear-gradient(135deg, #3a6351 0%, #52796f 100%)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Pending disposal" Value="@_pendingForSelectedYear.ToString()" Icon="@Icons.Material.Filled.HourglassTop" Href="/disposed" Background="linear-gradient(135deg, #7d1c1c 0%, #9b2c2c 100%)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <SolidStatTile Title="Total users" Value="@_totalUsers.ToString()" Icon="@Icons.Material.Filled.People" Href="/admin/users" Background="linear-gradient(135deg, #0e1824 0%, #1c2e44 100%)" />
            </MudItem>

            @* Disposal Trend - UPDATED TO MUDBLAZOR CHART *@
            <MudItem xs="12" lg="8">
                <MudPaper Elevation="0" Class="pa-6 rounded-xl glass-midnight h-100">
                    <MudStack Spacing="0" Class="mb-4">
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0e1824;">Disposal Trend</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Primary">Active Filing vs. Official Disposals (Last 6 Years)</MudText>
                    </MudStack>

                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_series"
                              ChartLabels="@_xAxisLabels"
                              ChartOptions="@_chartOptions"
                              Width="100%"
                              Height="500px"
                              CanScaleYAxis="true" />
                </MudPaper>
            </MudItem>

            @* Top 5 Contributors *@
            <MudItem xs="14" lg="4">
                <MudPaper Elevation="0" Class="pa-6 rounded-xl glass-midnight h-100">
                    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700; color: #0e1824;">Top 5 Contributors</MudText>
                    <MudStack Spacing="2">
                        @foreach (var c in _topContributors)
                        {
                            <div class="d-flex align-center gap-3 py-2 border-b last-child-no-border">
                                <MudAvatar Color="Color.Primary" Size="Size.Medium">@GetInitials(c.Name)</MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@c.Name</MudText>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Success">@c.Count actions</MudText>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Disposal Progress & Recent Activity remains the same below... *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-6 rounded-xl glass-midnight h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6" Style="font-weight:700; color: #0e1824;">Disposal Progress</MudText>
                        <MudSelect T="int" Value="_selectedDisposalYear" ValueChanged="OnDisposalYearChanged" Dense="true" Variant="Variant.Outlined" Style="width:100px; background: rgba(255,255,255,0.5);">
                            @foreach (var y in _yearChoices)
                            {
                                <MudSelectItem Value="y">@y</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    <div class="mt-8">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color: #0e1824;">
                                Disposal Progress
                                <span style="color: #03A9F4; margin-left: 8px;">(@GetPipelinePercent().ToString("F0")%)</span>
                            </MudText>
                            @if (_pendingForSelectedYear > 0)
                            {
                                <MudChip T="string" Color="Color.Error" Variant="Variant.Text" Size="Size.Small">
                                    @_pendingForSelectedYear Awaiting
                                </MudChip>
                            }
                        </MudStack>

                        <div class="custom-progress-container">
                            <MudProgressLinear Size="Size.Large" Value="@GetPipelinePercent()" Class="custom-progress-bar" />
                        </div>

                        <div class="d-flex justify-space-between mt-2">
                            <MudText Typo="Typo.caption" Style="opacity: 0.8;">@_disposedInSelectedYear Disposed</MudText>
                            <MudText Typo="Typo.caption" Style="opacity: 0.8;">Target: @_totalPipelineYear</MudText>
                        </div>
                    </div>
                    <MudDivider Class="my-5" Style="background: rgba(0,0,0,0.05)" />
                    <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:700">Year @_selectedDisposalYear snapshot</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-3 rounded-lg text-center" Style="background: rgba(14, 24, 36, 0.05);">
                                <MudText Typo="Typo.caption" Color="Color.Primary">Disposed</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight: 800;">@_disposedInSelectedYear</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-3 rounded-lg text-center" Style="background: rgba(180, 35, 24, 0.08);">
                                <MudText Typo="Typo.caption" Color="Color.Primary">Awaiting</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight: 800; color: #b42318;">@_pendingForSelectedYear</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-3 rounded-lg text-center" Style="background: rgba(14, 24, 36, 0.05);">
                                <MudText Typo="Typo.caption" Color="Color.Primary">Outstanding</MudText>
                                <MudText Typo="Typo.h6" Style="font-weight: 800;">@_outstandingPipeline</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-6 rounded-xl glass-midnight h-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0e1824;">Recent Activity</MudText>
                        <MudLink Href="/transaction-logs" Class="glass-view-log">View Log</MudLink>
                    </MudStack>
                    <div class="dashboard-activity-feed no-scrollbar" style="max-height: 450px; overflow-y: auto;">
                        @foreach (var log in _activityFeed)
                        {
                            var line = GetActivityDisplay(log);
                            <div class="activity-feed-row py-3 d-flex justify-space-between align-center border-b last-child-no-border">
                                <div class="d-flex align-center gap-3">
                                    <div class="activity-dot"></div>
                                    <div class="d-flex flex-column">
                                        <div class="d-flex gap-1 flex-wrap align-center">
                                            <MudText Typo="Typo.body2" Style="font-weight: 700; color: #0e1824;">@line.Name</MudText>
                                            <MudText Typo="Typo.body2" Style="color: #555;">@line.Phrase</MudText>
                                            @if (!string.IsNullOrEmpty(line.Title))
                                            {
                                                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #2a5a7a;">"@line.Title"</MudText>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Style="color: #999; font-size: 0.7rem;">
                                            @line.PerformedAt.ToLocalTime().ToString("MMM dd, yyyy • h:mm tt")
                                        </MudText>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private bool _loading = true;
    private string _greetingName = "there";
    private int _cabinets, _boxes, _folders, _activeDocuments, _totalUsers;
    private int _pendingForSelectedYear, _disposedInSelectedYear, _totalPipelineYear, _selectedDisposalYear;
    private List<int> _yearChoices = new();
    private List<TransactionLog> _activityFeed = new();
    private List<ContributorRow> _topContributors = new();
    private readonly Dictionary<string, string> _employeeDisplayByKey = new(StringComparer.OrdinalIgnoreCase);

    // MUDCHART PROPERTIES
    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = { };
    private LineChartOptions _chartOptions = new()
    {
        XAxisTitle = "Year",
        YAxisTitle = "Count",
        ShowDataMarkers = true,
        LineStrokeWidth = 3,
        XAxisLabelRotation = 0
    };

    protected override async Task OnInitializedAsync()
    {
        _selectedDisposalYear = DateTime.Now.Year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var now = DateTime.Now;

        var fullName = await CurrentUser.GetCurrentFullNameAsync();
        _greetingName = GetFirstName(fullName);

        var users = await UserManager.Users.AsNoTracking().ToListAsync();
        BuildEmployeeNameLookup(users);

        _cabinets = await Db.FillingCabinets.CountAsync();
        _boxes = await Db.FileBoxes.CountAsync();
        _folders = await Db.Folders.CountAsync();
        _activeDocuments = await Db.Documents.CountAsync(d => !d.IsDeleted && !d.IsDisposal);
        _totalUsers = users.Count;

        _yearChoices = Enumerable.Range(now.Year - 15, 18).ToList();

        // LOAD TREND DATA FOR CHART
        var labels = new List<string>();
        var disposalData = new List<double>();
        var activeData = new List<double>();

        for (var i = 0; i < 6; i++)
        {
            var year = now.Year - 5 + i;
            labels.Add(year.ToString());

            var yearStart = new DateTime(year, 1, 1);
            var yearEnd = yearStart.AddYears(1);

            // Official Disposals
            var dCount = await Db.Documents.CountAsync(d =>
                d.IsDisposal && !d.IsDeleted &&
                d.DateOfDisposal >= yearStart && d.DateOfDisposal < yearEnd);
            disposalData.Add((double)dCount);

            // Documents Added (Created) in that year
            var aCount = await Db.Documents.CountAsync(d =>
                !d.IsDeleted && !d.IsDisposal &&
                d.FiledAt >= yearStart && d.FiledAt < yearEnd);
            activeData.Add((double)aCount);
        }

        _xAxisLabels = labels.ToArray();
        _series = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "New Filing", Data = activeData.ToArray() },
            new ChartSeries<double> { Name = "Official Disposals", Data = disposalData.ToArray() }
        };

        // LOAD OTHER DASHBOARD DATA
        var topRaw = await Db.TransactionLogs.AsNoTracking()
            .Where(t => !string.IsNullOrEmpty(t.FullName))
            .GroupBy(t => t.FullName!)
            .Select(g => new { Name = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count).Take(5).ToListAsync();

        _topContributors = topRaw.Select(x => new ContributorRow(ResolveEmployeeName(x.Name), x.Count)).ToList();
        _activityFeed = await Db.TransactionLogs.AsNoTracking().OrderByDescending(t => t.PerformedAt).Take(14).ToListAsync();

        await LoadDisposalYearDataAsync();
        _loading = false;
    }

    // Support Methods
    private async Task OnDisposalYearChanged(int year) { _selectedDisposalYear = year; await LoadDisposalYearDataAsync(); }
    private async Task LoadDisposalYearDataAsync()
    {
        var y = _selectedDisposalYear; var now = DateTime.Now; var ys = new DateTime(y, 1, 1); var ye = ys.AddYears(1);
        _disposedInSelectedYear = await Db.Documents.CountAsync(d => d.IsDisposal && !d.IsDeleted && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _totalPipelineYear = await Db.Documents.CountAsync(d => !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye);
        _pendingForSelectedYear = await Db.Documents.CountAsync(d => !d.IsDisposal && !d.IsDeleted && d.DateOfDisposal != null && d.DateOfDisposal >= ys && d.DateOfDisposal < ye && d.DateOfDisposal <= now);
    }
    private int _outstandingPipeline => Math.Max(0, _totalPipelineYear - _disposedInSelectedYear);

    private double GetPipelinePercent() => _totalPipelineYear <= 0 ? 0 : Math.Min(100, (double)_disposedInSelectedYear / _totalPipelineYear * 100.0);

    private static string GetFirstName(string? fullName) { 
        
        if (string.IsNullOrWhiteSpace(fullName)) return "there"; var p = fullName.Trim().Split(' '); return p[0]; 
    }

    private ActivityLine GetActivityDisplay(TransactionLog log) => new ActivityLine(ResolveEmployeeName(log.FullName), ExtractQuotedTitle(log.Description), MapEventToPhrase(log.EventName), "", log.PerformedAt);

    private static string? ExtractQuotedTitle(string? d) { 
        if (string.IsNullOrEmpty(d)) return null; var m = Regex.Match(d, @"'([^']*)'"); return m.Success ? m.Groups[1].Value : null; 
    }

    private static string MapEventToPhrase(string e) => e switch { "Document Disposed" => "disposed of", "Document Created" => "filed", "Form Accessed" => "opened form", _ => e.ToLower() };

    private void BuildEmployeeNameLookup(IEnumerable<ApplicationUser> users) { foreach (var u in users) _employeeDisplayByKey[u.FullName ?? u.UserName!] = u.FullName ?? u.UserName!; }

    private string ResolveEmployeeName(string? r) => string.IsNullOrEmpty(r) ? "System" : _employeeDisplayByKey.GetValueOrDefault(r, r);

    private static string GetInitials(string n) => string.Join("", n.Split(' ').Select(x => x[0])).ToUpper();

    private record ActivityLine(string Name, string? Title, string Phrase, string Fallback, DateTime PerformedAt);

    private record ContributorRow(string Name, int Count);
}