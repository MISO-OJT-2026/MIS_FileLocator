@using FileLocator.Models
@using MIS_FileLocator.Data
@using MIS_FileLocator.Models
@using MIS_FileLocator.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@inject ISnackbar Snackbar
@inject ICurrentUserService _currentUserService

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary">

            @* TAB 1: General Info *@
            <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                <MudStack Spacing="4" Class="mt-4">
                    <MudTextField @bind-Value="_editDoc.Title" Label="Document Title" Variant="Variant.Outlined" Required="true" />

                    <MudStack Row="true">
                        <MudNumericField @bind-Value="_editDoc.Year" Label="Year" Variant="Variant.Outlined" />
                        <MudSelect T="int" Label="Confidentiality" @bind-Value="_editDoc.ConfidentialityLevelId" Variant="Variant.Outlined">
                            @foreach (var level in _levels)
                            {
                                <MudSelectItem Value="@level.Id">@level.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    <MudTextField @bind-Value="_editDoc.Description" Label="Description" Lines="3" Variant="Variant.Outlined" />

                    <MudDatePicker Label="Scheduled Disposal Date" @bind-Date="_editDoc.DateOfDisposal" Variant="Variant.Outlined"
                                   HelperText="Based on 2-year retention policy" />
                </MudStack>
            </MudTabPanel>

            @* TAB 2: Borrowing Logic *@
            <MudTabPanel Text="Borrowing" Icon="@Icons.Material.Filled.Outbound">
                <MudStack Spacing="3" Class="mt-4">
                    <MudAlert Severity="@(_editDoc.IsBorrowed? Severity.Error: Severity.Success)" Variant="Variant.Outlined">
                        Status: @(_editDoc.IsBorrowed ? "OUT (Borrowed)" : "IN (Available)")
                    </MudAlert>

                    <MudSwitch @bind-Value="_editDoc.IsBorrowed" Label="Mark as Borrowed" Color="Color.Error" UnCheckedColor="Color.Success" />

                    @if (_editDoc.IsBorrowed)
                    {
                        <MudTextField @bind-Value="_editDoc.CurrentBorrower" Label="Borrower Name" Variant="Variant.Outlined" Required="true" />
                        <MudDatePicker Label="Expected Return Date" @bind-Date="_editDoc.ExpectedReturnDate" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_editDoc.BorrowRemarks" Label="Borrow Remarks" Variant="Variant.Outlined" />
                    }
                </MudStack>
            </MudTabPanel>

            @* TAB 3: History/Audit *@
            <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History">
                <MudStack Spacing="2" Class="mt-4">
                    <MudText Typo="Typo.body2"><b>Physically Filed By:</b> @DocumentToEdit.FiledBy</MudText>
                    <MudText Typo="Typo.body2"><b>System Created By:</b> @DocumentToEdit.CreatedBy</MudText>
                    <MudText Typo="Typo.body2"><b>Date Filed:</b> @DocumentToEdit.FiledAt.ToString("MMM dd, yyyy")</MudText>
                    @if (!string.IsNullOrEmpty(DocumentToEdit.UpdatedBy))
                    {
                        <MudText Typo="Typo.body2"><b>Last Updated By:</b> @DocumentToEdit.UpdatedBy</MudText>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUpdates">Save Changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Documents DocumentToEdit { get; set; } = default!;

    private Documents _editDoc = new();
    private List<ConfidentialityLevel> _levels = new();

    protected override async Task OnInitializedAsync()
    {
        _levels = await _context.ConfidentialityLevels.ToListAsync();

        if (DocumentToEdit != null)
        {
            _editDoc.Id = DocumentToEdit.Id;
            _editDoc.Title = DocumentToEdit.Title;
            _editDoc.Description = DocumentToEdit.Description;
            _editDoc.Year = DocumentToEdit.Year;
            _editDoc.ConfidentialityLevelId = DocumentToEdit.ConfidentialityLevelId;
            _editDoc.DateOfDisposal = DocumentToEdit.DateOfDisposal;
            _editDoc.IsBorrowed = DocumentToEdit.IsBorrowed;
            _editDoc.CurrentBorrower = DocumentToEdit.CurrentBorrower;
            _editDoc.ExpectedReturnDate = DocumentToEdit.ExpectedReturnDate;
            _editDoc.BorrowRemarks = DocumentToEdit.BorrowRemarks;
        }
    }

    private async Task SaveUpdates()
    {
        var realDoc = await _context.Documents.FindAsync(_editDoc.Id);
        if (realDoc == null) return;

        var currentAdmin = await _currentUserService.GetCurrentFullNameAsync();
        bool statusChanged = realDoc.IsBorrowed != _editDoc.IsBorrowed;

        // Update Fields
        realDoc.Title = _editDoc.Title;
        realDoc.Description = _editDoc.Description;
        realDoc.Year = _editDoc.Year;
        realDoc.ConfidentialityLevelId = _editDoc.ConfidentialityLevelId;
        realDoc.DateOfDisposal = _editDoc.DateOfDisposal;
        realDoc.UpdatedBy = currentAdmin;

        // Borrowing Logic
        realDoc.IsBorrowed = _editDoc.IsBorrowed;
        realDoc.CurrentBorrower = _editDoc.IsBorrowed ? _editDoc.CurrentBorrower : null;
        realDoc.ExpectedReturnDate = _editDoc.IsBorrowed ? _editDoc.ExpectedReturnDate : null;
        realDoc.BorrowRemarks = _editDoc.BorrowRemarks;

        if (_editDoc.IsBorrowed && realDoc.BorrowedAt == null)
            realDoc.BorrowedAt = DateTime.UtcNow.AddHours(8);
        else if (!_editDoc.IsBorrowed)
            realDoc.BorrowedAt = null;

        // Logging
        _context.TransactionLogs.Add(new TransactionLog
        {
            FullName = currentAdmin,
            EventName = statusChanged ? "Borrow Status Updated" : "Document Updated",
            Description = _editDoc.IsBorrowed
                ? $"Document '{realDoc.Title}' borrowed by {realDoc.CurrentBorrower}."
                : $"Document '{realDoc.Title}' updated/returned.",
            Status = "Success",
            PerformedAt = DateTime.UtcNow.AddHours(8)
        });

        await _context.SaveChangesAsync();
        Snackbar.Add("Changes saved successfully.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}