@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@inherits LayoutComponentBase


<MudThemeProvider  Theme="@_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>

 

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               Elevation="0"
               Class="no-scrollbar"
               @onclick = "ToggleDrawer"
               Style="cursor: pointer overflow-x=hidden;background-color= #7a0102; ">

        <NavMenu SideBarOpen="_drawerOpen" />

    </MudDrawer>

    <MudMainContent Class="pt-4 px-6 pb-6">
        @Body
    </MudMainContent>

</MudLayout>



@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme _theme = new()
        {
            PaletteLight = new PaletteLight()
            {
            Primary = "#7a0102", // Your Red  D62828
            Secondary = "#0e1824", // Your Blue
            ActionDefault = "#0e1824",
            TextSecondary = "rgba(14, 24, 36, 0.70)",
            Background = "#FFF3E0", // Your Warm Cream
            AppbarBackground = "#0e1824",
            AppbarText = "#ffffff",
            DrawerBackground = "#7a0102", // Keep white for a clean look
            DrawerIcon = "#FFFFFF",
            DrawerText = "#FFFFFF",
            Surface = "#FFFFFF",
            
            },

            LayoutProperties= new LayoutProperties()
            {
                DefaultBorderRadius = "16px",
                DrawerWidthLeft = "280px",
                DrawerMiniWidthLeft = "80px"
            
        },

        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        }
        };
}