@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@inherits LayoutComponentBase


<MudThemeProvider Theme="@_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               Elevation="0"
               Class="app-shell-drawer no-scrollbar"
               Style="overflow-x: hidden;">

        <NavMenu SideBarOpen="_drawerOpen" />

    </MudDrawer>

    <MudMainContent Class="pt-5 px-8 pb-10 app-shell-main">
        @Body
    </MudMainContent>

</MudLayout>



@code {
    private bool _drawerOpen = true;

    private MudTheme _theme = new()
        {
            PaletteLight = new PaletteLight()
            {
            Primary = "#0e1824", // blue?
            Secondary = "#b42318",
            ActionDefault = "#0e1824",
            TextSecondary = "rgba(14, 24, 36, 0.68)",
            
            Background = "#f0f4f8",
            AppbarBackground = "#0e1824",
            AppbarText = "#ffffff",
            DrawerBackground = "#0e1824",
            DrawerIcon = "#FFFFFF",
            DrawerText = "#FFFFFF",
            Surface = "#FFFFFF",
            },

            LayoutProperties = new LayoutProperties()
            {
                DefaultBorderRadius = "14px",
                DrawerWidthLeft = "280px",
                DrawerMiniWidthLeft = "80px"
            },

        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        }
        };
}