@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager NavigationManager
@implements IDisposable
@inherits LayoutComponentBase

<MudThemeProvider @ref="@_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudDialogProvider BackdropClick="false" />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="appbar-glass mud-border-bottom">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => { _drawerOpen = !_drawerOpen; })" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-2">
            <img src="images/MIS-LOGO.png" alt="MIS Logo" style="height:28px; width:auto;" />
            <MudText Typo="Typo.h6" Style="font-weight: 800; white-space: nowrap; font-size: 1rem;">
                MIS File Locator
            </MudText>
        </MudStack>
        <MudSpacer />
        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                             Icon="@Icons.Material.Outlined.DarkMode" Color="Color.Inherit"
                             ToggledIcon="@Icons.Material.Outlined.WbSunny" ToggledColor="Color.Inherit"
                             title="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               OpenMiniOnHover="true"
               Elevation="1"
               Class="app-shell-drawer no-scrollbar"
               Style="overflow-x: hidden;">
        <NavMenu SideBarOpen="_drawerOpen" />
    </MudDrawer>

    <MudMainContent Class="app-shell-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .mud-timeline-item:hover {
        background-color: var(--mud-palette-action-default-hover);
        border-radius: 8px;
        transition: background 0.2s;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close drawer on mobile after any navigation
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1a3a52",
            Background = "#f8fafc",
            AppbarBackground = "#ffffff",
            AppbarText = "#0e1824",
            DrawerBackground = "#0e1824",
            DrawerText = "#FFFFFF",
            DrawerIcon = "#FFFFFF",
            Surface = "#FFFFFF",
            TextPrimary = "#0e1824",
            TextSecondary = "rgba(14, 24, 36, 0.7)"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#5eb5f7",
            Background = "#0b0f1a",
            Surface = "#111827",
            DrawerBackground = "#111827",
            DrawerText = "#f9fafb",
            DrawerIcon = "#f9fafb",
            AppbarBackground = "#0b0f1a",
            AppbarText = "#f9fafb",
            TextPrimary = "#f9fafb",
            TextSecondary = "rgba(249, 250, 251, 0.7)"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "4px",
            DrawerWidthLeft = "280px",
            DrawerMiniWidthLeft = "80px",
            AppbarHeight = "64px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };
}
