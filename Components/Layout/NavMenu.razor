@using System.Security.Claims
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ICurrentUserService _currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService

<MudNavMenu Class="nav-shell-menu">
    @if (SideBarOpen)
    {
        
        <div @onclick:stopPropagation="true"
             style="display: flex; flex-direction: column; height: calc(100vh - 32px);">
            

            
            <div class="d-flex flex-column align-center py-4 px-4">
                <MudAvatar Style="background-color: rgba(255,255,255,0.92) !important; color: #0e1824 !important; font-weight: 700; height:70px; width:70px; border: 1px solid rgba(255,255,255,0.35);" Class="mb-3">
                    @_currentUserInitials
                </MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: white;">@_currentUserName</MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">@_currentUserRole</MudText>
            </div>

            
            <div class="links-container no-scrollbar nav-menu-scroll">
                
                <MudText Typo="Typo.overline" Class="px-4 mt-6 mb-2" Style="color: white; font-weight: bold; opacity: 0.8;">GENERAL</MudText>
                
               
                @if (RoleService.CanAccessDashboard(_currentUserRole))
                {
                    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
                }
                
              
                <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
                <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Assignment">Forms</MudNavLink>

                
                @if (RoleService.CanAccessStorage(_currentUserRole))
                {
                    <MudNavGroup Title="Storage" Icon="@Icons.Material.Filled.Inventory2"  >
                        <MudNavLink Href="/storages/cabinets">Filing Cabinets</MudNavLink>
                        <MudNavLink Href="/storages/boxes">Filing Boxes</MudNavLink>
                        <MudNavLink Href="/storages/folders">Filing Folders</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Documents" Icon="@Icons.Material.Filled.Description">
                        <MudNavLink Href="/documentsPage">All Documents</MudNavLink>
                        <MudNavLink Href="/disposed">Disposed Documents</MudNavLink>
                        <MudNavLink Href="/barrowed">Barrowed Documents</MudNavLink>
                        <MudNavLink Href="/recyclebin">Recycle Bin </MudNavLink>
                    </MudNavGroup>
                }
                
               
                @if (_currentUserRole == "Viewer")
                {
                    <MudNavGroup Title="Documents" Icon="@Icons.Material.Filled.Description">
                        <MudNavLink Href="/documentsPage">All Documents</MudNavLink>
                        <MudNavLink Href="/disposed">Disposed Documents</MudNavLink>
                    </MudNavGroup>
                }

                <MudText Typo="Typo.overline" Class="px-4 mt-6 mb-2" Style="color: white; font-weight: bold; opacity: 0.8;">ADMIN & TOOLS</MudText>

                
                @if (RoleService.CanAccessUserManagement(_currentUserRole))
                {
                    <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.AdminPanelSettings">User Management</MudNavLink>
                }

               
                @if (RoleService.CanAccessForms(_currentUserRole))
                {
                   
                    <MudNavLink Href="/transaction-logs" Icon="@Icons.Material.Filled.History">Transaction Logs</MudNavLink>
                }
            </div>

           
            <div class="mt-auto pt-4 px-2">
    <AuthorizeView>
        <Authorized>
           
            <form action="Account/Logout" method="post">
               
                <AntiforgeryToken />

                
                <input type="hidden" name="returnUrl" value="" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Logout"
                           FullWidth="true"
                           Style="justify-content: flex-start; text-transform: none; color: white;">
                    Logout
                </MudButton>
            </form>
        </Authorized>
    </AuthorizeView>
</div>
        </div>
    }
    else
    {
       
    
        @* MINI STATE: Standardized background and padding *@
            <div class="mini-sidebar-container">
                <div class="d-flex flex-column align-center py-6 gap-6">
                    <MudIcon Icon="@Icons.Material.Filled.SdCard" Size="Size.Large" Style="color: white; margin-bottom: 20px;" />

                    <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Color="Color.Inherit" Class="mini-nav-icon" />
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Color="Color.Inherit" Class="mini-nav-icon" />
                    <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Inherit" Class="mini-nav-icon" />
                    <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Inherit" Class="mini-nav-icon" />
                    <MudIconButton Icon="@Icons.Material.Filled.Assignment" Color="Color.Inherit" Class="mini-nav-icon" />

                    <div class="mt-auto">
                        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Class="mini-nav-icon" />
                    </div>
                </div>
            </div>
    }
</MudNavMenu>

<style>

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .nav-menu-scroll {
        flex-grow: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Force the group headers to play nice with the glass links */
    .nav-shell-menu .mud-nav-group-toggle {
        margin-top: 4px;
        margin-bottom: 4px;
    }

    /* Ensure NavGroup arrows stay white */
    ::deep .mud-nav-group-caret-icon {
        color: white !important;
    }

    /* Padding adjustment to give the glass room to breathe */
    .mud-nav-link {
        margin-right: 8px !important;
        margin-left: 0 !important;
        border-radius: 0 20px 20px 0 !important; /* Rounded glass edge */
    }

    a {
        text-decoration: none;
    }
</style>

@code {
    [Parameter] public bool SideBarOpen { get; set; }

    [Parameter] public EventCallback OnToggleSideBar { get; set; }
    private async Task ToggleSideBar()
    {
        await OnToggleSideBar.InvokeAsync();
    }

    private bool _storageExpanded = false;
    private bool _documentsExpanded = false;
    private string? currentUrl;
    private string _currentUserInitials = "";
    private string _currentUserRole = "";
    private string _currentUserName ="";

    
    protected override async Task OnInitializedAsync()
    {
        _currentUserName = await _currentUserService.GetCurrentFullNameAsync();

        if (!string.IsNullOrWhiteSpace(_currentUserName))
        {
            var names = _currentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _currentUserInitials = names.Length >= 2
                ? $"{names[0][0]}{names[1][0]}".ToUpper()
                : _currentUserName.Substring(0, Math.Min(2, _currentUserName.Length)).ToUpper();
        }

       
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            // Look for the "Role" c
            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);

            //by default staff sya
            _currentUserRole = roleClaim != null ? roleClaim.Value : "Staff";
        }
    }
    
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    
}