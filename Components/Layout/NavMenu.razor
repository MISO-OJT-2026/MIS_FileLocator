@implements IDisposable
@inject NavigationManager NavigationManager
@inject ICurrentUserService _currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService

@using System.Security.Claims
@using MudBlazor
@inject NavigationManager NavigationManager
@inject ICurrentUserService _currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IRoleService RoleService

<MudNavMenu Class="nav-shell-menu">
    @if (SideBarOpen)
    {
        <div class="d-flex flex-column" style="height: calc(100vh - 32px);">
            @* User Profile Section *@
            <div class="d-flex flex-column align-center py-6 px-4">
                <MudAvatar Style="height:70px; width:70px; color:white;!important" Class="mb-3 elevation-4">
                    @_currentUserInitials
                </MudAvatar>
                
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: inherit;">@_currentUserName</MudText>
                <MudText Typo="Typo.body2" Style="color: inherit; opacity: 0.7;">@_currentUserRole</MudText>
            </div>

            <div class="nav-menu-scroll no-scrollbar px-2">
                <MudText Typo="Typo.overline" Class="px-4 mt-6 mb-2 mud-text-secondary" Style="font-weight: bold; color:ghostwhite;">GENERAL</MudText>

                @if (RoleService.CanAccessDashboard(_currentUserRole))
                {
                    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
                }

                <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>

                @if (RoleService.CanAccessForms(_currentUserRole))
                {
                    <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Assignment">Forms</MudNavLink>
                }

                @if (RoleService.CanAccessStorage(_currentUserRole))
                {
                    <MudNavGroup Title="Storage" Icon="@Icons.Material.Filled.Inventory2">
                        <MudNavLink Href="/storages/cabinets">Filing Cabinets</MudNavLink>
                        <MudNavLink Href="/storages/boxes">Filing Boxes</MudNavLink>
                        <MudNavLink Href="/storages/folders">Filing Folders</MudNavLink>
                    </MudNavGroup>

                    <MudNavGroup Title="Documents" Icon="@Icons.Material.Filled.Description">
                        <MudNavLink Href="/documentsPage">All Documents</MudNavLink>
                        <MudNavLink Href="/disposed">Disposed</MudNavLink>
                        <MudNavLink Href="/barrowed">Borrowed</MudNavLink>
                    </MudNavGroup>
                }
                else if (RoleService.CanAccessDocuments(_currentUserRole))
                {
                    <MudNavLink Href="/documentsPage" Icon="@Icons.Material.Filled.Description" Match="NavLinkMatch.Prefix">Documents</MudNavLink>
                }

                @if (RoleService.CanAccessUserManagement(_currentUserRole) || RoleService.CanAccessAdminTools(_currentUserRole) || RoleService.CanAccessTransactionLogs(_currentUserRole))
                {
                    <MudText Typo="Typo.overline" Class="px-4 mt-6 mb-2 mud-text-secondary" Style="font-weight: bold; color:ghostwhite;">ADMIN & TOOLS</MudText>

                    @if (RoleService.CanAccessUserManagement(_currentUserRole))
                    {
                        <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.AdminPanelSettings">User Management</MudNavLink>
                    }

                    @if (RoleService.CanAccessAdminTools(_currentUserRole))
                    {
                        <MudNavLink Href="/admin/qr-codes" Icon="@Icons.Material.Filled.QrCode">QR Codes</MudNavLink>
                    }

                    @if (RoleService.CanAccessTransactionLogs(_currentUserRole))
                    {
                        <MudNavLink Href="/transaction-logs" Icon="@Icons.Material.Filled.History">Transaction Logs</MudNavLink>
                    }
                }
            </div>

            @* Logout Section *@
            <div class="mt-auto pa-4">
                <AuthorizeView>
                    <Authorized>
                        <form action="Account/Logout" method="post" class="nav-logout-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="" />
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Logout"
                                       FullWidth="true"
                                       Color="Color.Inherit"
                                       Class="justify-start text-none nav-logout-btn"
                                       Style="opacity: 0.9;">
                                Logout
                            </MudButton>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    }
    else
    {
        @* MINI STATE *@
        <div class="d-flex flex-column align-center py-6 gap-4">
            <MudIcon Icon="@Icons.Material.Filled.SdCard" Color="Color.Primary" Size="Size.Large" Class="mb-6" />
            @if (RoleService.CanAccessDashboard(_currentUserRole))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard" href="/dashboard" />
            }
            @if (RoleService.CanAccessStorage(_currentUserRole))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Inventory2" href="/storages/cabinets" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Description" href="/documentsPage" />
            @if (RoleService.CanAccessAdminTools(_currentUserRole))
            {
                <MudIconButton Icon="@Icons.Material.Filled.QrCode" href="/admin/qr-codes" />
            }
            @if (RoleService.CanAccessUserManagement(_currentUserRole))
            {
                <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" href="/admin/users" />
            }
            <div class="mt-auto">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error" />
            </div>
        </div>
    }
</MudNavMenu>

<style>

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .nav-menu-scroll {
        flex-grow: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Force the group headers to play nice with the glass links */
    .nav-shell-menu .mud-nav-group-toggle {
        margin-top: 4px;
        margin-bottom: 4px;
    }

    /* Ensure NavGroup arrows stay white */
    ::deep .mud-nav-group-caret-icon {
        color: white !important;
    }

    /* Padding adjustment to give the glass room to breathe */
    .mud-nav-link {
        margin-right: 8px !important;
        margin-left: 0 !important;
        border-radius: 0 20px 20px 0 !important; /* Rounded glass edge */
    }

        .mud-nav-link.active {
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-left: 4px solid var(--mud-palette-primary) !important;
            color: var(--mud-palette-primary) !important;
        }

    a {
        text-decoration: none;
    }

    .nav-logout-form {
        width: 100%;
    }

    .nav-logout-form ::deep .nav-logout-btn.mud-button-root {
        transition: background-color .2s ease, color .2s ease, opacity .2s ease, border-color .2s ease;
        border-radius: 0 20px 20px 0 !important;
        margin-right: 0 !important;
        margin-left: -4px !important;
        width: calc(100% + 4px) !important;
        min-height: 44px;
        justify-content: flex-start !important;
        border-left: 4px solid transparent !important;
        padding-left: 20px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        color: rgba(255, 255, 255, 0.9) !important;
    }

    .nav-logout-form ::deep .nav-logout-btn.mud-button-root:hover {
        background-color: rgba(255, 255, 255, 0.1) !important;
        border-left: 4px solid var(--mud-palette-primary) !important;
        color: var(--mud-palette-primary) !important;
        opacity: 1 !important;
    }

    .nav-logout-form ::deep .nav-logout-btn .mud-button-start-icon {
        margin-right: 10px;
    }
</style>

@code {
    [Parameter] public bool SideBarOpen { get; set; }

    [Parameter] public EventCallback OnToggleSideBar { get; set; }
    private async Task ToggleSideBar()
    {
        await OnToggleSideBar.InvokeAsync();
    }

    private string? currentUrl;
    private string _currentUserInitials = "";
    private string _currentUserRole = "";
    private string _currentUserName ="";


    protected override async Task OnInitializedAsync()
    {
        _currentUserName = await _currentUserService.GetCurrentFullNameAsync();

        if (!string.IsNullOrWhiteSpace(_currentUserName))
        {
            var names = _currentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _currentUserInitials = names.Length >= 2
                ? $"{names[0][0]}{names[1][0]}".ToUpper()
                : _currentUserName.Substring(0, Math.Min(2, _currentUserName.Length)).ToUpper();
        }


        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            // Look for the "Role" c
            var roleClaim = user.FindFirst(c => c.Type == ClaimTypes.Role);

            //by default staff sya
            _currentUserRole = roleClaim != null ? roleClaim.Value : "Staff";
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }


}