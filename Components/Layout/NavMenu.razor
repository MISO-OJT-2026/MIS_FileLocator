@implements IDisposable
@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">
        Profile
    </MudNavLink>

    <AuthorizeView Roles="Admin">
        <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.AdminPanelSettings">
            User Management
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <MudNavLink Href="/transaction-logs" Icon="@Icons.Material.Filled.History">
           Transaction Logs
        </MudNavLink>
    </AuthorizeView>

    <MudNavGroup Title="Storage" Icon="@Icons.Material.Filled.Inventory2" @bind-Expanded="_storageExpanded">
        <MudNavLink Href="/storages/cabinets">Filing Cabinets</MudNavLink>
        <MudNavLink Href="/storages/boxes">Filing Boxes</MudNavLink>
        <MudNavLink Href="/storages/folders">Folders</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Documents" Icon="@Icons.Material.Filled.Description" @bind-Expanded="_documentsExpanded">
        <MudNavLink Href="/documents">All Documents</MudNavLink>
        <MudNavLink Href="/documents/disposed">Disposed</MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/forms" Icon="@Icons.Material.Filled.Assignment">
        Forms
    </MudNavLink>

    <MudDivider Class="my-2" />

    @* Secure POST Logout Form built with MudBlazor styling *@
    <AuthorizeView>
        <Authorized>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Logout"
                           FullWidth="true"
                           Style="justify-content: flex-start; padding-left: 20px; color: var(--mud-palette-text-primary); text-transform: none; font-weight: 400;">
                    Logout
                </MudButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">
                Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private bool _storageExpanded = false;
    private bool _documentsExpanded = false;
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}