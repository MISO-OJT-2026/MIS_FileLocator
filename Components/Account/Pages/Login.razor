@page "/Account/Login"
@attribute [AllowAnonymous]
@layout MIS_FileLocator.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using MIS_FileLocator.Data
@using MIS_FileLocator.Data.Initialization
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<div class="login-page-wrapper">
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh; padding-top: 7vh;">

        
        <MudPaper Elevation="0" Class="glass-card pa-8">

            <div class="d-flex flex-column align-center mb-2">
                <MudImage Src="images/MIS-LOGO.png"
                          Alt="MIS Logo"
                          Elevation="0"
                          Class="mt-0 mb-1.5"
                          Style="width: 120px; height: auto;" />
                <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0e1824; letter-spacing: 1px;">LOG IN</MudText>
                <MudText Typo="Typo.body2" Style="color: #555;" Align="Align.Center">Access the MIS File Locator System</MudText>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Style="border-radius: 12px;">@errorMessage</MudAlert>
            }

            <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />

                <div class="d-flex flex-column gap-3">
                    <MudTextField @bind-Value="Input.EmployeeId"
                                  For="@(() => Input.EmployeeId)"
                                  Label="Employee ID"
                                  Variant="Variant.Outlined"
                                  Name="Input.EmployeeId"
                                  Required="true"
                                  ShrinkLabel= "true"
                                  Class="glass-input mb-1" />

                    <MudTextField @bind-Value="Input.Password"
                                  For="@(() => Input.Password)"
                                  Label="Password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Name="Input.Password"
                                  Required="true"
                                  ShrinkLabel="true"
                                  Class="glass-input mb-1" />

                    

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Disabled="@_isProcessing"
                               Size="Size.Large"
                               FullWidth="true"
                               Style="border-radius: 12px; height: 52px; font-weight: bold; background-color: #0e1824; color: white;">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Authenticating...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </MudButton>
                </div>
            </EditForm>
        </MudPaper>
    </MudContainer>
</div>

<style>
    .login-page-wrapper {
       
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('images/LOGBG.png');
        background-size: cover;
        background-position: center;
        height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
    }
    .glass-checkbox .mud-button-root{
        color: #0e1824 !important;
    }

    .glass-checkbox .mud-checkbox-label {
        color: #333 !important;
        font-size: 0.85rem;
        font-weight: 500;
    }
    .glass-card {
       
        background: rgba(255, 255, 255, 0.35) !important;
       
        backdrop-filter: blur(15px) saturate(160%);
        -webkit-backdrop-filter: blur(15px) saturate(160%);
        
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        border-radius: 24px !important;
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.2) !important;
        width: 100%;
        max-width: 400px;
        padding: 24px !important;
    }

   
    .glass-input .mud-input-outlined-border {
        background-color: rgba(255, 255, 255, 0.2);
    }
   
    .glass-input.mud-input-focus .mud-input-outlined-border {
        border-color: #0e1824 !important;
        border-width: 2px !important;
    }
    
    .glass-input.mud-input-focus .mud-label {
        color: #0e1824 !important;
    }
    
    
    .glass-checkbox {
    pointer-events: auto !important; 
    cursor: pointer !important;
}

.glass-checkbox .mud-checkbox-inner {
    background-color: rgba(255, 255, 255, 0.2) !important;
}
    
    .mud-input-outlined-border {
        transition: border-color 300ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;
    }
    .glass-input .mud-label {
        font-weight: 500;
        color: #333 !important;
    }
  

    
    ::deep .mud-input-slot {
        background-color: transparent !important;
    }

    ::deep input:-webkit-autofill,
    ::deep input:-webkit-autofill:hover,
    ::deep input:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
        transition: background-color 5000s ease-in-out 0s; 
        -webkit-text-fill-color: #0e1824 !important; 
   

    }
    ::deep .mud-input-control {
        background-color: transparent !important;
    }
</style>

@code {
    private string? errorMessage;
    private bool _isProcessing = false;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // We initialize this to ensure it's never null
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        _isProcessing = true;
        errorMessage = null;
        StateHasChanged(); 


        var user = await UserManager.Users
            .FirstOrDefaultAsync(u => u.EmployeeId == Input.EmployeeId);

        bool IsDisabled = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
        if (user == null)
        {
            errorMessage = "User not found.";
            ClearFields(); // Reset the UI
            _isProcessing = false;
            return;
        }

        if (IsDisabled)
        {
            errorMessage = "You are currently disabled by the admin.";
            ClearFields();
            _isProcessing = false;
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user.UserName!,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: false);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        else
        {
            errorMessage = "Invalid login attempt.";
            ClearFields(); // Reset the UI on failure
            _isProcessing = false;
        }
    }

    private void ClearFields()
    {
        Input.Password = "";
        Input.RememberMe = false;
       
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Employee ID is required")]
        public string EmployeeId { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}