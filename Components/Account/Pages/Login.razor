@attribute [AllowAnonymous]
@page "/Account/Login"

@layout MIS_FileLocator.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using MIS_FileLocator.Data
@using MIS_FileLocator.Data.Initialization
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-2">Log in</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Use your local account to access the system.
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @* Replaced standard StatusMessage with a MudAlert for better UI integration *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }

            <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />

                <div class="d-flex flex-column gap-4">
                    @* Notice the Name parameter here! 
                        It is required for static form POSTs to bind back to the InputModel.
                    *@
                    <MudTextField @bind-Value="Input.EmployeeId"
                                  For="@(() => Input.EmployeeId)"
                                  Label="Employee ID"
                                  Variant="Variant.Outlined"
                                  Name="Input.EmployeeId"
                                  Required="true" />

                    <MudTextField @bind-Value="Input.Password"
                                  For="@(() => Input.Password)"
                                  Label="Password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Name="Input.Password"
                                  Required="true" />

                    <MudCheckBox @bind-Value="Input.RememberMe"
                                 Label="Remember me"
                                 Name="Input.RememberMe"
                                 Color="Color.Primary" />

                    @* ButtonType.Submit is critical here to trigger the form POST *@
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Class="mt-2">
                        Log in
                    </MudButton>
                </div>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        var user = await UserManager.Users
            .FirstOrDefaultAsync(u => u.EmployeeId == Input.EmployeeId);

        if (user == null)
        {
            Logger.LogWarning("User not found");
            errorMessage = "User not found.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user.UserName!,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: false);

        Logger.LogWarning("Login result: {Succeeded}", result.Succeeded);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        else
        {
            errorMessage = "Invalid login attempt.";
        }
    }

    private sealed class InputModel
    {
        [Required]
        public string EmployeeId { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}